<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="int_ui_showcase_report_pdf" model="ir.actions.report">
        <field name="name">Showcase (PDF)</field>
        <field name="model">int.ui.showcase</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">int_ui_showcase.report_showcase</field>
        <field name="report_file">int_ui_showcase.report_showcase</field>
        <field name="print_report_name">'Showcase - %s' % object.name</field>
        <field name="binding_model_id" ref="model_int_ui_showcase"/>
        <field name="binding_type">report</field>
    </record>

    <record id="int_ui_showcase_report_html" model="ir.actions.report">
        <field name="name">Showcase (HTML)</field>
        <field name="model">int.ui.showcase</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">int_ui_showcase.report_showcase</field>
        <field name="report_file">int_ui_showcase.report_showcase</field>
        <field name="binding_model_id" ref="model_int_ui_showcase"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_showcase">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2><span t-field="o.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Status:</strong> <span t-field="o.state"/><br/>
                                <strong>Category:</strong> <span t-field="o.category_id"/><br/>
                                <strong>Responsible:</strong> <span t-field="o.user_id"/><br/>
                                <strong>Deadline:</strong> <span t-field="o.deadline"/>
                            </div>
                            <div class="col-6">
                                <strong>Tags:</strong>
                                <t t-foreach="o.tag_ids" t-as="tag">
                                    <span class="badge text-bg-secondary" t-out="tag.name"/>
                                </t>
                            </div>
                        </div>
                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end"><span t-field="line.subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="clearfix">
                            <div class="float-end">
                                <strong>Total:</strong> <span t-field="o.amount_total"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
