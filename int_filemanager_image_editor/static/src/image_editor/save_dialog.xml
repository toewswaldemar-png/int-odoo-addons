<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="int_filemanager_image_editor.ImageEditorSaveDialog">
        <Dialog size="'md'" title="title">
            <div class="d-flex flex-column gap-3">
                <div>
                    <label class="form-label fw-bold" for="int_filemanager_editor_name">Name</label>
                    <div class="input-group">
                        <input
                            id="int_filemanager_editor_name"
                            type="text"
                            class="form-control"
                            t-att-value="state.name"
                            t-on-input="onName"
                            t-on-keydown.stop="(ev) => ev.key === 'Enter' and this.save()"
                        />
                        <span class="input-group-text">.<t t-out="extension" /></span>
                    </div>
                </div>
                <div>
                    <label class="form-label fw-bold" for="int_filemanager_editor_format">Format</label>
                    <select
                        id="int_filemanager_editor_format"
                        class="form-select"
                        t-on-change="onMimetype"
                    >
                        <option
                            t-foreach="formats"
                            t-as="format"
                            t-key="format.mimetype"
                            t-att-value="format.mimetype"
                            t-att-selected="format.mimetype === state.mimetype"
                            t-out="format.label"
                        />
                    </select>
                </div>
                <div t-if="isLossy">
                    <label class="form-label fw-bold" for="int_filemanager_editor_quality">
                        Quality: <t t-out="Math.round(state.quality * 100)" /> %
                    </label>
                    <input
                        id="int_filemanager_editor_quality"
                        type="range"
                        class="form-range"
                        min="0.1"
                        max="1"
                        step="0.01"
                        t-att-value="state.quality"
                        t-on-input="onQuality"
                    />
                </div>
                <div>
                    <label class="form-label fw-bold" for="int_filemanager_editor_scale">Size</label>
                    <select id="int_filemanager_editor_scale" class="form-select" t-on-change="onScale">
                        <option
                            t-foreach="scales"
                            t-as="scale"
                            t-key="scale"
                            t-att-value="scale"
                            t-att-selected="scale === state.scale"
                        >
                            <t t-out="scaleLabel(scale)" />
                        </option>
                    </select>
                    <div class="form-text">
                        <t t-out="outputSize.width" /> × <t t-out="outputSize.height" /> px
                    </div>
                    <div t-if="isReduced" class="form-text text-warning">
                        Your browser cannot make a file of the full size of this picture; the
                        largest size it can make is offered.
                    </div>
                </div>
                <div class="form-check">
                    <input
                        id="int_filemanager_editor_keep"
                        type="checkbox"
                        class="form-check-input"
                        t-att-checked="state.keepState"
                        t-att-disabled="!props.canKeepState"
                        t-on-change="onKeepState"
                    />
                    <label class="form-check-label" for="int_filemanager_editor_keep">
                        Keep the marks editable (the next edit finds them again)
                    </label>
                    <div t-if="!props.canKeepState" class="form-text text-warning">
                        The marks are too large to be kept; the picture is stored without them.
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary" t-att-disabled="!canSave" t-on-click="save">
                    Save as new document
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="props.close">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>
</templates>
