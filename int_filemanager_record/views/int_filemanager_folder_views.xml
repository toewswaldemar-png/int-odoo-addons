<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_folder_view_list" model="ir.ui.view">
        <field name="name">int.filemanager.folder.view.list.inherit.record</field>
        <field name="model">int.filemanager.folder</field>
        <field name="inherit_id" ref="int_filemanager.int_filemanager_folder_view_list" />
        <field name="arch" type="xml">
            <field name="access_mode" position="after">
                <field
                    name="model_folder_ids"
                    widget="many2many_tags"
                    groups="int_filemanager.int_filemanager_group_admin"
                    optional="show"
                />
            </field>
        </field>
    </record>

    <record id="int_filemanager_folder_view_form" model="ir.ui.view">
        <field name="name">int.filemanager.folder.view.form.inherit.record</field>
        <field name="model">int.filemanager.folder</field>
        <field name="inherit_id" ref="int_filemanager.int_filemanager_folder_view_form" />
        <field name="arch" type="xml">
            <sheet position="inside">
                <group
                    string="Upload folder for"
                    groups="int_filemanager.int_filemanager_group_admin"
                >
                    <field name="model_folder_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="res_model" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </list>
                    </field>
                </group>
            </sheet>
        </field>
    </record>

    <record id="int_filemanager_folder_view_search" model="ir.ui.view">
        <field name="name">int.filemanager.folder.view.search.inherit.record</field>
        <field name="model">int.filemanager.folder</field>
        <field name="inherit_id" ref="int_filemanager.int_filemanager_folder_view_search" />
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <filter
                    name="filter_upload_folder"
                    string="Upload folders"
                    domain="[('model_folder_ids', '!=', False)]"
                    groups="int_filemanager.int_filemanager_group_admin"
                />
            </field>
        </field>
    </record>
</odoo>
