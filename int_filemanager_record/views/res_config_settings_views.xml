<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.int_filemanager_record</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="int_filemanager.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='int_filemanager_display_block']" position="before">
                <block title="Access" name="int_filemanager_access_block">
                    <setting
                        id="int_filemanager_access_via_record"
                        string="Access through linked records"
                        help="Whoever may read a record (a contact, say) may also read the documents linked to it, without a right on their folder. Off: only the folders decide, and a file uploaded to a record is seen by those who see its upload folder."
                    >
                        <field name="int_filemanager_access_via_record" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
