<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="int_workbench_parameter_clamp_view_form" model="ir.ui.view">
        <field name="name">int.workbench.parameter.clamp.form</field>
        <field name="model">int.workbench.parameter.clamp</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="parameter_id"/>
                    <field name="analog" invisible="1"/>
                    <field name="value"/>
                </group>
                <footer>
                    <button name="action_clamp" type="object" string="Clamp" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
