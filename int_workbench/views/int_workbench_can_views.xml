<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The CAN modules and the intermediate values of the controllers: what the service reads from them, read only. -->

    <record id="int_workbench_can_module_view_list" model="ir.ui.view">
        <field name="name">int.workbench.can.module.list</field>
        <field name="model">int.workbench.can.module</field>
        <field name="arch" type="xml">
            <list js_class="int_workbench.live_list" create="0" edit="0" delete="0">
                <field name="device_id" optional="show"/>
                <field name="number"/>
                <field name="type_name"/>
                <field name="type_code" optional="hide"/>
                <field name="serial"/>
                <field name="mc_sw" optional="hide"/>
                <field name="sw"/>
                <field name="hw"/>
                <field name="can_status"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_can_module_view_search" model="ir.ui.view">
        <field name="name">int.workbench.can.module.search</field>
        <field name="model">int.workbench.can.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="type_name"/>
                <field name="serial"/>
                <field name="device_id"/>
                <group>
                    <filter name="by_device" string="Controller" context="{'group_by': 'device_id'}"/>
                    <filter name="by_type" string="Type" context="{'group_by': 'type_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_can_module_action" model="ir.actions.act_window">
        <field name="name">CAN modules</field>
        <field name="res_model">int.workbench.can.module</field>
        <field name="view_mode">list</field>
    </record>

    <!-- The intermediate values (ZWANZ and ZWWAHL of the original). Three screens: the values with their reading (it keeps itself current),
         the selection (which values are read, in which format; ordinary editing), and the variable list of the project to choose from. -->

    <!-- first: the list of the values has a button that opens it -->
    <record id="int_workbench_signal_action" model="ir.actions.act_window">
        <field name="name">Variables of the project</field>
        <field name="res_model">int.workbench.signal</field>
        <field name="view_mode">list</field>
    </record>

    <record id="int_workbench_intermediate_view_list" model="ir.ui.view">
        <field name="name">int.workbench.intermediate.list</field>
        <field name="model">int.workbench.intermediate</field>
        <field name="arch" type="xml">
            <list js_class="int_workbench.live_list" create="0" edit="0" delete="0" decoration-muted="not answered">
                <header>
                    <button name="%(int_workbench.int_workbench_signal_action)d" type="action" string="Choose values" icon="fa-list-ul" display="always"
                            title="Choose the values from the variable list of the project"
                            groups="int_workbench.int_workbench_group_technician"/>
                </header>
                <field name="device_id" optional="show"/>
                <field name="sequence" column_invisible="True"/>
                <field name="name"/>
                <field name="address" optional="show"/>
                <field name="format" optional="show"/>
                <field name="text"/>
                <field name="value" optional="hide"/>
                <field name="unit"/>
                <field name="raw" optional="hide"/>
                <field name="answered" optional="hide"/>
                <field name="locked" optional="hide"/>
                <field name="error" optional="show"/>
                <field name="can_write_value" column_invisible="True"/>
                <button name="action_edit_value" type="object" string="Edit" icon="fa-pencil" title="Write a value into the controller"
                        invisible="not can_write_value" groups="int_workbench.int_workbench_group_technician"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_intermediate_view_selection" model="ir.ui.view">
        <field name="name">int.workbench.intermediate.selection</field>
        <field name="model">int.workbench.intermediate</field>
        <field name="arch" type="xml">
            <list editable="bottom" js_class="int_workbench.selection_list" decoration-muted="not answered">
                <header>
                    <!-- what "Sort." of the original does, for the controllers of the rows that are selected -->
                    <button name="action_sort" type="object" string="Sort like the variable list" icon="fa-sort-amount-asc" display="selection"
                            groups="int_workbench.int_workbench_group_technician"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="device_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="name"/>
                <field name="address"/>
                <field name="is_byte"/>
                <field name="format"/>
                <field name="text" readonly="1"/>
                <field name="error" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_intermediate_view_search" model="ir.ui.view">
        <field name="name">int.workbench.intermediate.search</field>
        <field name="model">int.workbench.intermediate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="address"/>
                <field name="device_id"/>
                <filter name="unanswered" string="Not answered" domain="[('answered', '=', False)]"/>
                <group>
                    <filter name="by_device" string="Controller" context="{'group_by': 'device_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_intermediate_action" model="ir.actions.act_window">
        <field name="name">Intermediate values</field>
        <field name="res_model">int.workbench.intermediate</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="int_workbench_intermediate_view_list"/>
    </record>

    <record id="int_workbench_intermediate_selection_action" model="ir.actions.act_window">
        <field name="name">Selection of the intermediate values</field>
        <field name="res_model">int.workbench.intermediate</field>
        <field name="view_mode">list</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('int_workbench_intermediate_view_selection')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Choose the intermediate values to read</p>
            <p>Add a line for a value of your own (a name and an address), or use "Choose values" in the list of the intermediate values to take them from the variable list of the project.</p>
        </field>
    </record>

    <record id="int_workbench_signal_view_list" model="ir.ui.view">
        <field name="name">int.workbench.signal.list</field>
        <field name="model">int.workbench.signal</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="chosen">
                <header>
                    <button name="action_choose" type="object" string="Add to the intermediate values" icon="fa-plus" display="selection"
                            groups="int_workbench.int_workbench_group_technician"/>
                </header>
                <field name="device_id" optional="show"/>
                <field name="sequence" optional="hide"/>
                <field name="name"/>
                <field name="operand"/>
                <field name="is_byte"/>
                <field name="chosen"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_signal_view_search" model="ir.ui.view">
        <field name="name">int.workbench.signal.search</field>
        <field name="model">int.workbench.signal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('operand', 'ilike', self)]" string="Name or address"/>
                <field name="device_id"/>
                <filter name="byte" string="Bytes and bits" domain="[('is_byte', '=', True)]"/>
                <filter name="word" string="Words" domain="[('is_byte', '=', False)]"/>
                <group>
                    <filter name="by_device" string="Controller" context="{'group_by': 'device_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
