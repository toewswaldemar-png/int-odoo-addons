<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The devices come first: a technician chooses the device, the controller inside it is a detail of it. The rest is grouped by what one
         does, the way the original groups it (Anzeigen, Fehlerspeicher, Allgemein, Auswählen): watch (process values, intermediate values),
         the error memory, tools, projects, configuration. -->
    <menuitem id="int_workbench_menu_root" name="Workbench" sequence="35" groups="int_workbench_group_user"/>

    <menuitem id="int_workbench_parameter_menu" name="Process values" parent="int_workbench_menu_root"
              action="int_workbench_parameter_last_server_action" sequence="10"/>

    <menuitem id="int_workbench_error_memory_menu" name="Error memory" parent="int_workbench_menu_root" sequence="30"/>
    <menuitem id="int_workbench_error_menu" name="Current errors" parent="int_workbench_error_memory_menu"
              action="int_workbench_error_action" sequence="10"/>
    <menuitem id="int_workbench_error_history_menu" name="History" parent="int_workbench_error_memory_menu"
              action="int_workbench_error_history_action" sequence="20"/>
    <menuitem id="int_workbench_error_status_menu" name="Status records" parent="int_workbench_error_memory_menu"
              action="int_workbench_error_status_action" sequence="30"/>
    <menuitem id="int_workbench_fs2_file_menu" name="Files" parent="int_workbench_error_memory_menu"
              action="int_workbench_fs2_file_action" sequence="40"/>
    <menuitem id="int_workbench_fs2_record_menu" name="File records" parent="int_workbench_error_memory_menu"
              action="int_workbench_fs2_record_action" sequence="50"/>

    <menuitem id="int_workbench_device_menu" name="Devices" parent="int_workbench_menu_root"
              action="int_workbench_device_action" sequence="5"/>
    <menuitem id="int_workbench_menu_configuration" name="Configuration" parent="int_workbench_menu_root"
              sequence="90" groups="int_workbench_group_manager"/>
    <menuitem id="int_workbench_parameter_config_menu" name="Process values" parent="int_workbench_menu_configuration"
              action="int_workbench_parameter_config_action" sequence="10"/>
    <menuitem id="int_workbench_user_menu" name="Users" parent="int_workbench_menu_configuration"
              action="int_workbench_user_action" sequence="30"/>
    <menuitem id="int_workbench_log_menu" name="Log" parent="int_workbench_menu_configuration"
              action="int_workbench_log_action" sequence="40"/>
</odoo>
