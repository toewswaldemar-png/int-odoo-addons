<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A technician chooses the device, and what belongs to it is opened from its form: the process values, the favorites, the errors (buttons)
         and the error history, the saved error files, the log and the project (pages). So the menu has the devices and the configuration. -->
    <menuitem id="int_workbench_menu_root" name="Workbench" sequence="35" groups="int_workbench_group_user"/>


    <menuitem id="int_workbench_device_menu" name="Devices" parent="int_workbench_menu_root"
              action="int_workbench_device_action" sequence="5"/>
    <menuitem id="int_workbench_menu_configuration" name="Configuration" parent="int_workbench_menu_root"
              sequence="90" groups="int_workbench_group_manager"/>
    <menuitem id="int_workbench_parameter_config_menu" name="Process values" parent="int_workbench_menu_configuration"
              action="int_workbench_parameter_config_action" sequence="10"/>
    <menuitem id="int_workbench_combo_template_menu" name="Combinations" parent="int_workbench_menu_configuration"
              action="int_workbench_combo_template_action" sequence="18"/>
    <menuitem id="int_workbench_error_status_menu" name="Status records" parent="int_workbench_menu_configuration"
              action="int_workbench_error_status_action" sequence="30"/>
    <menuitem id="int_workbench_fs2_file_menu" name="Error files" parent="int_workbench_menu_configuration"
              action="int_workbench_fs2_file_action" sequence="40"/>
    <menuitem id="int_workbench_user_menu" name="Users" parent="int_workbench_menu_configuration"
              action="int_workbench_user_action" sequence="30"/>
    <menuitem id="int_workbench_log_menu" name="Log" parent="int_workbench_menu_configuration"
              action="int_workbench_log_action" sequence="40"/>
</odoo>
