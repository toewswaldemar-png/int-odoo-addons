<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="int_workbench_command_view_list" model="ir.ui.view">
        <field name="name">int.workbench.command.list</field>
        <field name="model">int.workbench.command</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state in ('failed', 'unconfirmed', 'unknown', 'expired')">
                <field name="create_date" string="Requested"/>
                <field name="device_id"/>
                <field name="user_id"/>
                <field name="code"/>
                <field name="parameter_id" optional="hide"/>
                <field name="action"/>
                <field name="value"/>
                <field name="state"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_command_view_search" model="ir.ui.view">
        <field name="name">int.workbench.command.search</field>
        <field name="model">int.workbench.command</field>
        <field name="arch" type="xml">
            <search>
                <field name="device_id"/>
                <field name="user_id"/>
                <field name="code"/>
                <filter name="problems" string="Problems" domain="[('state', 'in', ('failed', 'unconfirmed', 'unknown', 'expired'))]"/>
                <group>
                    <filter name="by_device" string="Controller" context="{'group_by': 'device_id'}"/>
                    <filter name="by_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_command_action" model="ir.actions.act_window">
        <field name="name">Clamp log</field>
        <field name="res_model">int.workbench.command</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
