<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="int_workbench_error_view_list" model="ir.ui.view">
        <field name="name">int.workbench.error.list</field>
        <field name="model">int.workbench.error</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="device_id"/>
                <field name="word"/>
                <field name="bit"/>
                <field name="text"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_error_view_search" model="ir.ui.view">
        <field name="name">int.workbench.error.search</field>
        <field name="model">int.workbench.error</field>
        <field name="arch" type="xml">
            <search>
                <field name="text" string="Error" filter_domain="['|', ('text', 'ilike', self), ('word', 'ilike', self)]"/>
                <field name="device_id"/>
                <group>
                    <filter name="by_device" string="Controller" context="{'group_by': 'device_id'}"/>
                    <filter name="by_word" string="Error word" context="{'group_by': 'word'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_error_action" model="ir.actions.act_window">
        <field name="name">Errors</field>
        <field name="res_model">int.workbench.error</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
