<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="int_workbench_error_view_list" model="ir.ui.view">
        <field name="name">int.workbench.error.list</field>
        <field name="model">int.workbench.error</field>
        <field name="arch" type="xml">
            <!-- the list loads itself afresh when the service reports other errors and says that somebody looks (static/src/views/parameter_list.js) -->
            <list js_class="int_workbench.error_list" create="0" edit="0" delete="0">
                <header>
                    <!-- always at the top, next to the title, for the controllers of the errors shown; clearing cannot be undone -->
                    <button name="action_clear_memory" type="object" string="Clear error memory" icon="fa-eraser" display="always"
                            title="Clear the error memory of the controllers shown"
                            confirm="Clear the error memory of the controllers whose errors are shown?"
                            groups="int_workbench.int_workbench_group_operator"/>
                </header>
                <field name="device_id"/>
                <field name="word"/>
                <field name="bit"/>
                <field name="text"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_error_view_search" model="ir.ui.view">
        <field name="name">int.workbench.error.search</field>
        <field name="model">int.workbench.error</field>
        <field name="arch" type="xml">
            <search>
                <field name="text" string="Error" filter_domain="['|', ('text', 'ilike', self), ('word', 'ilike', self)]"/>
                <field name="device_id"/>
                <group>
                    <filter name="by_device" string="Controller" context="{'group_by': 'device_id'}"/>
                    <filter name="by_word" string="Error word" context="{'group_by': 'word'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_error_action" model="ir.actions.act_window">
        <field name="name">Errors</field>
        <field name="res_model">int.workbench.error</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
