<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The programs of the controllers (images and program texts), read by their content. An old one is archived and cannot be loaded. -->

    <!-- The dialog that brings files in -->
    <record id="int_workbench_software_upload_view_form" model="ir.ui.view">
        <field name="name">int.workbench.software.upload.form</field>
        <field name="model">int.workbench.software.upload</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1"/>
                <group invisible="state != 'upload'">
                    <field name="attachment_ids" widget="many2many_binary" string="Files"/>
                </group>
                <group invisible="state != 'done'">
                    <field name="result" nolabel="1" colspan="2"/>
                    <field name="software_ids" invisible="1"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Import" class="btn-primary" invisible="state != 'upload'" data-hotkey="q"/>
                    <button name="action_show" type="object" string="Show the programs" class="btn-primary" invisible="state != 'done'" data-hotkey="q"/>
                    <button string="Close" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="int_workbench_software_upload_action" model="ir.actions.act_window">
        <field name="name">Import programs</field>
        <field name="res_model">int.workbench.software.upload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="int_workbench_software_view_list" model="ir.ui.view">
        <field name="name">int.workbench.software.list</field>
        <field name="model">int.workbench.software</field>
        <field name="arch" type="xml">
            <list decoration-warning="warnings">
                <header>
                    <button name="%(int_workbench_software_upload_action)d" type="action" string="Import" display="always"
                            groups="int_workbench.int_workbench_group_technician,int_workbench.int_workbench_group_manager"/>
                </header>
                <field name="name"/>
                <field name="kind"/>
                <field name="hardware" optional="show"/>
                <field name="os_version" optional="show"/>
                <field name="app_name" optional="show"/>
                <field name="resource" optional="hide"/>
                <field name="document" optional="show"/>
                <field name="document_codes" optional="hide"/>
                <field name="expected_os" optional="hide"/>
                <field name="size" optional="hide"/>
                <field name="short_id" optional="hide"/>
                <field name="warnings" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_software_view_form" model="ir.ui.view">
        <field name="name">int.workbench.software.form</field>
        <field name="model">int.workbench.software</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not warnings">
                        <field name="warnings" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Name"/></h1>
                    </div>
                    <group>
                        <group string="What it is">
                            <field name="kind"/>
                            <field name="hardware"/>
                            <field name="os_version" invisible="not os_version"/>
                            <field name="app_name" invisible="not app_name"/>
                            <field name="resource" invisible="not resource"/>
                            <field name="document" invisible="not document"/>
                            <field name="document_codes" invisible="not document_codes"/>
                            <field name="expected_os" invisible="not expected_os"/>
                        </group>
                        <group string="The file">
                            <field name="data" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="size"/>
                            <field name="data_size"/>
                            <field name="sha256"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Memory ranges" name="ranges">
                            <field name="ranges" readonly="1"/>
                        </page>
                        <page string="Names of the file" name="sources">
                            <field name="sources" readonly="1"/>
                        </page>
                        <page string="Note" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="int_workbench_software_view_search" model="ir.ui.view">
        <field name="name">int.workbench.software.search</field>
        <field name="model">int.workbench.software</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Program" filter_domain="['|', '|', '|', ('name', 'ilike', self), ('app_name', 'ilike', self), ('document', 'ilike', self), ('sources', 'ilike', self)]"/>
                <field name="document"/>
                <field name="os_version"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="with_warnings" string="With warnings" domain="[('warnings', '!=', False)]"/>
                <group>
                    <filter name="group_by_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    <filter name="group_by_hardware" string="Controller type" context="{'group_by': 'hardware'}"/>
                    <filter name="group_by_document" string="Document number" context="{'group_by': 'document'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_software_action" model="ir.actions.act_window">
        <field name="name">Software</field>
        <field name="res_model">int.workbench.software</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_kind': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No program yet</p>
            <p>Bring in the images and program texts of the controllers. They are read by their content, whatever they are called.</p>
        </field>
    </record>

</odoo>
