<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The error files the service saved in the project folder of a controller (the original's "Fehlerspeicher auswerten"): the list of
         the files and their records. Odoo's own search, grouping and export take the place of the evaluation view of the original. -->

    <record id="int_workbench_fs2_file_view_list" model="ir.ui.view">
        <field name="name">int.workbench.fs2.file.list</field>
        <field name="model">int.workbench.fs2.file</field>
        <field name="arch" type="xml">
            <list js_class="int_workbench.live_list" create="0" edit="0" delete="0">
                <header>
                    <button name="action_delete" type="object" string="Delete" icon="fa-trash" display="always"
                            title="Move the selected files to the folder of deleted files"
                            confirm="Move the selected files to the folder of deleted files?"
                            groups="int_workbench.int_workbench_group_technician"/>
                </header>
                <field name="device_id" optional="show"/>
                <field name="name"/>
                <field name="date"/>
                <field name="time"/>
                <field name="wagon"/>
                <field name="train"/>
                <field name="count"/>
                <field name="kind" optional="show"/>
                <field name="controller_type" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_fs2_file_view_search" model="ir.ui.view">
        <field name="name">int.workbench.fs2.file.search</field>
        <field name="model">int.workbench.fs2.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="wagon"/>
                <field name="train"/>
                <field name="device_id"/>
                <group>
                    <filter name="by_device" string="Device" context="{'group_by': 'device_id'}"/>
                    <filter name="by_wagon" string="Wagon" context="{'group_by': 'wagon'}"/>
                    <filter name="by_kind" string="Kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_fs2_file_action" model="ir.actions.act_window">
        <field name="name">Error files</field>
        <field name="res_model">int.workbench.fs2.file</field>
        <field name="view_mode">list</field>
    </record>

    <record id="int_workbench_fs2_record_view_list" model="ir.ui.view">
        <field name="name">int.workbench.fs2.record.list</field>
        <field name="model">int.workbench.fs2.record</field>
        <field name="arch" type="xml">
            <list js_class="int_workbench.live_list" create="0" edit="0" delete="0" decoration-danger="event == 'coming' and code &lt; 9990" decoration-muted="code &gt;= 9990">
                <field name="file_id"/>
                <field name="device_id" optional="hide"/>
                <field name="iso" string="Time"/>
                <field name="code"/>
                <field name="text"/>
                <field name="count"/>
                <field name="event" widget="badge" decoration-danger="event == 'coming'" decoration-success="event == 'going'"/>
                <field name="priority" string="P"/>
                <field name="kind" optional="show"/>
                <field name="wagon" optional="hide"/>
                <field name="train" optional="hide"/>
                <field name="entry" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_fs2_record_view_search" model="ir.ui.view">
        <field name="name">int.workbench.fs2.record.search</field>
        <field name="model">int.workbench.fs2.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="text" string="Error" filter_domain="['|', ('text', 'ilike', self), ('code', '=', self)]"/>
                <field name="file_id"/>
                <field name="wagon"/>
                <field name="train"/>
                <field name="device_id"/>
                <filter name="coming" string="Coming" domain="[('event', '=', 'coming')]"/>
                <filter name="going" string="Going" domain="[('event', '=', 'going')]"/>
                <separator/>
                <filter name="errors_only" string="Errors only" domain="[('code', '&lt;', 9990)]"
                        help="Without the entries that mark a restart, an initialization or a clearing."/>
                <group>
                    <filter name="by_file" string="File" context="{'group_by': 'file_id'}"/>
                    <filter name="by_code" string="Error" context="{'group_by': 'code'}"/>
                    <filter name="by_wagon" string="Wagon" context="{'group_by': 'wagon'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_fs2_record_action" model="ir.actions.act_window">
        <field name="name">Error file records</field>
        <field name="res_model">int.workbench.fs2.record</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
