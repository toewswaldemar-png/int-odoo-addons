<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="int_workbench_user_view_list" model="ir.ui.view">
        <field name="name">int.workbench.user.list</field>
        <field name="model">int.workbench.user</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="disabled">
                <field name="name"/>
                <field name="roles"/>
                <field name="disabled"/>
                <field name="device_id" optional="hide"/>
                <field name="created_at" optional="show"/>
                <field name="changed_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_user_view_search" model="ir.ui.view">
        <field name="name">int.workbench.user.search</field>
        <field name="model">int.workbench.user</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="roles"/>
                <field name="device_id"/>
                <filter name="disabled" string="Locked" domain="[('disabled', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="int_workbench_user_action" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="res_model">int.workbench.user</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
