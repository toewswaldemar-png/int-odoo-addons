<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The error memory of the controller (non-volatile): the history and the status records. Both are read from the controller by the
         service now and then and come with its report; nothing here can be edited. -->

    <record id="int_workbench_error_history_view_list" model="ir.ui.view">
        <field name="name">int.workbench.error.history.list</field>
        <field name="model">int.workbench.error.history</field>
        <field name="arch" type="xml">
            <list js_class="int_workbench.live_list" create="0" edit="0" delete="0" decoration-danger="event == 'coming' and code &lt; 9990" decoration-muted="code &gt;= 9990">
                <field name="device_id" optional="show"/>
                <field name="entry" optional="hide"/>
                <field name="controller_time" string="Time"/>
                <field name="code"/>
                <field name="text"/>
                <field name="count"/>
                <field name="event" widget="badge" decoration-danger="event == 'coming'" decoration-success="event == 'going'"/>
                <field name="priority" string="P"/>
                <field name="raw" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_error_history_view_search" model="ir.ui.view">
        <field name="name">int.workbench.error.history.search</field>
        <field name="model">int.workbench.error.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="text" string="Error" filter_domain="['|', ('text', 'ilike', self), ('code', '=', self)]"/>
                <field name="device_id"/>
                <filter name="coming" string="Coming" domain="[('event', '=', 'coming')]"/>
                <filter name="going" string="Going" domain="[('event', '=', 'going')]"/>
                <separator/>
                <filter name="errors_only" string="Errors only" domain="[('code', '&lt;', 9990)]"
                        help="Without the entries that mark a restart, an initialization or a clearing."/>
                <group>
                    <filter name="by_device" string="Controller" context="{'group_by': 'device_id'}"/>
                    <filter name="by_code" string="Error" context="{'group_by': 'code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_error_history_action" model="ir.actions.act_window">
        <field name="name">Error history</field>
        <field name="res_model">int.workbench.error.history</field>
        <field name="view_mode">list</field>
    </record>

    <record id="int_workbench_error_status_view_list" model="ir.ui.view">
        <field name="name">int.workbench.error.status.list</field>
        <field name="model">int.workbench.error.status</field>
        <field name="arch" type="xml">
            <list js_class="int_workbench.live_list" create="0" edit="0" delete="0" decoration-danger="present" decoration-muted="not reported">
                <field name="device_id" optional="show"/>
                <field name="rank"/>
                <field name="element" optional="show"/>
                <field name="code"/>
                <field name="text"/>
                <field name="count"/>
                <field name="present" string="There now"/>
                <field name="newest" string="Came last" optional="show"/>
                <field name="level" optional="hide"/>
                <field name="wprio" optional="hide"/>
                <field name="lmzus" optional="hide"/>
                <field name="quit" optional="hide"/>
                <field name="raw" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_error_status_view_search" model="ir.ui.view">
        <field name="name">int.workbench.error.status.search</field>
        <field name="model">int.workbench.error.status</field>
        <field name="arch" type="xml">
            <search>
                <field name="text" string="Error" filter_domain="['|', ('text', 'ilike', self), ('code', '=', self)]"/>
                <field name="device_id"/>
                <filter name="present" string="There now" domain="[('present', '=', True)]"/>
                <filter name="reported" string="Has come" domain="[('reported', '=', True)]"
                        help="The error is there or has been there since the error memory was cleared."/>
                <group>
                    <filter name="by_device" string="Controller" context="{'group_by': 'device_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_error_status_action" model="ir.actions.act_window">
        <field name="name">Error status</field>
        <field name="res_model">int.workbench.error.status</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
