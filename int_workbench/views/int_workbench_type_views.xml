<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="int_workbench_type_view_list" model="ir.ui.view">
        <field name="name">int.workbench.type.list</field>
        <field name="model">int.workbench.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ident"/>
                <field name="kind"/>
                <field name="family_id"/>
                <field name="project_version_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_type_view_form" model="ir.ui.view">
        <field name="name">int.workbench.type.form</field>
        <field name="model">int.workbench.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="ident"/>
                            <field name="kind"/>
                            <field name="family_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="project_version_id" options="{'no_create': True}" invisible="kind != 'device'"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Devices" name="devices" invisible="kind != 'device'">
                            <field name="device_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="serial"/>
                                    <field name="controller_type_id"/>
                                    <field name="controller_serial"/>
                                </list>
                            </field>
                        </page>
                        <page string="Devices with this controller" name="controller_devices" invisible="kind != 'controller'">
                            <field name="controller_device_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="device_type_id"/>
                                    <field name="controller_serial"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" placeholder="Note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="int_workbench_type_view_search" model="ir.ui.view">
        <field name="name">int.workbench.type.search</field>
        <field name="model">int.workbench.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Type" filter_domain="['|', ('name', 'ilike', self), ('ident', 'ilike', self)]"/>
                <field name="family_id"/>
                <filter name="device" string="Device types" domain="[('kind', '=', 'device')]"/>
                <filter name="controller" string="Controller types" domain="[('kind', '=', 'controller')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    <filter name="by_family" string="Family" context="{'group_by': 'family_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_type_action" model="ir.actions.act_window">
        <field name="name">Types</field>
        <field name="res_model">int.workbench.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
