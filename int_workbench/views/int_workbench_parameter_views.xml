<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The process values and the clamps of the controllers: ordinary records, filtered and grouped like any list. The list reloads
         when the service reports a change and says to the service that somebody looks (static/src/views/parameter_list.js). -->
    <record id="int_workbench_parameter_view_list" model="ir.ui.view">
        <field name="name">int.workbench.parameter.list</field>
        <field name="model">int.workbench.parameter</field>
        <field name="arch" type="xml">
            <!-- edit="1": a list is read-only for everybody if nobody may write the model, and then the star and the handle would be grey.
                 The fields are written by the service only; the star, the order and, for the operator, the clamp (switch and value) are
                 written by write(), which lets through only these and only for those who may. The list is edited in place: the switch
                 clamps a row to the value it has or releases it, the value is typed into the cell, and a value changed in one of several
                 ticked rows can be taken over for all of them (multi_edit, as Odoo asks). -->
            <!-- the row says how it stands: a clamped row is yellow, a row that could not be read red, a value that is out of date grey -->
            <list js_class="int_workbench.parameter_list" create="0" edit="1" delete="0" editable="bottom" multi_edit="1"
                  default_order="sequence, device_id, code"
                  decoration-warning="clamped" decoration-danger="status != 'ok'" decoration-muted="stale">
                <header>
                    <button name="action_release" type="object" string="Release" groups="int_workbench.int_workbench_group_operator"/>
                    <!-- always at the top, next to the title, for the clamps of all rows shown -->
                    <button name="action_release_all" type="object" string="Release all" icon="fa-unlock" display="always"
                            title="Release the clamps of all rows shown" groups="int_workbench.int_workbench_group_operator"/>
                </header>
                <field name="sequence" widget="handle" groups="int_workbench.int_workbench_group_operator,int_workbench.int_workbench_group_manager"/>
                <field name="is_favorite" widget="boolean_favorite" nolabel="1" string="Favorite"/>
                <!-- every column has its width, so that they stand close together; only the tags, the last column, take what is left -->
                <field name="device_id" optional="hide" width="140px"/>
                <field name="code" width="80px"/>
                <field name="name" width="260px"/>
                <field name="text" class="fw-bold" width="110px"/>
                <field name="auto_text" optional="hide" width="110px"/>
                <field name="unit" optional="hide" width="70px"/>
                <field name="value" optional="hide" width="90px" options="{'hide_trailing_zeros': true}"/>
                <!-- the operator: the switch, then the value it clamps to (trailing zeros left out: 1, not 1,000). Only rows the controller
                     can clamp, and only if its family can clamp at all -->
                <field name="clamp_toggle" widget="boolean_toggle" groups="int_workbench.int_workbench_group_operator" width="90px"
                       readonly="not can_clamp or not device_cap_clamps"/>
                <field name="clamp_input" groups="int_workbench.int_workbench_group_operator" decoration-muted="not clamp_toggle" width="110px"
                       options="{'hide_trailing_zeros': true}" readonly="not can_clamp or not device_cap_clamps" optional="show"/>
                <!-- everybody else sees it as it is -->
                <field name="clamped" string="Clamping" widget="boolean" groups="!int_workbench.int_workbench_group_operator" width="90px"/>
                <field name="clamp_value" string="Clamp value" invisible="not clamped" groups="!int_workbench.int_workbench_group_operator"
                       width="110px" options="{'hide_trailing_zeros': true}" optional="show"/>
                <!-- how the read went is a diagnosis for the administrator, not for the one who operates: hidden, the column picker brings it back -->
                <field name="status" widget="badge" decoration-success="status == 'ok'" decoration-danger="status != 'ok'" optional="hide"
                       width="100px"/>
                <!-- the operator tags rows in the list (and several ticked rows at once); everybody else sees the tags -->
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                       groups="int_workbench.int_workbench_group_operator"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="1"
                       groups="!int_workbench.int_workbench_group_operator"/>
                <field name="can_clamp" column_invisible="1"/>
                <field name="analog" column_invisible="1"/>
                <field name="device_cap_clamps" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_parameter_view_search" model="ir.ui.view">
        <field name="name">int.workbench.parameter.search</field>
        <field name="model">int.workbench.parameter</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Code or description" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="device_id"/>
                <field name="tag_ids"/>
                <field name="unit"/>
                <filter name="favorites" string="Favorites" domain="[('is_favorite', '=', True)]"/>
                <filter name="clamped" string="Clamped" domain="[('clamped', '=', True)]"/>
                <filter name="can_clamp" string="Can be clamped" domain="[('can_clamp', '=', True)]"/>
                <filter name="analog" string="Analog" domain="[('analog', '=', True)]"/>
                <filter name="problems" string="Problems" domain="[('status', '!=', 'ok')]"/>
                <group>
                    <filter name="by_device" string="Controller" context="{'group_by': 'device_id'}"/>
                    <filter name="by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="by_tag" string="Tags" context="{'group_by': 'tag_ids'}"/>
                    <filter name="by_unit" string="Unit" context="{'group_by': 'unit'}"/>
                </group>
                <searchpanel>
                    <field name="device_id" string="Controller" icon="fa-microchip"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="int_workbench_parameter_action" model="ir.actions.act_window">
        <field name="name">Process values</field>
        <field name="res_model">int.workbench.parameter</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
