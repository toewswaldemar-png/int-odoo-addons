<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="int_workbench_device_view_list" model="ir.ui.view">
        <field name="name">int.workbench.device.list</field>
        <field name="model">int.workbench.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="device_type_id"/>
                <field name="serial"/>
                <field name="controller_type_id"/>
                <field name="controller_serial" optional="hide"/>
                <field name="project_state" widget="badge" decoration-success="project_state == 'same'"
                       decoration-warning="project_state == 'differs'" decoration-muted="project_state in ('none', 'unknown')"/>
                <field name="connection_state" widget="badge" decoration-success="connection_state == 'connected'"
                       decoration-warning="connection_state in ('disconnected', 'silent')"/>
                <field name="device_ref" optional="hide"/>
                <field name="family_id" optional="hide"/>
                <field name="service_user_id" optional="hide"/>
                <field name="seen_at" optional="hide"/>
                <field name="snapshot_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_device_view_form" model="ir.ui.view">
        <field name="name">int.workbench.device.form</field>
        <field name="model">int.workbench.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- what a technician asks of the controller: the buttons that the family cannot serve are hidden by its capabilities -->
                    <button name="action_set_clock" type="object" string="Set the clock" icon="fa-clock-o"
                            groups="int_workbench.int_workbench_group_technician" invisible="not cap_clock"/>
                    <button name="action_control_can" type="object" string="CAN bus" icon="fa-sitemap"
                            groups="int_workbench.int_workbench_group_technician" invisible="not cap_can_control"/>
                    <button name="action_open_console" type="object" string="Console" icon="fa-terminal"
                            groups="int_workbench.int_workbench_group_technician" invisible="not cap_console"/>
                    <button name="action_save_error_files" type="object" string="Save errors" icon="fa-save"
                            groups="int_workbench.int_workbench_group_technician" invisible="not cap_error_files"/>
                    <button name="action_reset" type="object" string="Restart" icon="fa-power-off"
                            groups="int_workbench.int_workbench_group_technician" invisible="not cap_console"
                            confirm="Restart the controller? The line is lost for a while."/>
                    <!-- what Odoo asks of the service: the buttons that the service cannot serve are hidden by its capabilities -->
                    <button name="action_fetch_users" type="object" string="Fetch users"
                            groups="int_workbench.int_workbench_group_manager" invisible="not service_url"/>
                    <button name="action_fetch_log" type="object" string="Fetch log"
                            groups="int_workbench.int_workbench_group_manager" invisible="not service_url"/>
                    <button name="action_fetch_projects" type="object" string="Fetch projects"
                            groups="int_workbench.int_workbench_group_manager" invisible="not service_url or not cap_project_files"/>
                    <button name="action_import_projects" type="object" string="Import new folders"
                            groups="int_workbench.int_workbench_group_manager" invisible="not service_url or not cap_project_files"/>
                </header>
                <sheet>
                    <!-- the lists of this device: the lists of the menu (live, with their clamps) for the rows of this device only -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_parameters" type="object" class="oe_stat_button" icon="fa-sliders" invisible="not id">
                            <field name="parameter_count" widget="statinfo" string="Process values"/>
                        </button>
                        <button name="action_open_errors" type="object" class="oe_stat_button" icon="fa-exclamation-triangle" invisible="not id">
                            <field name="error_count" widget="statinfo" string="Errors"/>
                        </button>
                        <button name="action_open_commands" type="object" class="oe_stat_button" icon="fa-history" invisible="not id">
                            <field name="command_count" widget="statinfo" string="Requests"/>
                        </button>
                        <!-- what the device has: its project (the assigned version) and the programs that fit it -->
                        <button name="action_open_project" type="object" class="oe_stat_button" icon="fa-folder-open" invisible="not id">
                            <field name="project_version_count" widget="statinfo" string="Projects"/>
                        </button>
                        <button name="action_open_software" type="object" class="oe_stat_button" icon="fa-microchip" invisible="not project_version_id">
                            <field name="project_software_count" widget="statinfo" string="Software"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <!-- one block, two columns, no headings: what a technician needs at a glance. The settings of the service are on a page -->
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_type_id" string="Type" options="{'no_create': True}"/>
                            <field name="serial" string="Serial no."/>
                            <field name="project_version_id" string="Project" options="{'no_create': True}"/>
                            <field name="project_state" string="State" widget="badge" decoration-success="project_state == 'same'"
                                   decoration-warning="project_state == 'differs'" decoration-muted="project_state in ('none', 'unknown')"/>
                        </group>
                        <group>
                            <field name="controller_type_id" string="Controller" options="{'no_create': True}"/>
                            <field name="controller_serial" string="Serial no."/>
                            <field name="family_id"/>
                            <field name="connection_state" widget="badge" decoration-success="connection_state == 'connected'"
                                   decoration-warning="connection_state in ('disconnected', 'silent')"/>
                            <field name="clock_local_time" invisible="not clock_local_time"/>
                            <field name="can_count" string="CAN modules" invisible="not can_count"/>
                        </group>
                    </group>
                    <field name="active" invisible="1"/>
                    <field name="cap_clamps" invisible="1"/>
                    <field name="cap_clock" invisible="1"/>
                    <field name="cap_console" invisible="1"/>
                    <field name="cap_can_control" invisible="1"/>
                    <field name="cap_error_files" invisible="1"/>
                    <field name="cap_project_files" invisible="1"/>
                    <!-- the settings of the service are in the dialog of the gear menu; a new device needs them to be created -->
                    <group invisible="id">
                        <field name="device_ref" string="Id"/>
                        <field name="service_user_id" string="User"/>
                        <field name="service_url" string="Address"/>
                        <field name="service_token" string="Token" password="True" groups="int_workbench.int_workbench_group_manager"/>
                    </group>
                    <notebook>
                        <page string="CAN modules" name="can_modules" invisible="not can_module_ids">
                            <field name="can_module_ids" readonly="1">
                                <list>
                                    <field name="number"/>
                                    <field name="type_name"/>
                                    <field name="serial"/>
                                    <field name="sw"/>
                                    <field name="hw"/>
                                    <field name="can_status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" placeholder="Note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- The settings of the service: a dialog that the gear menu of the device opens (see static/src/cog) -->
    <record id="int_workbench_device_view_form_service" model="ir.ui.view">
        <field name="name">int.workbench.device.form.service</field>
        <field name="model">int.workbench.device</field>
        <field name="arch" type="xml">
            <form>
                <field name="clock_local_time" invisible="1"/>
                <group>
                    <group>
                        <field name="device_ref" string="Id"/>
                        <field name="service_user_id" string="User"/>
                        <field name="service_url" string="Address"/>
                        <field name="service_token" string="Token" password="True" groups="int_workbench.int_workbench_group_manager"/>
                    </group>
                    <group>
                        <field name="seen_at" string="Last seen"/>
                        <field name="snapshot_at"/>
                        <field name="viewer_at"/>
                        <field name="clock_read_at" invisible="not clock_local_time"/>
                        <field name="project_active_checksum" invisible="not project_active_checksum"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="int_workbench_device_view_search" model="ir.ui.view">
        <field name="name">int.workbench.device.search</field>
        <field name="model">int.workbench.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Device" filter_domain="['|', '|', '|', ('name', 'ilike', self), ('serial', 'ilike', self), ('controller_serial', 'ilike', self), ('device_ref', 'ilike', self)]"/>
                <field name="device_type_id"/>
                <field name="controller_type_id"/>
                <field name="family_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_device_type" string="Device type" context="{'group_by': 'device_type_id'}"/>
                    <filter name="by_controller_type" string="Controller type" context="{'group_by': 'controller_type_id'}"/>
                    <filter name="by_family" string="Family" context="{'group_by': 'family_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_device_action" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">int.workbench.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
