<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="int_workbench_device_view_list" model="ir.ui.view">
        <field name="name">int.workbench.device.list</field>
        <field name="model">int.workbench.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="device_ref"/>
                <field name="family_id" optional="show"/>
                <field name="service_user_id"/>
                <field name="seen_at"/>
                <field name="snapshot_at"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_device_view_form" model="ir.ui.view">
        <field name="name">int.workbench.device.form</field>
        <field name="model">int.workbench.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- what Odoo asks of the service: the buttons that the service cannot serve are hidden by its capabilities -->
                    <button name="action_fetch_users" type="object" string="Fetch users"
                            groups="int_workbench.int_workbench_group_manager" invisible="not service_url"/>
                    <button name="action_fetch_log" type="object" string="Fetch log"
                            groups="int_workbench.int_workbench_group_manager" invisible="not service_url"/>
                    <button name="action_fetch_projects" type="object" string="Fetch projects"
                            groups="int_workbench.int_workbench_group_manager" invisible="not service_url or not cap_project_files"/>
                    <button name="action_import_projects" type="object" string="Take over new folders"
                            groups="int_workbench.int_workbench_group_manager" invisible="not service_url or not cap_project_files"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_ref"/>
                            <field name="service_user_id"/>
                            <field name="family_id"/>
                        </group>
                        <group>
                            <field name="service_url"/>
                            <field name="service_token" password="True" groups="int_workbench.int_workbench_group_manager"/>
                            <field name="seen_at"/>
                            <field name="snapshot_at"/>
                            <field name="viewer_at"/>
                        </group>
                    </group>
                    <field name="active" invisible="1"/>
                    <field name="cap_clamps" invisible="1"/>
                    <field name="cap_project_files" invisible="1"/>
                    <notebook>
                        <page string="Capabilities" name="capabilities">
                            <field name="capability_ids" widget="many2many_tags" readonly="1"/>
                        </page>
                        <page string="Errors" name="errors">
                            <field name="error_ids" readonly="1">
                                <list>
                                    <field name="word"/>
                                    <field name="bit"/>
                                    <field name="text"/>
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" placeholder="Note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="int_workbench_device_view_search" model="ir.ui.view">
        <field name="name">int.workbench.device.search</field>
        <field name="model">int.workbench.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="device_ref"/>
                <field name="family_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_family" string="Family" context="{'group_by': 'family_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="int_workbench_device_action" model="ir.actions.act_window">
        <field name="name">Controllers</field>
        <field name="res_model">int.workbench.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
