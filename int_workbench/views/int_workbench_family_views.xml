<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="int_workbench_family_view_list" model="ir.ui.view">
        <field name="name">int.workbench.family.list</field>
        <field name="model">int.workbench.family</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="label"/>
                <field name="name"/>
                <field name="transports"/>
                <field name="capability_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="int_workbench_family_view_form" model="ir.ui.view">
        <field name="name">int.workbench.family.form</field>
        <field name="model">int.workbench.family</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <field name="label"/>
                        <field name="name"/>
                        <field name="transports"/>
                        <field name="capability_ids" widget="many2many_tags"/>
                    </group>
                    <field name="device_ids">
                        <list>
                            <field name="name"/>
                            <field name="device_ref"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="int_workbench_family_view_search" model="ir.ui.view">
        <field name="name">int.workbench.family.search</field>
        <field name="model">int.workbench.family</field>
        <field name="arch" type="xml">
            <search>
                <field name="label" string="Family" filter_domain="['|', ('label', 'ilike', self), ('name', 'ilike', self)]"/>
                <field name="capability_ids"/>
            </search>
        </field>
    </record>

    <record id="int_workbench_family_action" model="ir.actions.act_window">
        <field name="name">Families</field>
        <field name="res_model">int.workbench.family</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
