<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="int_workbench.App">
        <div class="o_action o_int_workbench d-flex flex-column overflow-auto">
            <div t-if="!state.devices.length" class="p-5 text-center text-muted">
                <i class="fa fa-plug fa-3x mb-3 d-block" />
                <p class="mb-1">No controller is set up yet.</p>
                <p>A manager adds one under Controller / Controllers: a name, its id in the controller service and the service user.</p>
            </div>
            <t t-else="">
                <div class="d-flex flex-wrap align-items-center gap-3 px-3 py-2 border-bottom bg-view">
                    <select class="form-select w-auto" t-on-change="(ev) => this.selectDevice(ev.target.value)">
                        <option t-foreach="state.devices" t-as="dev" t-key="dev.id" t-att-value="dev.id" t-att-selected="dev.id === state.deviceId" t-esc="dev.name" />
                    </select>
                    <span t-if="status.state.data or serviceUnreachable" t-attf-class="badge rounded-pill text-bg-#{connected ? 'success' : 'danger'}">
                        <t t-if="connected">Connected</t>
                        <t t-elif="serviceUnreachable">No report</t>
                        <t t-else="">Not connected</t>
                    </span>
                    <span t-if="reportAgeText" class="text-muted small" t-esc="reportAgeText" />
                    <ul class="nav nav-pills">
                        <li class="nav-item" t-foreach="tabs" t-as="tab" t-key="tab.id">
                            <a href="#" t-attf-class="nav-link py-1 #{state.tab === tab.id ? 'active' : ''}"
                               t-on-click.prevent="() => state.tab = tab.id">
                                <i t-attf-class="fa #{tab.icon} me-1" /><t t-esc="tab.label" />
                            </a>
                        </li>
                    </ul>
                </div>

                <div t-if="serviceUnreachable" class="alert alert-danger m-3" role="alert">
                    <p class="mb-1"><strong>No report from the controller service.</strong> <t t-esc="status.state.error" /></p>
                    <p class="mb-0 small">
                        The service on the computer at the controller must be running with the connection to Odoo, and this controller
                        (id <code t-esc="device.device_ref" />) must be assigned to the user of its API key.
                    </p>
                </div>

                <div class="flex-grow-1 p-3">
                    <ReglerOverview t-key="state.deviceId" t-if="state.tab === 'overview' and client" client="client" />
                    <ReglerErrors t-key="state.deviceId" t-elif="state.tab === 'errors' and client" client="client" />
                </div>
            </t>
        </div>
    </t>

</templates>
