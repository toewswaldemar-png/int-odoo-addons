<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="int_workbench.Overview">
        <div class="row g-3">
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Connection</div>
                        <t t-if="status.state.data">
                            <div t-attf-class="fs-3 fw-semibold text-#{status.state.data.connected ? 'success' : 'danger'}">
                                <t t-if="status.state.data.connected">Connected</t>
                                <t t-else="">Not connected</t>
                            </div>
                            <div class="small text-muted">
                                Controller <t t-esc="status.state.data.device" />,
                                since <t t-esc="formatTime(status.state.data.since)" />
                            </div>
                            <div t-if="status.state.data.last_error" class="small text-danger" t-esc="status.state.data.last_error" />
                        </t>
                        <div t-else="" class="placeholder-glow"><span class="placeholder col-8" /></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Cycle</div>
                        <t t-if="status.state.data">
                            <div class="fs-3 fw-semibold"><t t-esc="cycleSeconds" /> s</div>
                            <div class="small text-muted">
                                <t t-esc="status.state.data.entries" /> entries,
                                <t t-esc="status.state.data.cycles" /> rounds,
                                last read <t t-esc="ago(status.state.data.last_read)" />
                            </div>
                        </t>
                        <div t-else="" class="placeholder-glow"><span class="placeholder col-8" /></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Active error signals</div>
                        <t t-if="errors.state.data">
                            <div t-attf-class="fs-3 fw-semibold text-#{errors.state.data.active.length ? 'danger' : 'success'}" t-esc="errors.state.data.active.length" />
                            <div class="small text-muted"><t t-esc="errors.state.data.words.length" /> error words watched</div>
                        </t>
                        <div t-else="" class="placeholder-glow"><span class="placeholder col-8" /></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Controller time</div>
                        <t t-if="clock.state.data">
                            <div class="fs-5 fw-semibold" t-esc="clock.state.data.local_time || '–'" />
                            <div class="small text-muted" t-esc="clock.state.data.error || ''" />
                        </t>
                        <div t-else="" class="placeholder-glow"><span class="placeholder col-8" /></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">Active error signals</div>
                    <div class="card-body">
                        <p t-if="errors.state.data and !errors.state.data.active.length" class="text-success mb-0">
                            <i class="fa fa-check-circle me-1" />No active errors
                        </p>
                        <div t-foreach="errors.state.data?.active || []" t-as="error" t-key="error.word + error.bit"
                             class="d-flex justify-content-between align-items-center border rounded px-2 py-1 mb-2">
                            <span t-esc="error.text" />
                            <span class="badge text-bg-light font-monospace"><t t-esc="error.word" />.<t t-esc="error.bit" /></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">Error memory</div>
                    <div class="card-body">
                        <t t-if="memory.state.data">
                            <div class="row text-center g-2 mb-2">
                                <div class="col"><div class="border rounded p-2"><div class="fs-4 fw-semibold text-danger" t-esc="memory.state.data.active_count" /><div class="small text-muted">pending</div></div></div>
                                <div class="col"><div class="border rounded p-2"><div class="fs-4 fw-semibold" t-esc="memory.state.data.history_count" /><div class="small text-muted">in the history</div></div></div>
                                <div class="col"><div class="border rounded p-2"><div class="fs-4 fw-semibold" t-esc="memory.state.data.status_total" /><div class="small text-muted">status records</div></div></div>
                            </div>
                            <div class="small text-muted">Read <t t-esc="ago(memory.state.data.read_at)" /></div>
                        </t>
                        <div t-else="" class="placeholder-glow"><span class="placeholder col-8" /></div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="int_workbench.Errors">
        <div>
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link #{state.tab === 'active' ? 'active' : ''}" t-on-click.prevent="() => state.tab = 'active'">
                        Active<t t-if="errors.state.data"> (<t t-esc="errors.state.data.active.length" />)</t>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link #{state.tab === 'history' ? 'active' : ''}" t-on-click.prevent="() => state.tab = 'history'">
                        History<t t-if="memory.state.data"> (<t t-esc="memory.state.data.history_count" />)</t>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link #{state.tab === 'words' ? 'active' : ''}" t-on-click.prevent="() => state.tab = 'words'">
                        Error words<t t-if="errors.state.data"> (<t t-esc="errors.state.data.words.length" />)</t>
                    </a>
                </li>
            </ul>

            <div t-if="state.tab === 'active'" class="card">
                <div class="card-body">
                    <p t-if="errors.state.data and !errors.state.data.active.length" class="text-success mb-0">
                        <i class="fa fa-check-circle me-1" />No active errors
                    </p>
                    <div t-foreach="errors.state.data?.active || []" t-as="error" t-key="error.word + error.bit"
                         class="d-flex justify-content-between align-items-center border rounded px-2 py-1 mb-2">
                        <span t-esc="error.text" />
                        <span class="badge text-bg-light font-monospace"><t t-esc="error.word" />.<t t-esc="error.bit" /></span>
                    </div>
                </div>
            </div>

            <div t-elif="state.tab === 'history'" class="card">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr><th class="ps-3">No.</th><th>Message</th><th class="text-end">Count</th><th class="pe-3">Time</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="memory.state.data?.history || []" t-as="item" t-key="item_index">
                                <td class="ps-3 font-monospace small text-muted" t-esc="item.code" />
                                <td class="fw-medium" t-esc="item.text" />
                                <td class="text-end" t-esc="item.count" />
                                <td class="pe-3 text-muted" t-esc="item.time.replace('T', ' ')" />
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div t-else="" class="row g-3">
                <div class="col-lg-6" t-foreach="errors.state.data?.words || []" t-as="word" t-key="word.name">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between">
                            <span><t t-esc="word.name" /> <span class="font-monospace small text-muted" t-esc="word.address" /></span>
                            <span class="badge text-bg-light font-monospace" t-esc="word.raw || '–'" />
                        </div>
                        <div class="card-body d-flex flex-wrap gap-1">
                            <span t-foreach="word.bits" t-as="bit" t-key="bit.bit"
                                  t-attf-class="badge #{bit.active ? 'text-bg-danger' : 'text-bg-light text-muted'}" t-esc="bit.text" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
