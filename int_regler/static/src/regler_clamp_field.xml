<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="int_regler.ClampField">
        <!-- a click must not open or select the row; a row that cannot be clamped shows nothing -->
        <div t-if="data.can_clamp" class="o_int_regler_clamp d-flex align-items-center gap-2" t-on-click.stop="">
            <!-- the lock has its place in every row, so that the buttons stand in one line whether a row is clamped or not -->
            <span class="o_int_regler_lock"><i t-if="data.clamped" class="fa fa-lock text-warning" title="Clamped"/></span>
            <t t-if="operator">
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn o_int_regler_auto" t-att-class="isAuto ? 'btn-secondary active' : 'btn-outline-secondary'"
                            t-att-disabled="!canUse" t-on-click="auto">
                        <i t-if="state.pending === 'auto'" class="fa fa-spinner fa-spin"/>
                        <t t-else="">Auto</t>
                    </button>
                    <t t-if="!data.analog">
                        <button type="button" class="btn o_int_regler_zero" t-att-class="isClampedTo(0) ? 'btn-warning' : 'btn-outline-secondary'"
                                t-att-disabled="!canUse" t-on-click="() => this.pick(0)">
                            <i t-if="state.pending === '0'" class="fa fa-spinner fa-spin"/>
                            <t t-else="">0</t>
                        </button>
                        <button type="button" class="btn o_int_regler_one" t-att-class="isClampedTo(1) ? 'btn-warning' : 'btn-outline-secondary'"
                                t-att-disabled="!canUse" t-on-click="() => this.pick(1)">
                            <i t-if="state.pending === '1'" class="fa fa-spinner fa-spin"/>
                            <t t-else="">1</t>
                        </button>
                    </t>
                    <!-- the number of an analog row: shows the value now (or the clamp) and opens the popover where it is entered; there is
                         no input in the list, so the rows are of one height -->
                    <button t-else="" type="button" class="btn o_int_regler_number"
                            t-att-class="data.clamped ? 'btn-warning' : 'btn-outline-secondary'"
                            t-att-disabled="!canUse" t-on-click="openNumber" title="Enter a number">
                        <i t-if="state.pending === 'set'" class="fa fa-spinner fa-spin"/>
                        <t t-else=""><t t-esc="numberText"/><i class="fa fa-pencil ms-2 opacity-50"/></t>
                    </button>
                </div>
            </t>
            <!-- who cannot press sees the state as text, as a read-only field of Odoo shows it -->
            <t t-else="">
                <span t-if="data.clamped" class="o_int_regler_state badge text-bg-warning" t-esc="clampText"/>
                <span t-else="" class="o_int_regler_state text-muted">Auto</span>
            </t>
        </div>
    </t>
</templates>
