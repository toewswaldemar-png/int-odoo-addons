<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="int_regler.Overview">
        <div class="row g-3">
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Connection</div>
                        <t t-if="status.state.data">
                            <div t-attf-class="fs-3 fw-semibold text-#{status.state.data.connected ? 'success' : 'danger'}">
                                <t t-if="status.state.data.connected">Connected</t>
                                <t t-else="">Not connected</t>
                            </div>
                            <div class="small text-muted">
                                Controller <t t-esc="status.state.data.device" />,
                                since <t t-esc="formatTime(status.state.data.since)" />
                            </div>
                            <div t-if="status.state.data.last_error" class="small text-danger" t-esc="status.state.data.last_error" />
                        </t>
                        <div t-else="" class="placeholder-glow"><span class="placeholder col-8" /></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Cycle</div>
                        <t t-if="status.state.data">
                            <div class="fs-3 fw-semibold"><t t-esc="cycleSeconds" /> s</div>
                            <div class="small text-muted">
                                <t t-esc="status.state.data.entries" /> entries,
                                <t t-esc="status.state.data.cycles" /> rounds,
                                last read <t t-esc="ago(status.state.data.last_read)" />
                            </div>
                        </t>
                        <div t-else="" class="placeholder-glow"><span class="placeholder col-8" /></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Active error signals</div>
                        <t t-if="errors.state.data">
                            <div t-attf-class="fs-3 fw-semibold text-#{errors.state.data.active.length ? 'danger' : 'success'}" t-esc="errors.state.data.active.length" />
                            <div class="small text-muted"><t t-esc="errors.state.data.words.length" /> error words watched</div>
                        </t>
                        <div t-else="" class="placeholder-glow"><span class="placeholder col-8" /></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Controller time</div>
                        <t t-if="clock.state.data">
                            <div class="fs-5 fw-semibold" t-esc="clock.state.data.local_time || '–'" />
                            <div class="small text-muted" t-esc="clock.state.data.error || ''" />
                        </t>
                        <div t-else="" class="placeholder-glow"><span class="placeholder col-8" /></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">Active error signals</div>
                    <div class="card-body">
                        <p t-if="errors.state.data and !errors.state.data.active.length" class="text-success mb-0">
                            <i class="fa fa-check-circle me-1" />No active errors
                        </p>
                        <div t-foreach="errors.state.data?.active || []" t-as="error" t-key="error.word + error.bit"
                             class="d-flex justify-content-between align-items-center border rounded px-2 py-1 mb-2">
                            <span t-esc="error.text" />
                            <span class="badge text-bg-light font-monospace"><t t-esc="error.word" />.<t t-esc="error.bit" /></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">Error memory</div>
                    <div class="card-body">
                        <t t-if="memory.state.data">
                            <div class="row text-center g-2 mb-2">
                                <div class="col"><div class="border rounded p-2"><div class="fs-4 fw-semibold text-danger" t-esc="memory.state.data.active_count" /><div class="small text-muted">pending</div></div></div>
                                <div class="col"><div class="border rounded p-2"><div class="fs-4 fw-semibold" t-esc="memory.state.data.history_count" /><div class="small text-muted">in the history</div></div></div>
                                <div class="col"><div class="border rounded p-2"><div class="fs-4 fw-semibold" t-esc="memory.state.data.status_total" /><div class="small text-muted">status records</div></div></div>
                            </div>
                            <div class="small text-muted">Read <t t-esc="ago(memory.state.data.read_at)" /></div>
                        </t>
                        <div t-else="" class="placeholder-glow"><span class="placeholder col-8" /></div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="int_regler.Values">
        <div>
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
                <ul class="nav nav-pills">
                    <li class="nav-item">
                        <a href="#" t-attf-class="nav-link py-1 #{state.page === 'all' ? 'active' : ''}" t-on-click.prevent="() => this.selectPage('all')">All</a>
                    </li>
                    <li class="nav-item" t-foreach="pages.state.data?.pages || []" t-as="page" t-key="page.page">
                        <a href="#" t-attf-class="nav-link py-1 #{state.page === page.page ? 'active' : ''}"
                           t-on-click.prevent="() => this.selectPage(page.page)">
                            <t t-if="page.page === 0">Auxiliary page</t>
                            <t t-else="">Page <t t-esc="page.page" /></t>
                        </a>
                    </li>
                </ul>
                <input type="search" class="form-control w-auto" placeholder="Search by name or code" t-model="state.query" />
            </div>
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Code</th>
                                <th>Name</th>
                                <th class="text-end">Value</th>
                                <th>Unit</th>
                                <th>State</th>
                                <th class="text-end pe-3">Read</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="rows" t-as="entry" t-key="entry.id">
                                <td class="ps-3 font-monospace small text-muted" t-esc="entry.code" />
                                <td class="fw-medium" t-esc="entry.name" />
                                <td class="text-end font-monospace" t-esc="entry.text || '–'" />
                                <td class="text-muted" t-esc="entry.unit" />
                                <td>
                                    <t t-set="rowState" t-value="rowStatus(entry)" />
                                    <span t-attf-class="badge text-bg-#{rowState[1]}" t-esc="rowState[0]" />
                                </td>
                                <td class="text-end pe-3 small text-muted" t-esc="ago(entry.time)" />
                            </tr>
                            <tr t-if="values.state.data and !rows.length">
                                <td colspan="6" class="text-center text-muted py-4">No entries found.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="small text-muted mt-2">
                <t t-esc="rows.length" /> entries
                <span t-if="values.state.error" class="text-danger"> · <t t-esc="values.state.error" /></span>
            </div>
        </div>
    </t>

    <t t-name="int_regler.Errors">
        <div>
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link #{state.tab === 'active' ? 'active' : ''}" t-on-click.prevent="() => state.tab = 'active'">
                        Active<t t-if="errors.state.data"> (<t t-esc="errors.state.data.active.length" />)</t>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link #{state.tab === 'history' ? 'active' : ''}" t-on-click.prevent="() => state.tab = 'history'">
                        History<t t-if="memory.state.data"> (<t t-esc="memory.state.data.history_count" />)</t>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" t-attf-class="nav-link #{state.tab === 'words' ? 'active' : ''}" t-on-click.prevent="() => state.tab = 'words'">
                        Error words<t t-if="errors.state.data"> (<t t-esc="errors.state.data.words.length" />)</t>
                    </a>
                </li>
            </ul>

            <div t-if="state.tab === 'active'" class="card">
                <div class="card-body">
                    <p t-if="errors.state.data and !errors.state.data.active.length" class="text-success mb-0">
                        <i class="fa fa-check-circle me-1" />No active errors
                    </p>
                    <div t-foreach="errors.state.data?.active || []" t-as="error" t-key="error.word + error.bit"
                         class="d-flex justify-content-between align-items-center border rounded px-2 py-1 mb-2">
                        <span t-esc="error.text" />
                        <span class="badge text-bg-light font-monospace"><t t-esc="error.word" />.<t t-esc="error.bit" /></span>
                    </div>
                </div>
            </div>

            <div t-elif="state.tab === 'history'" class="card">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr><th class="ps-3">No.</th><th>Message</th><th class="text-end">Count</th><th class="pe-3">Time</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="memory.state.data?.history || []" t-as="item" t-key="item_index">
                                <td class="ps-3 font-monospace small text-muted" t-esc="item.code" />
                                <td class="fw-medium" t-esc="item.text" />
                                <td class="text-end" t-esc="item.count" />
                                <td class="pe-3 text-muted" t-esc="item.time.replace('T', ' ')" />
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div t-else="" class="row g-3">
                <div class="col-lg-6" t-foreach="errors.state.data?.words || []" t-as="word" t-key="word.name">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between">
                            <span><t t-esc="word.name" /> <span class="font-monospace small text-muted" t-esc="word.address" /></span>
                            <span class="badge text-bg-light font-monospace" t-esc="word.raw || '–'" />
                        </div>
                        <div class="card-body d-flex flex-wrap gap-1">
                            <span t-foreach="word.bits" t-as="bit" t-key="bit.bit"
                                  t-attf-class="badge #{bit.active ? 'text-bg-danger' : 'text-bg-light text-muted'}" t-esc="bit.text" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="int_regler.Clamps">
        <div>
            <div t-if="clamps.state.data and !enabled" class="alert alert-info">
                <strong>Clamps are not released.</strong> The service was started without a clamp release
                (<code>-klemmen-schreiben</code> or <code>-klemmen-original</code>); the page only shows what would be possible.
            </div>
            <div t-elif="enabled and !canClamp" class="alert alert-info d-flex justify-content-between align-items-center">
                <span>
                    <strong>Sign-in needed.</strong> To clamp, sign in at the controller service with a user who has the role
                    <code>clamp</code>. Without a sign-in the values are only shown.
                </span>
                <button class="btn btn-sm btn-primary" t-on-click="() => props.login()">Sign in</button>
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
                <input type="search" class="form-control w-auto" placeholder="Search by name or code" t-model="state.query" />
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted"><t t-esc="clampedCount" /> clamps active</span>
                    <button class="btn btn-sm btn-outline-secondary" t-att-disabled="!allowed or !clampedCount" t-on-click="releaseAll">
                        <i class="fa fa-unlink me-1" />Release all
                    </button>
                </div>
            </div>

            <div class="card">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Code</th>
                                <th>Name</th>
                                <th class="text-end">Value</th>
                                <th>State</th>
                                <th class="text-end pe-3">Clamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="rows" t-as="row" t-key="row.code" t-att-class="isClamped(row) ? 'table-primary' : ''">
                                <td class="ps-3 font-monospace small text-muted" t-esc="row.code" />
                                <td class="fw-medium">
                                    <t t-esc="row.name" />
                                    <span t-if="row.analog and row.min !== null and row.max !== null" class="small fw-normal text-muted ms-2">
                                        <t t-esc="row.min" />…<t t-esc="row.max" /><t t-if="row.state?.unit"> <t t-esc="row.state.unit" /></t>
                                    </span>
                                </td>
                                <td class="text-end font-monospace" t-esc="row.state?.text || '–'" />
                                <td>
                                    <span t-if="row.dirty or row.last?.error" class="badge text-bg-danger">state unclear</span>
                                    <span t-elif="isClamped(row)" class="badge text-bg-primary">clamped</span>
                                    <span t-else="" class="badge text-bg-light text-muted">released</span>
                                </td>
                                <td class="pe-3">
                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                        <i t-if="state.busy[row.code]" class="fa fa-spinner fa-spin text-muted" title="The controller is working" />
                                        <t t-if="row.analog">
                                            <input type="number" class="form-control form-control-sm font-monospace" style="width: 6rem"
                                                   t-att-value="valueOf(row)" t-att-min="row.min" t-att-max="row.max" t-att-step="row.step || 1"
                                                   t-att-disabled="!allowed or state.busy[row.code]" t-on-input="(ev) => this.setValue(row, ev)" />
                                            <button class="btn btn-sm btn-outline-primary"
                                                    t-att-disabled="!allowed or state.busy[row.code] or !validValue(row)"
                                                    t-on-click="() => this.run(row, 'set', this.clampValue(row))">
                                                <i class="fa fa-plug me-1" />Clamp
                                            </button>
                                        </t>
                                        <t t-else="">
                                            <button class="btn btn-sm btn-outline-primary" t-att-disabled="!allowed or state.busy[row.code]"
                                                    t-on-click="() => this.run(row, 'set', 0)">To 0</button>
                                            <button class="btn btn-sm btn-outline-primary" t-att-disabled="!allowed or state.busy[row.code]"
                                                    t-on-click="() => this.run(row, 'set', 1)">To 1</button>
                                        </t>
                                        <button class="btn btn-sm btn-link" t-att-disabled="!allowed or state.busy[row.code] or !isClamped(row)"
                                                t-on-click="() => this.run(row, 'release')">
                                            <i class="fa fa-unlink me-1" />Release
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr t-if="clamps.state.data and !rows.length">
                                <td colspan="5" class="text-center text-muted py-4">No clamp rows released.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>

</templates>
