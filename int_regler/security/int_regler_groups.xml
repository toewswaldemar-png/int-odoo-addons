<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_int_regler" model="ir.module.category">
        <field name="name">Controller</field>
    </record>

    <record id="privilege_int_regler" model="res.groups.privilege">
        <field name="name">Controller</field>
        <field name="category_id" ref="module_category_int_regler"/>
    </record>

    <record id="group_regler_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_int_regler"/>
        <field name="comment">Opens the controller page and reads the controllers. What a user may do at a controller is decided by the controller service, after a sign-in there.</field>
    </record>

    <record id="group_regler_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_int_regler"/>
        <field name="implied_ids" eval="[(4, ref('group_regler_user'))]"/>
        <field name="comment">Creates and edits the controllers (the address of the service).</field>
    </record>
</odoo>
