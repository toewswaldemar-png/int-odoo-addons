<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.ListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <!-- useSortable (list_column_reorder.js) drives the whole drag sequence itself via
             pointer events, queried live off this class - no t-on-drag*/drop handlers needed
             here at all anymore. data-name already exists natively on this <th>
             (t-att-data-name="column.name" a few lines up in Odoo's own template), reused
             as-is instead of adding a duplicate attribute. -->
        <xpath expr="//th[@t-if=&quot;column.type === 'field'&quot;]" position="attributes">
            <attribute name="t-att-class">getColumnClass(column) + ' opacity-trigger-hover w-print-auto o_int_web_tweaks_column_draggable'</attribute>
        </xpath>
    </t>

</templates>
