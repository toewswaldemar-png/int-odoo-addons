<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_document_rule_company" model="ir.rule">
        <field name="name">Filemanager document: multi-company</field>
        <field name="model_id" ref="model_int_filemanager_document" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="int_filemanager_document_rule_reader" model="ir.rule">
        <field name="name">Filemanager document: open or allowed</field>
        <field name="model_id" ref="model_int_filemanager_document" />
        <field name="domain_force">[
            '|', '|',
            ('folder_id.access_folder_id.access_mode', '=', 'open'),
            ('folder_id.access_folder_id.access_user_ids', 'in', [user.id]),
            ('folder_id.access_folder_id.access_group_ids', 'in', user.all_group_ids.ids),
        ]</field>
        <field name="groups" eval="[(4, ref('int_filemanager_group_reader'))]" />
    </record>

    <record id="int_filemanager_document_rule_admin" model="ir.rule">
        <field name="name">Filemanager document: administrators see all</field>
        <field name="model_id" ref="model_int_filemanager_document" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('int_filemanager_group_admin'))]" />
    </record>
</odoo>
