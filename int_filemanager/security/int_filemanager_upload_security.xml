<odoo>
  <!-- Upload rows are working state of a single write attempt, never a shared
         business record - "own records only" is the whole rule (Konzept 12). -->
  <record id="rule_upload_own_records" model="ir.rule">
    <field name="name">Filemanager v2: upload own records only</field>
    <field name="model_id" ref="model_int_filemanager_upload" />
    <field name="domain_force">[('create_uid', '=', user.id)]</field>
    <field name="perm_read">True</field>
    <field name="perm_write">True</field>
    <field name="perm_create">True</field>
    <field name="perm_unlink">True</field>
  </record>
</odoo>
