<odoo>
  <!-- Uploads are the working state of one user's request: own records only. Users
         can only read them; the model methods write them, since temp_file is a path
         on the server. -->
  <record id="rule_upload_own_records" model="ir.rule">
    <field name="name">Filemanager v2: upload own records only</field>
    <field name="model_id" ref="model_int_filemanager_upload" />
    <field name="domain_force">[('create_uid', '=', user.id)]</field>
    <field name="perm_read">True</field>
    <field name="perm_write">False</field>
    <field name="perm_create">False</field>
    <field name="perm_unlink">False</field>
  </record>
</odoo>
