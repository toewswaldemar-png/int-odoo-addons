<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_link_rule_company" model="ir.rule">
        <field name="name">Filemanager link: multi-company</field>
        <field name="model_id" ref="model_int_filemanager_link" />
        <field
            name="domain_force"
        >['|', ('document_id.company_id', '=', False), ('document_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="int_filemanager_link_rule_user" model="ir.rule">
        <field name="name">Filemanager link: of a document the folders show</field>
        <field name="model_id" ref="model_int_filemanager_link" />
        <field name="domain_force">[
            '|', '|', '|',
            ('document_id.folder_id.access_folder_id.access_mode', '=', 'open'),
            ('document_id.folder_id.access_folder_id.access_user_ids', 'in', [user.id]),
            ('document_id.folder_id.access_folder_id.access_group_ids', 'in', user.all_group_ids.ids),
            ('document_id.folder_id.access_folder_id.message_partner_ids', 'in', [user.partner_id.id]),
        ]</field>
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="groups" eval="[(4, ref('int_filemanager_group_user'))]" />
    </record>

    <data noupdate="1">
        <record id="int_filemanager_link_rule_record" model="ir.rule">
            <field name="name">Filemanager link: of a document seen through a record</field>
            <field name="model_id" ref="model_int_filemanager_link" />
            <field name="active" eval="False" />
            <field name="domain_force">[('document_id.access_via_record', '=', True)]</field>
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
        </record>
    </data>

    <record id="int_filemanager_link_rule_admin" model="ir.rule">
        <field name="name">Filemanager link: administrators see all</field>
        <field name="model_id" ref="model_int_filemanager_link" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('int_filemanager_group_admin'))]" />
    </record>
</odoo>
