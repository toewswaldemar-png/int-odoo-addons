<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- A link is seen like its document (``any`` applies the rules of the document). Untying and
         tying are checked in the model: the folder must show the document, the record must be
         writable. -->
    <record id="int_filemanager_link_rule_user" model="ir.rule">
        <field name="name">Filemanager link: of a document the user sees</field>
        <field name="model_id" ref="model_int_filemanager_link" />
        <field name="domain_force">[('document_id', 'any', [])]</field>
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
</odoo>
