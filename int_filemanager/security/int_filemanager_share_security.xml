<odoo>
    <!-- Whoever may write a file (scope write groups) sees its links; nobody writes a
         link row directly, links are made and revoked by int_filemanager.share methods
         (sudo after the rights check) - see the model docstring. -->
    <record id="rule_share_node_writers" model="ir.rule">
        <field
            name="name"
        >Filemanager v2: share links visible to writers of the file</field>
        <field name="model_id" ref="model_int_filemanager_share" />
        <field
            name="domain_force"
        >[('node_id.scope_id.write_group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="perm_read">True</field>
        <field name="perm_write">False</field>
        <field name="perm_create">False</field>
        <field name="perm_unlink">False</field>
    </record>
</odoo>
