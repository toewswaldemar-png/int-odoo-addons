<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- A line follows the company of its order (a join, not a stored field: there are very many
         lines). -->
    <record id="int_filemanager_import_line_rule_company" model="ir.rule">
        <field name="name">Filemanager import line: multi-company</field>
        <field name="model_id" ref="model_int_filemanager_import_line" />
        <field name="domain_force">[('import_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
