<odoo>
  <!-- Record rules apply per model; a related model's rules are not inherited, so
         node, revision and scope each have their own. These are global rules (no
         groups), which Odoo ANDs together: each sets exactly one perm_* flag, so two
         of them never apply to the same operation. -->
  <record id="rule_node_scope_read" model="ir.rule">
    <field name="name">Filemanager v2: node visible in its scope</field>
    <field name="model_id" ref="model_int_filemanager_node" />
    <field
      name="domain_force"
    >[('scope_id.read_group_ids', 'in', user.all_group_ids.ids)]</field>
    <field name="perm_read">True</field>
    <field name="perm_write">False</field>
    <field name="perm_create">False</field>
    <field name="perm_unlink">False</field>
  </record>

  <!-- Users have no create right on nodes: the model methods create them after
         checking the write right on the folder. -->
  <record id="rule_node_scope_write" model="ir.rule">
    <field name="name">Filemanager v2: node write in its scope</field>
    <field name="model_id" ref="model_int_filemanager_node" />
    <field
      name="domain_force"
    >[('scope_id.write_group_ids', 'in', user.all_group_ids.ids)]</field>
    <field name="perm_read">False</field>
    <field name="perm_write">True</field>
    <field name="perm_create">False</field>
    <field name="perm_unlink">False</field>
  </record>

  <!-- Permanent delete is unlink() and needs the purge right; moving to the trash is
         a write() and falls under the write rule above. -->
  <record id="rule_node_scope_purge" model="ir.rule">
    <field name="name">Filemanager v2: node permanent delete in its scope</field>
    <field name="model_id" ref="model_int_filemanager_node" />
    <field
      name="domain_force"
    >[('scope_id.purge_group_ids', 'in', user.all_group_ids.ids)]</field>
    <field name="perm_read">False</field>
    <field name="perm_write">False</field>
    <field name="perm_create">False</field>
    <field name="perm_unlink">True</field>
  </record>
</odoo>
