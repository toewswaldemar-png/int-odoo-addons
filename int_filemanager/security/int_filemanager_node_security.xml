<odoo>
  <!-- Konzept 12 access table / Pruefbericht A1: ir.rule is evaluated per model, not
         inherited from a related model (base/models/ir_rule.py _compute_domain only
         follows _inherits) - node, revision and scope each need their own rules here.
         No groups field on any of these -> Odoo treats them as global rules, ANDed
         with each other rather than ORed (A10); each rule below only ever sets ONE
         perm_* bit to True, so they never fight each other on the same operation. -->
  <record id="rule_node_scope_read" model="ir.rule">
    <field name="name">Filemanager v2: node visible in its scope</field>
    <field name="model_id" ref="model_int_filemanager_node" />
    <field
      name="domain_force"
    >[('scope_id.read_group_ids', 'in', user.all_group_ids.ids)]</field>
    <field name="perm_read">True</field>
    <field name="perm_write">False</field>
    <field name="perm_create">False</field>
    <field name="perm_unlink">False</field>
  </record>

  <record id="rule_node_scope_write" model="ir.rule">
    <field name="name">Filemanager v2: node write/create in its scope</field>
    <field name="model_id" ref="model_int_filemanager_node" />
    <field
      name="domain_force"
    >[('scope_id.write_group_ids', 'in', user.all_group_ids.ids)]</field>
    <field name="perm_read">False</field>
    <field name="perm_write">True</field>
    <field name="perm_create">True</field>
    <field name="perm_unlink">False</field>
  </record>

  <!-- Permanent delete (Konzept 6 "Endgueltig loeschen") is unlink(); the regular
         trash ("Loeschen") is a write() of active/removal_reason and stays under the
         write rule above - purge_group_ids exists on scope specifically for this. -->
  <record id="rule_node_scope_purge" model="ir.rule">
    <field name="name">Filemanager v2: node permanent delete in its scope</field>
    <field name="model_id" ref="model_int_filemanager_node" />
    <field
      name="domain_force"
    >[('scope_id.purge_group_ids', 'in', user.all_group_ids.ids)]</field>
    <field name="perm_read">False</field>
    <field name="perm_write">False</field>
    <field name="perm_create">False</field>
    <field name="perm_unlink">True</field>
  </record>
</odoo>
