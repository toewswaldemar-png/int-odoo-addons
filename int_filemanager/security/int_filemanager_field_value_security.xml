<odoo>
  <!-- Nobody writes values through the ORM (read-only access in ir.model.access.csv);
         the node's methods check the write right on the node and then write them. So
         the rule only covers reading, and follows the node's scope like a revision. -->
  <record id="rule_field_value_scope_read" model="ir.rule">
    <field name="name">Filemanager v2: field value visible in its node's scope</field>
    <field name="model_id" ref="model_int_filemanager_field_value" />
    <field
      name="domain_force"
    >[('node_id.scope_id.read_group_ids', 'in', user.all_group_ids.ids)]</field>
    <field name="perm_read">True</field>
    <field name="perm_write">False</field>
    <field name="perm_create">False</field>
    <field name="perm_unlink">False</field>
  </record>
</odoo>
