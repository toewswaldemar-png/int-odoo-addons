<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_int_filemanager" model="ir.module.category">
        <field name="name">Filemanager</field>
    </record>

    <record id="privilege_int_filemanager" model="res.groups.privilege">
        <field name="name">Filemanager</field>
        <field name="category_id" ref="module_category_int_filemanager" />
    </record>

    <record id="int_filemanager_group_reader" model="res.groups">
        <field name="name">Filemanager Reader</field>
        <field name="comment">Reader: Can read the folders and documents they see.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_int_filemanager" />
    </record>

    <record id="int_filemanager_group_user" model="res.groups">
        <field name="name">Filemanager User</field>
        <field
            name="comment"
        >User: Can also upload, change and delete in the folders they see.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_int_filemanager" />
        <field name="implied_ids" eval="[(4, ref('int_filemanager_group_reader'))]" />
    </record>

    <record id="int_filemanager_group_admin" model="res.groups">
        <field name="name">Filemanager Administrator</field>
        <field
            name="comment"
        >Administrator: Can see all folders, decide who sees them and configure the filemanager.</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_int_filemanager" />
        <field name="implied_ids" eval="[(4, ref('int_filemanager_group_user'))]" />
        <!-- The administrator of the database is the one of the filemanager, like in the core
             (project, hr_holidays): else nobody sees the menu after the installation. -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>
</odoo>
