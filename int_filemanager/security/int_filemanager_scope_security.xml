<odoo>
  <!-- Every internal user may read every scope; changing one needs the manage right. -->
  <record id="rule_scope_manage_write" model="ir.rule">
    <field name="name">Filemanager v2: scope change needs manage right</field>
    <field name="model_id" ref="model_int_filemanager_scope" />
    <field
      name="domain_force"
    >[('manage_group_ids', 'in', user.all_group_ids.ids)]</field>
    <field name="perm_read">False</field>
    <field name="perm_write">True</field>
    <field name="perm_create">True</field>
    <field name="perm_unlink">True</field>
  </record>
</odoo>
