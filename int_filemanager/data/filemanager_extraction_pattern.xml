<odoo>
    <!-- Startbelegung, entspricht 1:1 den bisher in fulltext.py hartkodierten Regex-Konstanten
         (_DATE_RE/_INVOICE_NO_RE/_AMOUNT_RE) - danach ueber "Dateimanager > Konfiguration >
         Erkennungsmuster" frei erweiter-/aenderbar, keines dieser drei ist im Code fest
         verdrahtet (siehe fulltext.py, suggest_from_text()). Bewusst ohne noupdate="1", analog
         zu filemanager_status.xml (dort ebenfalls keins gesetzt) - selbes Verhalten wie die
         Status-Werte: ein Modul-Update schreibt Name/Pattern dieser drei Startdatensaetze auf
         die hier hinterlegten Werte zurueck, spaeter angelegte zusaetzliche Muster sind davon
         nicht betroffen. -->
    <record id="filemanager_extraction_pattern_date" model="int_filemanager.extraction_pattern">
        <field name="name">Datum (TT.MM.JJJJ)</field>
        <field name="target_field">date</field>
        <field name="pattern">\b(\d{1,2})[.\/](\d{1,2})[.\/](\d{2,4})\b</field>
        <field name="group_index">0</field>
        <field name="sequence">10</field>
    </record>
    <record id="filemanager_extraction_pattern_invoice_number" model="int_filemanager.extraction_pattern">
        <field name="name">Rechnungsnummer (DE/EN)</field>
        <field name="target_field">invoice_number</field>
        <field name="pattern">(?:Rechnung(?:s-?nr\.?|snummer)|Invoice\s*No\.?|Beleg-?Nr\.?)\s*[:.]?\s*([A-Za-z0-9\-/]+)</field>
        <field name="ignore_case">1</field>
        <field name="group_index">1</field>
        <field name="sequence">10</field>
    </record>
    <record id="filemanager_extraction_pattern_amount" model="int_filemanager.extraction_pattern">
        <field name="name">Betrag (EUR)</field>
        <field name="target_field">amount</field>
        <field name="pattern">(\d{1,3}(?:\.\d{3})*,\d{2})\s*(?:€|EUR)</field>
        <field name="group_index">1</field>
        <field name="sequence">10</field>
    </record>
</odoo>
