<odoo noupdate="1">
    <!-- noupdate="1" (house convention, N6): otherwise a plain module update
         re-enables a cron a user deliberately turned off. -->
    <record id="ir_cron_int_filemanager_finish_pending_uploads" model="ir.cron">
        <field name="name">Filemanager v2: finish large uploads</field>
        <field name="model_id" ref="model_int_filemanager_upload" />
        <field name="state">code</field>
        <field name="code">model._cron_finish_pending()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field
            name="nextcall"
            eval="(datetime.now() + relativedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')"
        />
        <field name="active">True</field>
    </record>

    <record id="ir_cron_int_filemanager_expire_orphaned_uploads" model="ir.cron">
        <field name="name">Filemanager v2: clean up orphaned uploads</field>
        <field name="model_id" ref="model_int_filemanager_upload" />
        <field name="state">code</field>
        <field name="code">model._cron_expire_orphaned_uploads()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field
            name="nextcall"
            eval="(datetime.now() + relativedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"
        />
        <field name="active">True</field>
    </record>
</odoo>
