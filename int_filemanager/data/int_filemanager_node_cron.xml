<odoo noupdate="1">
  <record id="ir_cron_int_filemanager_purge_trash" model="ir.cron">
    <field
      name="name"
    >Filemanager v2: purge the trash after 30 days (Konzept 17.4)</field>
    <field name="model_id" ref="model_int_filemanager_node" />
    <field name="state">code</field>
    <field name="code">model._cron_purge_trash()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field
      name="nextcall"
      eval="(datetime.now() + relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"
    />
    <field name="active">True</field>
  </record>
</odoo>
