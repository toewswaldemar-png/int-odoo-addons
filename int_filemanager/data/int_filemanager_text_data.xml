<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- One file per run; the high priority number puts it after the other actions. -->
    <record id="int_filemanager_text_cron" model="ir.cron">
        <field name="name">Filemanager: read the text of the files</field>
        <field name="model_id" ref="model_int_filemanager_text" />
        <field name="state">code</field>
        <field name="code">model._cron_ocr()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="priority">90</field>
    </record>
</odoo>
