<odoo>
    <record id="ir_cron_scan_filemanager" model="ir.cron">
        <field name="name">Filemanager: Index mit Dateisystem abgleichen (Sicherheitsnetz)</field>
        <field name="model_id" ref="model_int_filemanager_file"/>
        <field name="state">code</field>
        <field name="code">model._cron_scan_filemanager()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(datetime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_publish_pending" model="ir.cron">
        <field name="name">Filemanager: vorgemerkte Änderungen auf den Share veröffentlichen (Recovery)</field>
        <field name="model_id" ref="model_int_filemanager_file"/>
        <field name="state">code</field>
        <field name="code">model._cron_publish_pending()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="(datetime.now() + relativedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_compute_hashes" model="ir.cron">
        <field name="name">Filemanager: Datei-Hashes berechnen (Identitäts-Grundlage)</field>
        <field name="model_id" ref="model_int_filemanager_file"/>
        <field name="state">code</field>
        <field name="code">model._cron_compute_hashes()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="(datetime.now() + relativedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_extract_media_meta" model="ir.cron">
        <field name="name">Filemanager: Vorschau &amp; Metadaten extrahieren (Bild/PDF/Audio)</field>
        <field name="model_id" ref="model_int_filemanager_file"/>
        <field name="state">code</field>
        <field name="code">model._cron_extract_media_meta()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="(datetime.now() + relativedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_extract_fulltext" model="ir.cron">
        <field name="name">Filemanager: Volltext extrahieren (OCR/Text, Baustein 1)</field>
        <field name="model_id" ref="model_int_filemanager_file"/>
        <field name="state">code</field>
        <field name="code">model._cron_extract_fulltext()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="(datetime.now() + relativedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_prune_scan_log" model="ir.cron">
        <field name="name">Filemanager: Alte Scan-Log-Einträge aufräumen</field>
        <field name="model_id" ref="model_int_filemanager_scan_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_prune_old_entries()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(datetime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 04:00:00')"/>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_prune_versions" model="ir.cron">
        <field name="name">Filemanager: Alte Versionen aufräumen (Default: unbegrenzt)</field>
        <field name="model_id" ref="model_int_filemanager_version"/>
        <field name="state">code</field>
        <field name="code">model._cron_prune_old_versions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(datetime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 04:30:00')"/>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_recover_stuck_journal" model="ir.cron">
        <field name="name">Filemanager: Hängengebliebene Schreibvorgänge erkennen</field>
        <field name="model_id" ref="model_int_filemanager_write_journal"/>
        <field name="state">code</field>
        <field name="code">model._cron_recover_stuck_entries()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="(datetime.now() + relativedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_purge_trash" model="ir.cron">
        <field name="name">Filemanager: Papierkorb-Einträge endgültig löschen (Aufbewahrungsfrist)</field>
        <field name="model_id" ref="model_int_filemanager_file"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_trash()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(datetime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 04:45:00')"/>
        <field name="active">True</field>
    </record>
</odoo>
