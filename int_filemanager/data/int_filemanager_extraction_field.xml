<odoo noupdate="1">
  <!-- Starting set from the keyword catalogue tested on real documents. noupdate: the
         synonyms are meant to grow with every new sender, and an update must not throw
         that work away. -->
  <record id="extraction_field_invoice_number" model="int_filemanager.extraction_field">
    <field name="name">Invoice number</field>
    <field name="sequence">10</field>
    <field name="value_type">number</field>
  </record>
  <record id="extraction_rule_invoice_number" model="int_filemanager.extraction_rule">
    <field name="field_id" ref="extraction_field_invoice_number" />
    <field name="mode">keyword</field>
    <field name="keywords">Rechnungsnummer
Rechnungsnr.
Rechnungs-Nr.
Belegnummer
Beleg-Nr.</field>
  </record>
  <record
    id="extraction_field_customer_number"
    model="int_filemanager.extraction_field"
  >
    <field name="name">Customer number</field>
    <field name="sequence">20</field>
    <field name="value_type">number</field>
  </record>
  <record id="extraction_rule_customer_number" model="int_filemanager.extraction_rule">
    <field name="field_id" ref="extraction_field_customer_number" />
    <field name="mode">keyword</field>
    <field name="keywords">Kundennummer
Geschäftspartnernummer
Kunden-Nr.
Kundennr.
Kund*innennummer
Kd.-Nr.</field>
  </record>
  <record
    id="extraction_field_contract_number"
    model="int_filemanager.extraction_field"
