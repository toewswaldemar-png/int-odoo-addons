    <field name="mode">keyword</field>
    <field name="keywords">Gesamtbetrag
Rechnungsbetrag
Einzugsbetrag
zu zahlender Betrag
Endbetrag</field>
  </record>
  <record id="extraction_field_due_date" model="int_filemanager.extraction_field">
    <field name="name">Due date</field>
    <field name="sequence">60</field>
    <field name="value_type">date</field>
  </record>
  <record id="extraction_rule_due_date" model="int_filemanager.extraction_rule">
    <field name="field_id" ref="extraction_field_due_date" />
    <field name="mode">keyword</field>
    <field name="keywords">fällig am
