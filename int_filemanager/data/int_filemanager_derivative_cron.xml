<odoo noupdate="1">
    <record id="ir_cron_int_filemanager_derivatives" model="ir.cron">
        <field name="name">Filemanager v2: create thumbnails and previews</field>
        <field name="model_id" ref="model_int_filemanager_derivative" />
        <field name="state">code</field>
        <field name="code">model._cron_run()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field
            name="nextcall"
            eval="(datetime.now() + relativedelta(minutes=1)).strftime('%Y-%m-%d %H:%M:%S')"
        />
        <field name="active">True</field>
    </record>
</odoo>
