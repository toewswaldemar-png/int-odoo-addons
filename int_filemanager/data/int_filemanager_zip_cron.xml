<odoo noupdate="1">
  <record id="ir_cron_int_filemanager_build_zips" model="ir.cron">
    <field name="name">Filemanager v2: build big ZIP downloads</field>
    <field name="model_id" ref="model_int_filemanager_zip_job" />
    <field name="state">code</field>
    <field name="code">model._cron_build_zips()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
    <field
      name="nextcall"
      eval="(datetime.now() + relativedelta(minutes=1)).strftime('%Y-%m-%d %H:%M:%S')"
    />
    <field name="active">True</field>
  </record>

  <record id="ir_cron_int_filemanager_expire_zips" model="ir.cron">
    <field name="name">Filemanager v2: remove old ZIP downloads</field>
    <field name="model_id" ref="model_int_filemanager_zip_job" />
    <field name="state">code</field>
    <field name="code">model._cron_expire_zips()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field
      name="nextcall"
      eval="(datetime.now() + relativedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"
    />
    <field name="active">True</field>
  </record>
</odoo>
