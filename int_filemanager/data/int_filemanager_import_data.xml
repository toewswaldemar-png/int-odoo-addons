<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Checks and reads in the orders that were started. "Check" and "Read in" wake it at once;
         the interval only picks up what a restart of the server interrupted. -->
    <record id="int_filemanager_import_cron" model="ir.cron">
        <field name="name">Filemanager: read in the files</field>
        <field name="model_id" ref="model_int_filemanager_import" />
        <field name="state">code</field>
        <field name="code">model._cron_run()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
