#. module: int_filemanager
#: model:ir.model.constraint,message:int_filemanager.constraint_int_filemanager_blob_sha256_uniq
msgid "A blob with this hash already exists."
msgstr "Ein Blob mit diesem Hash existiert bereits."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_node.py:0
msgid "A file or folder named %(name)s already exists here."
msgstr "Eine Datei oder ein Ordner namens %(name)s existiert hier bereits."

#. module: int_filemanager
#: model:ir.model.constraint,message:int_filemanager.constraint_int_filemanager_node_unique_name_per_parent
msgid "A file or folder with this name already exists here."
msgstr "Eine Datei oder ein Ordner mit diesem Namen existiert hier bereits."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_node.py:0
msgid "A folder cannot be copied into itself."
msgstr "Ein Ordner kann nicht in sich selbst kopiert werden."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_node.py:0
msgid "A folder cannot be moved into itself."
msgstr "Ein Ordner kann nicht in sich selbst verschoben werden."

#. module: int_filemanager
#: model:ir.model.constraint,message:int_filemanager.constraint_int_filemanager_revision_revision_no_uniq
msgid "A node cannot have two revisions with the same number."
msgstr "Ein Knoten kann nicht zwei Revisionen mit derselben Nummer haben."

#. module: int_filemanager
#: model:ir.model.constraint,message:int_filemanager.constraint_int_filemanager_scope_name_uniq
msgid "A scope with this name already exists."
msgstr "Ein Bereich mit diesem Namen existiert bereits."

#. module: int_filemanager
#: model:ir.model,name:int_filemanager.model_int_filemanager_blob
msgid "Filemanager v2 blob (content, by hash)"
msgstr "Dateimanager v2 Blob (Inhalt, nach Hash)"

#. module: int_filemanager
#: model:ir.model,name:int_filemanager.model_int_filemanager_upload
msgid "Filemanager v2 chunked upload in progress"
msgstr "Dateimanager v2 laufender Stück-Upload"

#. module: int_filemanager
#: model:ir.model,name:int_filemanager.model_int_filemanager_node
msgid "Filemanager v2 node (folder or file)"
msgstr "Dateimanager v2 Knoten (Ordner oder Datei)"

#. module: int_filemanager
#: model:ir.model,name:int_filemanager.model_int_filemanager_revision
msgid "Filemanager v2 revision"
msgstr "Dateimanager v2 Revision"

#. module: int_filemanager
#: model:ir.model,name:int_filemanager.model_int_filemanager_scope
msgid "Filemanager v2 rights scope"
msgstr "Dateimanager v2 Rechte-Bereich"

#. module: int_filemanager
#: model:ir.model,name:int_filemanager.model_int_filemanager_share
msgid "Filemanager v2 share link"
msgstr "Dateimanager v2 Freigabe-Link"

#. module: int_filemanager
#: model:ir.model,name:int_filemanager.model_int_filemanager_operation
msgid "Filemanager v2 write operation (idempotency key)"
msgstr "Dateimanager v2 Schreibvorgang (Idempotenzschlüssel)"

#. module: int_filemanager
#: model:ir.model,name:int_filemanager.model_int_filemanager_zip_job
msgid "Filemanager v2 ZIP download job"
msgstr "Dateimanager v2 ZIP-Download-Auftrag"

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_zip_job.py:0
msgid "Internal error."
msgstr "Interner Fehler."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/zip_stream.py:0
msgid "Nothing to download."
msgstr "Nichts zum Herunterladen."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_share.py:0
msgid "Only single files with content can be shared by link."
msgstr "Nur einzelne Dateien mit Inhalt können per Link freigegeben werden."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_node.py:0
msgid "Restoring would collide with an existing file or folder of the same name."
msgstr "Das Wiederherstellen würde mit einer bestehenden Datei oder einem Ordner gleichen Namens kollidieren."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_upload.py:0
msgid "Specify either a target folder and name for a new file, or an existing file to revise - not both."
msgstr "Bitte entweder einen Zielordner und Namen für eine neue Datei angeben oder eine bestehende Datei zum Überarbeiten - nicht beides."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_node.py:0
msgid "The target folder is in the trash; restore it first."
msgstr "Der Zielordner liegt im Papierkorb; bitte zuerst wiederherstellen."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_node.py:0
msgid "The target is not a folder."
msgstr "Das Ziel ist kein Ordner."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_upload.py:0
msgid "This chunk does not continue where the upload left off."
msgstr "Dieses Stück setzt nicht dort an, wo der Upload aufgehört hat."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_zip_job.py:0
msgid "This download does not exist any more."
msgstr "Dieser Download existiert nicht mehr."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_node.py:0
msgid "This file changed since you loaded it; reload and try again."
msgstr "Diese Datei hat sich seit dem Laden geändert; bitte neu laden und erneut versuchen."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_node.py:0
msgid "This file has no content yet; nothing to copy."
msgstr "Diese Datei hat noch keinen Inhalt; nichts zu kopieren."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_node.py:0
msgid "This is not a valid file or folder name."
msgstr "Das ist kein gültiger Datei- oder Ordnername."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_node.py:0
msgid "This item is in the trash; restore it before moving it."
msgstr "Dieses Element liegt im Papierkorb; bitte vor dem Verschieben wiederherstellen."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_share.py:0
msgid "This link does not exist any more."
msgstr "Dieser Link existiert nicht mehr."

#. module: int_filemanager
#: model:ir.model.constraint,message:int_filemanager.constraint_int_filemanager_upload_operation_id_uniq
msgid "This operation already has an upload in progress."
msgstr "Für diesen Vorgang läuft bereits ein Upload."

#. module: int_filemanager
#: model:ir.model.constraint,message:int_filemanager.constraint_int_filemanager_operation_key_uniq
msgid "This operation key was already used."
msgstr "Dieser Vorgangsschlüssel wurde bereits verwendet."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_node.py:0
msgid "This revision does not belong to this file."
msgstr "Diese Revision gehört nicht zu dieser Datei."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_upload.py:0
msgid "This upload does not exist any more."
msgstr "Dieser Upload existiert nicht mehr."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_upload.py:0
msgid "This upload has not received any data yet."
msgstr "Für diesen Upload wurden noch keine Daten empfangen."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_upload.py:0
msgid "This upload is already being processed; it cannot be cancelled."
msgstr "Dieser Upload wird bereits verarbeitet und kann nicht mehr abgebrochen werden."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_upload.py:0
msgid "This upload is not open."
msgstr "Dieser Upload ist nicht offen."

#. module: int_filemanager
#. odoo-python
#: code:addons/int_filemanager/models/int_filemanager_upload.py:0
msgid "This upload is not open for more chunks."
msgstr "Dieser Upload ist nicht offen für weitere Stücke."
