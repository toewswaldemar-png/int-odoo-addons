<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="int_filemanager.GuestApp">
        <div class="o_guest_app d-flex flex-column vh-100">
            <nav class="d-flex align-items-center gap-2 px-3 py-2 border-bottom bg-view">
                <span class="fw-bold text-truncate" t-out="folderName" />
                <div t-if="canRead" class="btn-group ms-auto">
                    <button
                        class="btn btn-secondary o_guest_switch_kanban"
                        t-att-class="{ active: state.type === 'kanban' }"
                        t-on-click="() => this.setType('kanban')"
                    >
                        <i class="fa fa-th-large" /> Kanban
                    </button>
                    <button
                        class="btn btn-secondary o_guest_switch_list"
                        t-att-class="{ active: state.type === 'list' }"
                        t-on-click="() => this.setType('list')"
                    >
                        <i class="fa fa-list" /> List
                    </button>
                </div>
            </nav>
            <div class="o_action_manager flex-grow-1">
                <View t-if="canRead" t-key="state.type" t-props="viewProps" />
            </div>
        </div>
    </t>
</templates>
