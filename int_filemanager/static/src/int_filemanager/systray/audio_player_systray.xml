<templates xml:space="preserve">
    <!-- Nur sichtbar, wenn ueberhaupt eine Queue laeuft (hasTrack) - genau wie Discuss' eigener
         Anruf-Balken in der Navbar nur waehrend eines aktiven Calls erscheint, nicht dauerhaft
         als leerer Platzhalter. "dropdown-toggle o-no-caret" auf diesem Wrapper - obwohl er
         selbst kein Bootstrap-Dropdown ist - ist keine Zweckentfremdung, sondern derselbe Trick,
         den Odoos eigener mehrteiliger Systray-Eintrag nutzt (discuss/call/common/call_menu.xml:
         "dropdown-toggle o-no-caret" auf dem aeusseren Call-Balken): navbar.scss's generische
         Regel (".o_nav_entry, .dropdown-toggle:not(.o-dropdown-toggle-custo) { @extend
         %-main-navbar-entry-base; @extend %-main-navbar-entry-spacing; }") greift ueber die
         Klasse allein, unabhaengig davon, ob wirklich ein Bootstrap-Dropdown dahinter steckt -
         genau das navbar-einheitliche Padding, das vorher per Hand erfunden werden musste
         (Nutzerwunsch 2026-09-18, am echten Odoo-Quellcode verifiziert statt geraten).
         "o-no-caret" unterdrueckt dabei den sonst automatisch erscheinenden Dropdown-Pfeil. -->
    <t t-name="int_filemanager.AudioPlayerSystray">
        <div t-if="hasTrack" class="o_int_filemanager_audio_systray btn-group dropdown-toggle o-no-caret" role="group">
            <button type="button" class="btn o_int_filemanager_audio_btn"
                    data-tooltip="Zurück" t-on-click="onPrev">
                <i class="fa fa-step-backward"/>
            </button>
            <button type="button" class="btn o_int_filemanager_audio_btn"
                    t-att-data-tooltip="state.isPlaying ? 'Pause' : 'Abspielen'" t-on-click="onTogglePlay">
                <i t-attf-class="fa {{state.isPlaying ? 'fa-pause' : 'fa-play'}}"/>
            </button>
            <button type="button" class="btn o_int_filemanager_audio_btn"
                    data-tooltip="Weiter" t-on-click="onNext">
                <i class="fa fa-step-forward"/>
            </button>
            <button type="button" class="btn o_int_filemanager_audio_btn"
                    data-tooltip="Titel/Fortschritt" t-on-click="onTogglePanel">
                <i class="fa fa-music"/>
            </button>
        </div>
    </t>

    <t t-name="int_filemanager.AudioPlayerPanel">
        <div class="o_int_filemanager_audio_panel p-3">
            <!-- Icon-Quadrat statt nur Text (Nutzerwunsch 2026-09-18, Vorbild Cloudreve) -
                 dasselbe Muster wie der Kanban-Platzhalter fuer Dateien ohne thumbnail
                 (native_kanban_view.scss: .o_int_filemanager_kanban_cover_fallback), hier nur
                 klein statt als grosse Kartenflaeche. Kein echtes Cover moeglich (mediameta.py
                 liest nur Text-Tags, keine eingebettete Cover-Art - dieselbe Einschraenkung wie
                 im FileViewer, siehe file_viewer_patch.xml-Kommentar in dessen Git-Historie). -->
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="o_int_filemanager_audio_cover d-flex align-items-center justify-content-center flex-shrink-0">
                    <i class="fa fa-music text-muted"/>
                </div>
                <div class="flex-grow-1 overflow-hidden">
                    <div t-if="trackArtist" class="text-truncate text-muted small" t-esc="trackArtist"/>
                    <div class="text-truncate fw-bold" t-att-data-tooltip="trackTitle" data-tooltip-delay="1000"
                         t-esc="trackTitle"/>
                </div>
                <!-- "Oben rechts" (Nutzerwunsch 2026-09-18), aber nicht per position-absolute mit
                     geratenen Werten - Odoos eigenes Vorbild dafuer (web/static/lib/bootstrap/
                     scss/_modal.scss: ".modal-header .btn-close") sitzt gar nicht absolut,
                     sondern ganz normal als letztes Flex-Kind der Kopfzeile mit
                     "margin-left: auto" (schiebt es ans Ende) plus negativen Raendern von genau
                     der HALBEN Kopfzeilen-Polsterung oben/rechts (frisst sich so buendig in den
                     Rand, statt einen zusaetzlichen Abstand zu Nachbar-Elementen zu brauchen).
                     Unsere Polsterung ist "p-3" (1rem) auf dem Panel - die Haelfte davon ist
                     Bootstraps eigener Abstands-Schritt "2" (0.5rem), daher "mt-n2 me-n2" statt
                     eines frei erfundenen Wertes; "p-2" auf dem Button selbst spiegelt ebenso die
                     halbierte Polsterung, die Odoos .btn-close fuer die eigene Klickflaeche
                     bekommt. Bewusst weiterhin NICHT Odoos ".btn-close" selbst (die steht fuer
                     reines, folgenloses Schliessen, web/core/dialog/dialog.xml: ruft nur
                     "dismiss" auf) - unser "Beenden" stoppt zusaetzlich die Wiedergabe und leert
                     die Queue, deshalb bewusst weiterhin eigenes Icon/Farbe (oi-close,
                     text-danger, wie Discuss' call_actions.js es fuer destruktive Aktionen tut). -->
                <button type="button" class="btn btn-link p-2 mt-n2 me-n2 ms-auto flex-shrink-0 text-danger"
                        data-tooltip="Beenden" t-on-click="onStop">
                    <i class="oi oi-close"/>
                </button>
            </div>
            <!-- Bootstraps eigene "progress"/"progress-bar"-Klassen statt selbst erfundener
                 Klassennamen (Nutzerfrage 2026-09-18 "hat Odoo dafuer was Natives?") - ein
                 eigenes klickbares Scrubber-Widget hat Odoo nicht (die beiden vorhandenen
                 "Fortschrittsbalken" sind ein an ORM-Records gebundenes Feld-Widget bzw. ein
                 Datei-Upload-Balken mit fest eingebautem Abbrechen-Icon, beide fuer diesen Fall
                 ungeeignet), aber wenigstens dieselbe CSS-Basis wie ueberall sonst in Odoo. -->
            <div class="progress o_int_filemanager_audio_progress mb-1" t-on-mousedown="onSeekStart">
                <div class="progress-bar" t-attf-style="width: {{progressPercent}}%"/>
            </div>
            <div class="d-flex justify-content-between text-muted small mb-2">
                <span t-esc="formatTime(state.currentTime)"/>
                <span t-esc="formatTime(state.duration)"/>
            </div>
            <!-- Gefuellte runde Buttons statt randloser Icons (Nutzerreport 2026-09-18 "wirken
                 klein"/"viel weisse Flaeche") - Vorbild Odoos EIGENER Audioplayer, den es
                 tatsaechlich gibt: der Sprachnachrichten-Player in Discuss
                 (mail/discuss/voice_message/common/voice_player.xml), dessen Play/Pause-Button
                 exakt "btn rounded-pill ... bg-200" ist. Nicht das Icon wurde dort groesser
                 gemacht, sondern der ausgefuellte Kreis gibt dem Button visuelles Gewicht - hier
                 1:1 uebernommen. fa-fw (Odoos eigene Fixbreite-Icon-Klasse, ebenfalls aus
                 voice_player.xml) sorgt fuer eine gleichmaessige Kreisform unabhaengig davon,
                 welches der drei Icons gerade zu sehen ist. Bewusst NUR hier im Panel, nicht in
                 der kompakten Navbar-Reihe oben - Odoos eigener Anruf-Balken (call_menu.xml)
                 bleibt in der Navbar ebenfalls flach/randlos, dieselbe gefuellte Kreis-Optik
                 taucht dort erst im aufgeklappten Zustand auf.

                 "d-flex align-items-center justify-content-center" zusaetzlich auf jedem Button
                 (Nutzerreport 2026-09-18 "Icon sitzt verschoben im Kreis, kein Gebastel"): Odoos
                 eigenes ".btn" ist "display: inline-block" mit Zentrierung ueber
                 padding/line-height (web/static/lib/bootstrap/scss/_buttons.scss, am
                 Quellcode verifiziert) - das zentriert TEXT zuverlaessig, aber ein einzelnes
                 Font-Awesome-Icon-Glyph (::before-Inhalt mit eigenen, von normalem Text
                 abweichenden Schriftmetriken) sitzt dadurch oft sichtbar ausserhalb der Mitte,
                 besonders auffaellig in einer engen Kreisform. Nicht durch einen geratenen
                 Margin-Wert kaschiert, sondern strukturell durch Flexbox-Zentrierung ersetzt -
                 dieselbe Technik, die dieses Modul schon einmal fuer denselben Fehlerfall
                 einsetzte (name_icon_field.xml/native_list_view.scss:
                 .o_int_filemanager_name_icon) und die auch Odoo selbst mehrfach fuer
                 Icon-in-Kreis-Faelle nutzt (z.B. mail/core/common/attachment_list.xml). -->
            <!-- Wiedergabemodus als zyklischer Button (Nutzerwunsch 2026-09-18) - bewusst FLACH
                 statt gefuellter Kreis wie die drei Haupt-Steuerbuttons daneben: er ist ein
                 sekundaerer Modus-Schalter, kein primaerer Transport-Befehl, dieselbe optische
                 Rangordnung wie z.B. bei Cloudreve (Repeat-Icon dort ebenfalls zurueckhaltender
                 als der grosse Play-Button). Klick zyklisiert "der Reihe nach -> einzelne Datei
                 -> zufaellig -> ..." (siehe audio_player_service.js: cycleRepeatMode(), Vorbild
                 Odoos eigener Sortier-Pfeil in Listen-Spaltenkoepfen). In derselben Reihe wie die
                 drei Haupt-Buttons statt separat links (Nutzerwunsch 2026-09-18) - eine einzige
                 zentrierte Gruppe. -->
            <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                <button type="button" t-attf-class="btn o_int_filemanager_audio_btn fa fa-fw d-flex align-items-center justify-content-center {{repeatModeIcon}}"
                        t-att-data-tooltip="repeatModeLabel" t-on-click="onCycleRepeatMode"/>
                <button type="button" class="btn o_int_filemanager_audio_btn rounded-pill bg-200 fa fa-fw fa-step-backward d-flex align-items-center justify-content-center"
                        data-tooltip="Zurück" t-on-click="onPrev"/>
                <button type="button" t-attf-class="btn o_int_filemanager_audio_btn rounded-pill bg-200 fa fa-fw d-flex align-items-center justify-content-center {{state.isPlaying ? 'fa-pause' : 'fa-play'}}"
                        t-att-data-tooltip="state.isPlaying ? 'Pause' : 'Abspielen'" t-on-click="onTogglePlay"/>
                <button type="button" class="btn o_int_filemanager_audio_btn rounded-pill bg-200 fa fa-fw fa-step-forward d-flex align-items-center justify-content-center"
                        data-tooltip="Weiter" t-on-click="onNext"/>
                <!-- Queue-Liste auf-/zuklappen (Nutzerwunsch 2026-09-18: "Ueberblick, welche
                     Dateien noch in der Playlist sind", wenn man in einen anderen Ordner
                     gewechselt hat) - dieselbe flache Optik wie der Wiedergabemodus-Button, aus
                     demselben Grund (sekundaerer Schalter, kein Transport-Befehl). Bewusst IM
                     selben Panel auf-/zugeklappt statt eines zweiten, verschachtelten Popovers -
                     schlichter als noch eine Ebene. -->
                <button type="button" t-ref="queueToggle" t-attf-class="btn o_int_filemanager_audio_btn fa fa-fw fa-list-ul d-flex align-items-center justify-content-center {{uiState.showQueue ? 'active' : ''}}"
                        data-tooltip="Playlist" t-on-click="onToggleQueue"/>
            </div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="fa fa-volume-down text-muted"/>
                <input type="range" min="0" max="1" step="0.05" class="form-range flex-grow-1"
                       t-att-value="state.volume" t-on-input="onVolume"/>
            </div>
            <!-- Queue-Liste (Nutzerwunsch 2026-09-18) - dasselbe Bootstrap-"list-group"-Muster,
                 mit dem Odoos eigene Nachrichten-/Aktivitaeten-Dropdowns direkt daneben in der
                 Navbar ihre kompakten, klickbaren Benachrichtigungslisten aufbauen
                 (mail/core/public_web/messaging_menu.xml: "o-mail-MessagingMenu-list ...
                 list-group list-group-flush", mail/core/web/activity_menu.xml:
                 "store.activityGroups ... list-group list-group-flush") - kein eigens
                 erfundenes Listen-Layout. "overflow-auto o-scrollbar-thin" + max-height
                 (audio_player_systray.scss) begrenzen die Hoehe unabhaengig von der
                 Ordnergroesse - dieselbe schlanke Scrollbar-Klasse, die das ohnehin schon als
                 Abhaengigkeit vorhandene mail-Modul dafuer selbst nutzt. Pfad-Unterzeile pro
                 Zeile nur, wenn die Queue tatsaechlich mehrere Ordner umfasst (Nutzerfrage
                 2026-09-18 "was wenn man aus einer Suche heraus eine Audio oeffnet?" - bei
                 rekursiver Suche kann das der Fall sein, siehe onPlayAudio() in
                 filemanager_controller_mixin.js) - sonst waere er redundant. -->
            <div t-if="uiState.showQueue" t-ref="queueList" class="o_int_filemanager_audio_queue list-group list-group-flush overflow-auto o-scrollbar-thin mb-2">
                <button t-foreach="state.queue" t-as="track" t-key="track.path" type="button"
                        t-attf-class="list-group-item list-group-item-action py-1 px-2 border-0 {{track_index === state.index ? 'active' : ''}}"
                        t-on-click="() => this.onPlayAt(track_index)">
                    <div class="text-truncate" t-esc="track.title || track.name"/>
                    <div t-if="queueHasMultipleFolders" class="text-truncate small opacity-75" t-esc="track.folderPath || '/'"/>
                </button>
            </div>
        </div>
    </t>
</templates>
