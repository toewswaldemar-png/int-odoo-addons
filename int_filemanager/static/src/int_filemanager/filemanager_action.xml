<templates xml:space="preserve">
    <t t-name="int_filemanager.FileManagerAction" owl="1">
        <WithSearch resModel="'int_filemanager.file'" searchMenuTypes="['filter', 'favorite']"
                    searchViewFields="searchViewFields" searchViewArch="searchViewArch" loadIrFilters="true"
                    domain="initialDomain" context="initialContext">
            <t t-set-slot="default" t-slot-scope="search">
                <IntFileManager domain="search.domain" context="search.context"/>
            </t>
        </WithSearch>
    </t>

    <t t-name="int_filemanager.FileManager" owl="1">
        <Layout display="display" className="'hm-filemanager o_list_view d-flex flex-column h-100'">
            <t t-set-slot="control-panel-create-button">
                <Dropdown>
                    <button class="btn btn-primary" data-hotkey="c">
                        <i class="fa fa-plus me-1"/>Neu
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem onSelected="() => this.triggerUpload()">
                            <i class="fa fa-upload me-1 fa-fw"/>Dateien hochladen
                        </DropdownItem>
                        <DropdownItem onSelected="() => this.onNewFolder()">
                            <i class="fa fa-folder-o me-1 fa-fw"/>Neuer Ordner
                        </DropdownItem>
                    </t>
                </Dropdown>
                <input type="file" multiple="multiple" class="d-none"
                       t-ref="fileInput" t-on-change="onFileInputChange"/>
            </t>
            <t t-set-slot="layout-actions">
                <SearchBar/>
            </t>
            <t t-set-slot="control-panel-selection-actions">
                <div t-if="state.selected.size" class="d-flex align-items-center gap-2">
                    <div class="o_selection_box list-group flex-row w-auto">
                        <span class="list-group-item active d-flex align-items-center pe-0 py-0 rounded-1 gap-1">
                            <b t-esc="state.selected.size"/> ausgewählt
                            <button title="Auswahl aufheben" class="o_unselect_all btn btn-link ms-auto border-0"
                                    t-on-click="clearSelection">
                                <i class="oi oi-close"/>
                            </button>
                        </span>
                    </div>
                    <Dropdown>
                        <button class="btn btn-secondary" data-hotkey="u">
                            <i class="fa fa-cog me-1"/>
                            <span class="o_dropdown_title">Aktionen</span>
                        </button>
                        <t t-set-slot="content">
                            <DropdownItem t-if="state.selected.size === 1" onSelected="() => this.onRenameSelected()">
                                <i class="fa fa-pencil me-1 fa-fw"/>Umbenennen
                            </DropdownItem>
                            <DropdownItem onSelected="() => this.onBulkDelete()">
                                <i class="fa fa-trash-o me-1 fa-fw"/>Löschen
                            </DropdownItem>
                        </t>
                    </Dropdown>
                </div>
            </t>
            <t t-set-slot="control-panel-navigation-additional">
                <Pager t-if="state.total > state.limit" offset="state.offset" limit="state.limit" total="state.total" isEditable="false"
                       onUpdate="(vals) => this.onPagerUpdate(vals)"/>
            </t>
            <div class="d-flex flex-grow-1 overflow-hidden">
                <nav class="hm-filemanager-tree-panel border-end overflow-auto p-2">
                    <IntFolderTree t-key="state.treeVersion" activePath="state.path" onNavigate="(path) => this.onNavigate(path)"/>
                </nav>
                <div class="d-flex flex-column flex-grow-1 overflow-hidden">
                    <nav class="hm-filemanager-breadcrumbs p-2 border-bottom">
                        <ol class="breadcrumb mb-0">
                            <t t-foreach="state.breadcrumbs" t-as="crumb" t-key="crumb.path">
                                <li t-if="crumb_last" class="breadcrumb-item active" t-esc="crumb.name"/>
                                <li t-else="" class="breadcrumb-item">
                                    <a href="#" class="fw-bold" t-on-click.prevent="() => this.onBreadcrumb(crumb)" t-esc="crumb.name"/>
                                </li>
                            </t>
                        </ol>
                    </nav>
                    <div class="hm-filemanager-list o_list_renderer o_renderer flex-grow-1 overflow-auto">
                        <table class="o_list_table table table-sm table-hover table-striped position-relative mb-0">
                            <thead>
                                <tr>
                                    <th class="o_list_record_selector align-middle pe-1 cursor-pointer" style="width: 2em;"
                                        t-on-click.stop="toggleSelectAll">
                                        <CheckBox value="allSelected" onChange="() => this.toggleSelectAll()" className="'d-flex m-0'"/>
                                    </th>
                                    <th t-att-class="columnHeaderClass('name')" t-on-click="() => this.sortBy('name')">
                                        <div class="d-flex align-items-center">
                                            <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1">Name</span>
                                            <i class="o_list_sortable_icon fa" t-att-class="sortIconClass('name')"/>
                                        </div>
                                    </th>
                                    <th t-att-class="columnHeaderClass('size')" t-on-click="() => this.sortBy('size')">
                                        <div class="d-flex align-items-center">
                                            <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1">Größe</span>
                                            <i class="o_list_sortable_icon fa" t-att-class="sortIconClass('size')"/>
                                        </div>
                                    </th>
                                    <th t-att-class="columnHeaderClass('mtime')" t-on-click="() => this.sortBy('mtime')">
                                        <div class="d-flex align-items-center">
                                            <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1">Geändert</span>
                                            <i class="o_list_sortable_icon fa" t-att-class="sortIconClass('mtime')"/>
                                        </div>
                                    </th>
                                    <th>Tags</th>
                                    <th t-if="state.showLinkColumn">Verknüpft mit</th>
                                    <th class="o_list_controller o_list_actions_header w-print-0 p-print-0 position-sticky end-0">
                                        <div class="o_optional_columns_dropdown d-print-none text-center border-top-0">
                                            <Dropdown position="'bottom-end'">
                                                <button class="btn p-0" tabindex="-1">
                                                    <i class="o_optional_columns_dropdown_toggle oi oi-fw oi-settings-adjust"/>
                                                </button>
                                                <t t-set-slot="content">
                                                    <DropdownItem closingMode="'none'" onSelected="() => this.toggleLinkColumn()">
                                                        <CheckBox value="state.showLinkColumn" onChange="() => this.toggleLinkColumn()">
                                                            <span>Verknüpft mit</span>
                                                        </CheckBox>
                                                    </DropdownItem>
                                                </t>
                                            </Dropdown>
                                        </div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.entries" t-as="entry" t-key="entry.path"
                                    t-att-class="{'table-info': isSelected(entry)}">
                                    <td class="o_list_record_selector user-select-none"
                                        t-on-click.stop="() => this.toggleSelect(entry)">
                                        <CheckBox value="isSelected(entry)" onChange="() => this.toggleSelect(entry)"/>
                                    </td>
                                    <td class="o_data_cell cursor-pointer" t-on-click="() => this.onOpenEntry(entry)">
                                        <img t-if="!entry.is_dir and hasThumbnail(entry)"
                                             t-att-src="thumbnailUrl(entry)"
                                             class="hm-filemanager-thumb me-2"/>
                                        <i t-else="" t-attf-class="fa {{ entry.is_dir ? 'fa-folder' : fileIconClass(entry.name) }} me-2"/>
                                        <t t-esc="entry.name"/>
                                        <i t-if="entry.linked_record" class="fa fa-link ms-2 text-muted"
                                           t-att-title="'Verknüpft mit: ' + entry.linked_record.display_name"/>
                                        <i t-if="!entry.is_dir and (entry.media_state === 'pending' or entry.media_state === 'running')"
                                           class="fa fa-refresh text-muted ms-1" t-att-title="mediaBadgeTitle(entry)"/>
                                        <i t-if="!entry.is_dir and entry.media_state === 'error'"
                                           class="fa fa-exclamation-triangle text-warning ms-1" t-att-title="mediaBadgeTitle(entry)"/>
                                        <i t-if="!entry.is_dir and entry.media_state === 'done' and (entry.page_count or entry.audio_duration)"
                                           class="fa fa-info-circle text-muted ms-1" t-att-title="mediaBadgeTitle(entry)"/>
                                    </td>
                                    <td class="o_data_cell"><t t-esc="formatSize(entry.size)"/></td>
                                    <td class="o_data_cell"><t t-esc="entry.mtime"/></td>
                                    <td class="o_data_cell" style="min-width: 220px;">
                                        <IntInlineTags
                                            path="entryPath(entry)"
                                            metaId="entry.meta_id"
                                            onSaved="(metaId) => this.onTagsSaved(entry, metaId)"/>
                                    </td>
                                    <td t-if="state.showLinkColumn" class="o_data_cell cursor-pointer" t-on-click="() => this.onLinkRecord(entry)">
                                        <t t-if="entry.linked_record" t-esc="entry.linked_record.display_name"/>
                                        <span t-else="" class="text-muted">–</span>
                                    </td>
                                    <td class="o_data_cell text-end">
                                        <Dropdown>
                                            <button class="btn btn-link btn-sm text-reset" title="Aktionen">
                                                <i class="fa fa-ellipsis-v"/>
                                            </button>
                                            <t t-set-slot="content">
                                                <DropdownItem t-if="!entry.is_dir and isEditable(entry.name)" onSelected="() => this.onEdit(entry)">
                                                    <i class="fa fa-pencil me-1 fa-fw"/>Bearbeiten
                                                </DropdownItem>
                                                <DropdownItem t-if="!entry.is_dir and isLocalOfficeCapable(entry.name)" onSelected="() => this.onOpenLocal(entry)">
                                                    <i class="fa fa-desktop me-1 fa-fw"/>Lokal öffnen
                                                </DropdownItem>
                                                <DropdownItem t-if="!entry.is_dir" onSelected="() => this.onDownload(entry)">
                                                    <i class="fa fa-download me-1 fa-fw"/>Herunterladen
                                                </DropdownItem>
                                                <DropdownItem t-if="!entry.is_dir" onSelected="() => this.onShare(entry)">
                                                    <i class="fa fa-share-alt me-1 fa-fw"/>Freigeben
                                                </DropdownItem>
                                                <DropdownItem onSelected="() => this.onLinkRecord(entry)">
                                                    <i class="fa fa-link me-1 fa-fw"/>Verknüpfen mit...
                                                </DropdownItem>
                                            </t>
                                        </Dropdown>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div t-if="!state.entries.length and !state.loading" class="p-4 text-muted text-center">
                            Dieser Ordner ist leer.
                        </div>
                    </div>
                </div>
            </div>
        </Layout>
    </t>
</templates>
