<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="int_filemanager.DocumentNameField"
        t-inherit="web.CharField"
        t-inherit-mode="primary"
    >
        <xpath expr="//span[@t-esc='formattedValue']" position="replace">
            <span class="d-inline-flex align-items-center gap-2">
                <!-- Not draggable: a picture dragged onto the list would be dropped as a file. -->
                <img
                    t-if="thumbnailUrl"
                    class="o_int_filemanager_thumbnail"
                    t-att-src="thumbnailUrl"
                    loading="lazy"
                    alt=""
                    draggable="false"
                />
                <span
                    t-else=""
                    class="o_image o_int_filemanager_thumbnail"
                    t-att-data-mimetype="mimetype"
                />
                <span t-esc="formattedValue" />
            </span>
        </xpath>
    </t>
</templates>
