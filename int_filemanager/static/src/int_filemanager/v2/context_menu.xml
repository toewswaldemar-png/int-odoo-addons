<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
  <t t-name="int_filemanager.v2.ContextMenu">
        <t t-foreach="props.items" t-as="item" t-key="item.description">
            <DropdownItem
                class="item.class"
                onSelected="() => this.onItemSelected(item)"
            >
                <i t-att-class="item.icon" class="me-2" />
                <t t-esc="item.description" />
            </DropdownItem>
        </t>
    </t>
</templates>
