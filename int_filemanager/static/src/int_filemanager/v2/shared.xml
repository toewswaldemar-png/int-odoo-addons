<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <!-- Pieces the list and the kanban template share. t-call runs in the caller's component,
       so "this" is the controller in all of them. -->

  <!-- Replaces Odoo's "New" button slot (dead here: the arch says create="false"). Needs a
       folder to put things in, so it is disabled at the top of the tree. -->
  <t t-name="int_filemanager.v2.CreateButton">
    <Dropdown>
      <button
        type="button"
        class="btn btn-primary text-nowrap o-dropdown-caret"
        t-att-disabled="!canCreateHere"
        t-att-data-tooltip="createTooltip"
      >
        New
      </button>
      <t t-set-slot="content">
        <DropdownItem onSelected="() => this.onNewFolder()">New folder</DropdownItem>
        <DropdownItem
          onSelected="() => this.triggerUpload()"
        >Upload files</DropdownItem>
        <DropdownItem
          onSelected="() => this.triggerFolderUpload()"
        >Upload folder</DropdownItem>
      </t>
    </Dropdown>
  </t>

  <t t-name="int_filemanager.v2.HiddenInputs">
    <input
      type="file"
      t-ref="fileInput"
      multiple="multiple"
      class="d-none"
      t-on-change="onFileInputChange"
    />
    <input
      type="file"
      t-ref="folderInput"
      webkitdirectory=""
      class="d-none"
      t-on-change="onFolderInputChange"
    />
    <input
      type="file"
      t-ref="newVersionInput"
      class="d-none"
      t-on-change="onNewVersionInputChange"
    />
  </t>

  <!-- Right next to the pager, like Odoo's own filter toggle in that slot. The class lets the
       list renderer's "click outside deselects" guard recognise it (the button sits in the
       control panel, which would otherwise count as outside). -->
  <t t-name="int_filemanager.v2.ChatterToggle">
    <button
      type="button"
      class="btn btn-secondary text-nowrap o_int_filemanager_chatter_toggle"
      t-att-class="{ active: chatterState.open }"
      data-tooltip="Show notes / activities"
      t-on-click="onToggleChatterPanel"
    >
      <i class="oi oi-panel-right fa-flip-horizontal" />
    </button>
  </t>

  <t t-name="int_filemanager.v2.TreeSidebar">
    <ResizablePanel
      t-if="!env.isSmall"
      class="'o_int_filemanager_tree_resizable'"
      handleSide="'end'"
      initialWidth="initialTreeWidth"
      minWidth="180"
      onResize.bind="onResizeTree"
    >
      <div class="o_int_filemanager_tree_sidebar">
        <!-- Read from the search model, not from a controller field: the folder is known
             before anything has mounted, so a reload (F5) in a sub-folder opens the tree
             right there. -->
        <FolderTree
          activeId="env.searchModel.folderId || false"
          onSelectFolder="(id, hasChildren) => this.onFolderTreeSelect(id, hasChildren)"
          registerApi="(api) => this.folderTreeApi = api"
        />
      </div>
    </ResizablePanel>
  </t>

  <!-- Drop zone overlay, chatter panel and uploads. The drop handling itself is on window
       (controller_uploads.js); this overlay is only to be seen, hence pointer-events: none. -->
  <t t-name="int_filemanager.v2.Overlays">
    <div t-if="dropState.dragging" class="o_int_filemanager_dropzone">
      <div class="o_int_filemanager_dropzone_label">
        <i class="fa fa-cloud-upload me-2" />Drop files or folders here to upload
      </div>
    </div>
    <div
      t-if="chatterState.open"
      class="o_int_filemanager_chatter_panel"
      t-attf-style="top: {{chatterState.topPx}}px;"
    >
      <div class="o_int_filemanager_chatter_panel_header">
        <span
          class="text-truncate fw-bold"
          t-att-data-tooltip="chatterTitle"
          data-tooltip-delay="1000"
          t-esc="chatterTitle"
        />
        <button
          type="button"
          class="btn-close"
          aria-label="Close"
          t-on-click="onToggleChatterPanel"
        />
      </div>
      <div t-if="!chatterRecord" class="text-muted p-3">
        Select a file or folder to see its notes and activities.
      </div>
      <Chatter
        t-else=""
        threadModel="'int_filemanager.node'"
        threadId="chatterRecord.resId"
        isChatterAside="true"
        isInFormSheetBg="false"
      />
    </div>
    <UploadPanel
      items="uploadState.items"
      unfinishedCount="uploadState.unfinished"
      onPause="(id) => this.uploads.pause(id)"
      onRetry="(id) => this.uploads.retry(id)"
      onRename="(item) => this.onUploadRename(item)"
      onCancel="(id) => this.uploads.cancel(id)"
      onClear="() => this.uploads.clearFinished()"
      onDiscard="() => this.uploads.discardUnfinished()"
    />
  </t>

</templates>
