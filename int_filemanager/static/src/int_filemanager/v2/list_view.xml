<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
  <t
        t-name="int_filemanager.v2.ListView"
        t-inherit="web.ListView"
        t-inherit-mode="primary"
    >
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="replace">
            <t t-set-slot="control-panel-create-button">
                <t t-call="int_filemanager.v2.CreateButton" />
                <t t-call="int_filemanager.v2.HiddenInputs" />
            </t>
        </xpath>
        <xpath
            expr="//t[@t-set-slot='control-panel-navigation-additional']"
            position="inside"
        >
            <t t-call="int_filemanager.v2.ChatterToggle" />
        </xpath>

        <!-- On a phone the control panel is hidden by CSS on the small-screen breakpoint and this
         header takes its role: search bar first, then the breadcrumb path. The folder tree is
         Odoo's search panel, which has its own small-screen layout inside the content. -->
        <xpath expr="//div[@t-ref='root']/*[1]" position="before">
            <div t-if="env.isSmall" class="o_int_filemanager_mobile_header">
                <div class="d-flex align-items-center gap-1">
                    <Dropdown class="flex-shrink-0">
                        <button
                            type="button"
                            class="btn btn-primary text-nowrap px-2"
                            aria-label="New"
                            t-att-disabled="!canCreateHere"
                        >
                            <i class="fa fa-plus" />
                        </button>
                        <t t-set-slot="content">
                            <DropdownItem
                                onSelected="() => this.onNewFolder()"
                            >New folder</DropdownItem>
                            <DropdownItem
                                onSelected="() => this.triggerUpload()"
                            >Upload files</DropdownItem>
                            <DropdownItem
                                onSelected="() => this.triggerFolderUpload()"
                            >Upload folder</DropdownItem>
                        </t>
                    </Dropdown>
                    <!-- A standalone Odoo component: only needs env.searchModel. autofocus="false", or the
               keyboard pops up on every folder change. -->
                    <div class="flex-grow-1">
                        <SearchBar autofocus="false" />
                    </div>
                    <!-- The control panel slot with the file inputs is not in the DOM on a phone. -->
                    <t t-call="int_filemanager.v2.HiddenInputs" />
                </div>
                <div
                    class="o_int_filemanager_mobile_breadcrumb_row d-flex align-items-center gap-1"
                >
                    <!-- t-ref: the controller measures scrollWidth/clientWidth of exactly this element
               to decide whether to collapse. Every segment is flex-shrink-0 + text-nowrap so
               the row really overflows instead of each segment ellipsizing on its own. -->
                    <nav
                        t-ref="mobileBreadcrumbNav"
                        class="o_int_filemanager_mobile_breadcrumb d-flex align-items-center flex-nowrap overflow-auto"
                    >
                        <t
                            t-if="!mobileBreadcrumbState.collapsed or mobileBreadcrumbs.length lt 3"
                        >
                            <t
                                t-foreach="mobileBreadcrumbs"
                                t-as="crumb"
                                t-key="crumb.jsId"
                            >
                                <span
                                    t-if="!crumb_first"
                                    class="text-muted mx-1 flex-shrink-0"
                                >/</span>
                                <span
                                    t-if="crumb_last"
                                    class="fw-bold text-nowrap flex-shrink-0"
                                    t-esc="crumb.name"
                                />
                                <button
                                    t-else=""
                                    type="button"
                                    class="btn btn-link p-0 text-nowrap flex-shrink-0"
                                    t-on-click="() => crumb.onSelected()"
                                >
                                    <t t-esc="crumb.name" />
                                </button>
                            </t>
                        </t>
                        <!-- Collapsed: first segment, a dropdown with the hidden ones, last segment. -->
                        <t t-else="">
                            <button
                                type="button"
                                class="btn btn-link p-0 text-truncate flex-shrink-0"
                                t-att-data-tooltip="mobileBreadcrumbs[0].name"
                                data-tooltip-delay="1000"
                                t-on-click="() => mobileBreadcrumbs[0].onSelected()"
                            >
                                <t t-esc="mobileBreadcrumbs[0].name" />
                            </button>
                            <span class="text-muted mx-1">/</span>
                            <Dropdown>
                                <span class="btn btn-link p-0">…</span>
                                <t t-set-slot="content">
                                    <t
                                        t-foreach="mobileBreadcrumbs.slice(1, -1)"
                                        t-as="hiddenCrumb"
                                        t-key="hiddenCrumb.jsId"
                                    >
                                        <DropdownItem
                                            onSelected="() => hiddenCrumb.onSelected()"
                                        >
                                            <t t-esc="hiddenCrumb.name" />
                                        </DropdownItem>
                                    </t>
                                </t>
                            </Dropdown>
                            <span class="text-muted mx-1">/</span>
                            <span
                                class="fw-bold text-truncate"
                                t-att-data-tooltip="mobileBreadcrumbs[mobileBreadcrumbs.length - 1].name"
                                data-tooltip-delay="1000"
                                t-esc="mobileBreadcrumbs[mobileBreadcrumbs.length - 1].name"
                            />
                        </t>
                    </nav>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@t-ref='root']" position="inside">
            <t t-call="int_filemanager.v2.Overlays" />
        </xpath>
    </t>
</templates>
