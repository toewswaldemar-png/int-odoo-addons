<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
  <!-- Odoo's category template, with two changes: the caret also shows for a folder whose
       sub-folders are not loaded yet, and each folder carries its id for dropping files
       and folders onto it (controller_interaction.js). The top ("All") has no id. -->
  <t
        t-name="int_filemanager.v2.SearchPanel.Category"
        t-inherit="web.SearchPanel.Category"
        t-inherit-mode="primary"
    >
    <xpath expr="//header" position="attributes">
      <attribute
                name="t-att-data-int-filemanager-tree-id"
            >valueId or false</attribute>
    </xpath>
    <xpath expr="//i[@t-if='value.childrenIds.length']" position="attributes">
      <attribute
                name="t-if"
            >value.childrenIds.length or value.has_children</attribute>
    </xpath>
  </t>
</templates>
