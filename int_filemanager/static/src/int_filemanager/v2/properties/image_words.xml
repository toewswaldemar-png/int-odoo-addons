<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <t t-name="int_filemanager.v2.ImageWords">
        <div
            class="o_int_filemanager_image_words position-absolute top-0 start-0 w-100 h-100"
            t-att-class="{o_word_mode: props.wordMode}"
        >
            <div
                t-foreach="props.words"
                t-as="word"
                t-key="word_index"
                class="o_int_filemanager_word position-absolute"
                t-att-class="{o_picking: isPicking(word_index)}"
                t-att-style="wordStyle(word)"
                t-on-pointerdown.prevent="() => this.onPointerDown(word_index)"
                t-on-pointerenter="() => this.onPointerEnter(word_index)"
                t-on-pointerup="() => this.onPointerUp(word_index)"
            />
            <div
                t-foreach="props.markers"
                t-as="marker"
                t-key="marker.fieldId"
                class="o_int_filemanager_value_box position-absolute"
                t-att-class="{o_active: marker.fieldId === props.activeFieldId}"
                t-att-title="marker.name"
                t-att-style="markerStyle(marker)"
            />
        </div>
    </t>

</templates>
