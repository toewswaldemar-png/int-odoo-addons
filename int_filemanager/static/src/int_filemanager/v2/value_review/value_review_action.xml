<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <!-- The value review (client action). Both panes stay mounted on a small screen and are
       switched with d-none: Odoo's Notebook draws only the active tab, which would load
       the document again at every change. -->
  <t t-name="int_filemanager.v2.ValueReview">
    <Layout
      display="display"
      className="'o_int_filemanager_review h-100 d-flex flex-column'"
    >
      <t t-set-slot="control-panel-create-button">
        <t t-if="!isEmpty">
          <button
            type="button"
            class="btn btn-primary"
            data-hotkey="s"
            t-att-disabled="state.saving or !state.data"
            t-on-click="onSave"
          >Save</button>
          <button
            type="button"
            class="btn btn-secondary"
            data-hotkey="j"
            t-att-disabled="state.saving or !isChanged"
            t-on-click="onDiscard"
          >Discard</button>
        </t>
      </t>
      <t t-set-slot="control-panel-status-indicator">
        <span
          t-if="isChanged"
          class="text-warning small o_int_filemanager_review_dirty"
        >Unsaved changes</span>
      </t>
      <t t-if="isEmpty">
        <div class="o_view_nocontent">
          <div class="o_nocontent_help">
            <p class="o_view_nocontent_neutral_face">No files to check</p>
            <p>Select files in the file manager and choose "Check values".</p>
          </div>
        </div>
      </t>
      <t t-else="">
        <ul t-if="env.isSmall" class="nav nav-tabs o_int_filemanager_review_tabs">
          <li class="nav-item">
            <a
              class="nav-link"
              t-att-class="{active: state.tab === 'document'}"
              role="button"
              t-on-click="() => this.onSelectTab('document')"
            >Document</a>
          </li>
          <li class="nav-item">
            <a
              class="nav-link"
              t-att-class="{active: state.tab === 'values'}"
              role="button"
              t-on-click="() => this.onSelectTab('values')"
            >Values</a>
          </li>
        </ul>
        <div class="o_int_filemanager_review_body d-flex flex-grow-1 overflow-hidden">
          <ResizablePanel
            class="documentClass"
            handleSide="'end'"
            initialWidth="panelWidth"
            minWidth="320"
          >
            <iframe
              t-if="hasViewer"
              t-ref="viewer"
              t-key="nodeId"
              class="o_int_filemanager_review_viewer"
              t-att-src="viewerSrc"
              title="Document"
            />
            <div t-elif="state.status === 'loading'" class="text-center p-5">
              <i
                class="fa fa-circle-o-notch fa-spin fa-2x"
                role="img"
                aria-label="Loading"
              />
            </div>
            <div t-else="" class="o_view_nocontent">
              <div class="o_nocontent_help">
                <p class="o_view_nocontent_neutral_face">No preview here</p>
                <p>Only PDF files are shown next to their values for now.</p>
              </div>
            </div>
          </ResizablePanel>
          <div
            class="o_int_filemanager_review_values o_form_view flex-grow-1 overflow-auto"
            t-att-class="{'d-none': env.isSmall and state.tab !== 'values'}"
          >
            <div class="o_form_sheet_bg">
              <div class="o_form_sheet p-3">
                <t t-if="state.status === 'loading'">
                  <div class="text-center p-5">
                    <i
                      class="fa fa-circle-o-notch fa-spin fa-2x"
                      role="img"
                      aria-label="Loading"
                    />
                  </div>
                </t>
                <t t-elif="state.status === 'pending'">
                  <div class="alert alert-info" role="alert">
                    <i
                    class="fa fa-circle-o-notch fa-spin me-2"
                    role="img"
                    aria-label="Loading"
                  />The text of this file is still being read.
                  </div>
                </t>
                <t t-elif="state.status === 'none'">
                  <div class="o_view_nocontent">
                    <div class="o_nocontent_help">
                      <p class="o_view_nocontent_neutral_face">Nothing to read here</p>
                      <p>This file has no text to look for values in.</p>
                    </div>
                  </div>
                </t>
                <t t-elif="state.status === 'error'">
                  <div class="alert alert-danger" role="alert" t-esc="state.message" />
                </t>
                <t t-else="">
                  <div class="d-flex align-items-center gap-2 pb-2">
                    <span
                      t-if="isReviewed"
                      class="badge rounded-pill text-bg-success"
                    >Reviewed</span>
                    <span
                      t-else=""
                      class="badge rounded-pill text-bg-secondary"
                    >Not reviewed</span>
                  </div>
                  <div
                    t-foreach="state.data.warnings"
                    t-as="warning"
                    t-key="warning_index"
                    class="alert alert-warning"
                    role="alert"
                    t-esc="warning.message"
                  />
                  <div
                    t-if="state.activeFieldId !== null"
                    class="small text-muted pb-2"
                  >
                    Click words in the document to take a value from there.
                  </div>
                  <div
                    t-if="state.sender"
                    class="o_int_filemanager_review_row d-flex gap-3 py-2 border-bottom"
                  >
                    <label
                      class="o_form_label o_int_filemanager_review_label"
                    >Sender</label>
                    <div class="flex-grow-1">
                      <div class="fw-bold" t-esc="state.sender.name" />
                      <div class="small text-muted">found by <t
                        t-esc="state.sender.via"
                      /></div>
                    </div>
                    <button
                      type="button"
                      class="btn btn-light border-0 px-1 py-0 align-self-start"
                      aria-label="Remove"
                      data-tooltip="Remove"
                      t-on-click="onRemoveSender"
                    >
                      <i class="fa fa-times" />
                    </button>
                  </div>
                  <div
                    t-if="state.tags.length"
                    class="d-flex flex-wrap align-items-center gap-1 py-2 border-bottom"
                  >
                    <label
                      class="o_form_label o_int_filemanager_review_label"
                    >Tags</label>
                    <span
                      t-foreach="state.tags"
                      t-as="tag"
                      t-key="tag.id"
                      class="o_tag badge rounded-pill o_tag_color_0"
                    >
                      <t t-esc="tag.name" />
                      <a
                        role="button"
                        class="ms-1 text-reset"
                        aria-label="Remove"
                        t-on-click="() => this.onRemoveTag(tag)"
                      >
                        <i class="fa fa-times" />
                      </a>
                    </span>
                  </div>
                  <div t-if="!visibleRows.length" class="o_view_nocontent">
                    <div class="o_nocontent_help">
                      <p class="o_view_nocontent_neutral_face">No values found</p>
                      <p>Nothing in this document matches a field.</p>
                    </div>
                  </div>
                  <div
                    t-foreach="visibleRows"
                    t-as="row"
                    t-key="row.fieldId"
                    class="o_int_filemanager_review_row d-flex gap-3 py-2 border-bottom"
                    t-att-class="{o_active: state.activeFieldId === row.fieldId}"
                    t-on-click="() => this.onSelectField(row.fieldId)"
                  >
                    <label class="o_form_label o_int_filemanager_review_label">
                      <t t-esc="row.name" />
                      <i
                        t-if="row.uncertain"
                        class="fa fa-exclamation-triangle text-warning ms-1"
                        role="img"
                        aria-label="Please check this value"
                        data-tooltip="Please check this value"
                      />
                    </label>
                    <div class="flex-grow-1 min-w-0">
                      <input
                        type="text"
                        class="form-control form-control-sm fw-bold"
                        t-att-value="row.text"
                        t-att-aria-label="row.name"
                        t-on-input="(ev) => this.onType(row, ev.target.value)"
                        t-on-focus="() => this.onSelectField(row.fieldId)"
                      />
                      <div class="small text-muted" t-esc="originText(row)" />
                      <Dropdown t-if="row.suggestions.length > 1">
                        <button type="button" class="btn btn-link btn-sm p-0"><t
                          t-esc="row.suggestions.length - 1"
                        /> more found</button>
                        <t t-set-slot="content">
                          <DropdownItem
                            t-foreach="row.suggestions"
                            t-as="other"
                            t-key="other_index"
                            onSelected="() => this.onChoose(row, other)"
                          >
                            <t t-esc="other.source_text" />
                          </DropdownItem>
                        </t>
                      </Dropdown>
                    </div>
                    <button
                      type="button"
                      class="btn btn-light border-0 px-1 py-0 align-self-start"
                      aria-label="Remove"
                      data-tooltip="Remove"
                      t-on-click.stop="() => this.onRemove(row)"
                    >
                      <i class="fa fa-times" />
                    </button>
                  </div>
                </t>
              </div>
            </div>
          </div>
        </div>
      </t>
    </Layout>
  </t>

</templates>
