<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
  <t t-name="int_filemanager.v2.MoveDialog">
    <Dialog title="props.title" size="'md'">
      <div class="o_int_filemanager_move_tree">
        <FolderTree activeId="state.target" onSelectFolder.bind="onSelectFolder" />
      </div>
      <t t-set-slot="footer">
        <button
          class="btn btn-primary"
          t-att-disabled="!state.target"
          t-on-click="onConfirm"
          t-esc="props.confirmLabel"
        />
        <button
          class="btn btn-secondary"
          t-on-click="() => this.props.close()"
        >Cancel</button>
      </t>
    </Dialog>
  </t>
</templates>
