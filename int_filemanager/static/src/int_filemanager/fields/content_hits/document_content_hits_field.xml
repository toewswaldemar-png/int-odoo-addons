<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="int_filemanager.DocumentContentHitsField">
        <div class="o_int_filemanager_hits">
            <a
                t-foreach="hits"
                t-as="hit"
                t-key="hit.page"
                role="button"
                class="o_int_filemanager_hit d-block text-reset text-decoration-none text-truncate"
            >
                <span class="text-muted me-1" t-out="label(hit)" />
                <t t-foreach="hit.parts" t-as="part" t-key="part_index">
                    <span
                        t-att-class="{ 'bg-warning bg-opacity-50 rounded-1': part[1] }"
                        t-out="part[0]"
                    />
                </t>
            </a>
        </div>
    </t>
</templates>
