<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="int_filemanager.DocumentContentHitsField">
        <div class="o_int_filemanager_hits">
            <div
                t-foreach="hits"
                t-as="hit"
                t-key="hit_index"
                class="o_int_filemanager_hit text-truncate"
                t-att-data-hit-index="hit_index"
            >
                <span class="text-muted me-1" t-out="label(hit)" />
                <t t-foreach="hit.parts" t-as="part" t-key="part_index">
                    <span t-att-class="{ 'fw-bold': part[1] }" t-out="part[0]" />
                </t>
            </div>
            <div t-if="more" class="text-muted small" t-out="moreLabel" />
        </div>
    </t>
</templates>
