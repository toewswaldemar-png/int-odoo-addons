<templates xml:space="preserve">
    <t t-name="int_filemanager.TextInputDialog" owl="1">
        <Dialog title="props.title" size="'sm'">
            <div class="p-2">
                <label t-if="props.label" class="form-label" t-esc="props.label"/>
                <input type="text" class="form-control" t-model="state.value"
                       t-on-keydown="onKeydown" t-ref="autofocus"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onConfirm" t-esc="props.confirmLabel"/>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Abbrechen</button>
            </t>
        </Dialog>
    </t>
</templates>
