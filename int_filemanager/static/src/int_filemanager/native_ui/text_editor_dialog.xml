<templates xml:space="preserve">
    <t t-name="int_filemanager.TextEditorDialog" owl="1">
        <Dialog title="props.title" size="'lg'">
            <CodeEditor value="state.value" onChange.bind="onChange" maxLines="30"/>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onSave" t-att-disabled="state.saving">Speichern</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Abbrechen</button>
            </t>
        </Dialog>
    </t>
</templates>
