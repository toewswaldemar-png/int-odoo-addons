<templates xml:space="preserve">
    <t t-name="int_filemanager.NameField">
        <div class="d-flex align-items-center gap-1 o_int_filemanager_name_cell">
            <button type="button" class="btn btn-link p-0 border-0 o_int_filemanager_open_form_icon"
                    t-on-click="onIconClick" data-tooltip="Details öffnen">
                <!-- text-primary statt text-warning (Nutzerkorrektur 2026-09-16, "nicht Odoo
                     nativ"): Odoos eigenes search_panel.xml faerbt ein Kategoriefeld-Icon ohne
                     eigene section.color-Konfiguration mit text-primary
                     ("!section.color ? 'text-primary' : ''", text-warning ist dort ausschliesslich
                     fuer type="filter"-Sections reserviert) - unser "Ordner" ist genau so ein
                     unkonfiguriertes Kategoriefeld, kein Filter. -->
                <i t-if="isDir" class="fa fa-folder fa-fw text-primary" role="img" aria-label="Ordner"/>
                <span t-else="" class="o_image" role="img" t-att-data-mimetype="pseudoMimetype"/>
            </button>
            <!-- t-model unterstuetzt beliebig tiefe Pfade (OWL-Compiler spaltet nur am letzten
                 Punkt, alles davor ist ein normaler JS-Ausdruck) - am OWL-2.x-Quellcode
                 gegengeprueft, kein Sonderfall fuer verschachtelte env-Zugriffe noetig. -->
            <input t-if="isRenaming" t-ref="renameInput"
                   class="o_int_filemanager_rename_input"
                   t-model="env.filemanagerRename.state.value"
                   t-on-keydown="onRenameKeydown"
                   t-on-blur="onRenameBlur"
                   t-on-click.stop="() => {}"/>
            <!-- Pfad-Unterzeile (Nutzerwunsch 2026-09-16, auf Desktop erweitert 2026-09-16): nur
                 bei aktiver Suche (env.searchModel.query.length, siehe showPath in
                 name_icon_field.js) - beim normalen Durchklicken der Ordner ist der Pfad
                 redundant zum Breadcrumb, erst bei Suchergebnissen ueber mehrere Ordner hinweg
                 hilft er zur Einordnung. Eigener flex-column-Wrapper statt des vorherigen
                 einzelnen <span>, damit Name und Pfad untereinander stehen, waehrend das Icon
                 links weiterhin ueber die volle Zeilenhoehe vertikal zentriert bleibt
                 (align-items-center auf dem Eltern-Flex-Container oben). -->
            <div t-else="" class="d-flex flex-column o_int_filemanager_name_text">
                <!-- o_int_filemanager_name_label: eigene Klasse statt sich auf .text-truncate
                     allein zu verlassen (Nutzerreport 2026-09-16: Rubberband-Ausschluss/Drag-
                     Startzone griff faelschlich ueber die GANZE Namensspalte statt nur ueber den
                     sichtbaren Namen - Ursache war .o_int_filemanager_name_cell als
                     Ausschluss-Selektor in native_list_renderer.js/filemanager_controller_mixin.js:
                     der umgebende Flex-Container UND dieser Wrapper hier (flex:1 1 auto, siehe
                     native_list_view.scss) fuellen die komplette, extra verbreiterte Spalte,
                     dieser <span> selbst bleibt als Inline-Element aber exakt textgross). Beide
                     Stellen zielen jetzt auf diese Klasse (bzw. den Icon-Button) statt auf den
                     ganzen Zellen-Container - siehe Kommentare dort. -->
                <span class="text-truncate o_int_filemanager_name_label" t-esc="value"/>
                <!-- Ersetzt die "Größe"/"Geändert"-Spalten auf Desktop (Nutzerwunsch 2026-09-16,
                     siehe showSizeDate/sizeDateText in name_icon_field.js). Vor der Pfad-
                     Unterzeile: Groesse/Datum sind immer relevant, der Pfad nur bei aktiver
                     Suche - die haeufigere Information steht damit naeher am Namen. -->
                <span t-if="showSizeDate" class="text-truncate text-muted small" t-esc="sizeDateText"/>
                <span t-if="showPath and parentPath" class="text-truncate text-muted small" t-esc="parentPath"/>
            </div>
        </div>
    </t>
</templates>
