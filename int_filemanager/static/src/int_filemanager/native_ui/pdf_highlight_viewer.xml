<templates xml:space="preserve">
    <t t-name="int_filemanager.PdfHighlightViewer" owl="1">
        <div class="o_int_pdf_highlight_viewer" t-ref="container" t-on-wheel="onWheel">
            <div t-if="state.error" class="text-muted p-3">
                Vorschau konnte nicht geladen werden.
            </div>
            <div t-else="" class="o_int_pdf_highlight_canvas_wrap position-relative"
                 t-on-dblclick="onDblClick">
                <canvas t-ref="canvas"/>
                <div t-foreach="pageBoxes" t-as="box" t-key="box.key"
                     class="o_int_pdf_highlight_box"
                     t-att-class="{ 'o_int_pdf_highlight_box_active': isActive(box) }"
                     t-att-style="boxStyle(box)"
                     t-on-click="() => this.props.onBoxClick?.(box)"/>
            </div>
        </div>
    </t>
</templates>
