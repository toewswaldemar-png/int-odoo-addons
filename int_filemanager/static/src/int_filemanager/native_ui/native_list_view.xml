<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Replaces the native "New" button slot (guarded by activeActions.create,
         which is false here - arch has create="false") with our own always-visible
         "Neu"-Dropdown ("Neuer Ordner"/"Hochladen"), wired to IntFilemanagerListController
         methods that call the existing authz-checked /int_filemanager/* routes. Native
         Dropdown/DropdownItem (Nutzerwunsch 2026-09-07, statt zwei einzelner Buttons) -
         dasselbe Baukasten-Paar, das Odoo selbst z.B. in control_panel.xml
         (SearchBarMenu/embeddedActionsDropdown) fuer genau dieses Toggle-plus-Menue-Muster
         nutzt; onSelected schliesst das Dropdown automatisch nach der Auswahl. -->
    <t t-name="int_filemanager.ListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="replace">
            <t t-set-slot="control-panel-create-button">
                <Dropdown>
                    <button type="button" class="btn btn-primary text-nowrap o-dropdown-caret">
                        Neu
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem onSelected="() => this.onNewFolder()">Neuer Ordner</DropdownItem>
                        <DropdownItem onSelected="() => this.triggerUpload()">Hochladen</DropdownItem>
                    </t>
                </Dropdown>
                <input type="file" t-ref="fileInput" multiple="multiple" class="d-none" t-on-change="onFileInputChange"/>
            </t>
        </xpath>
        <!-- Chatter-Panel-Toggle rechts aussen neben dem Pager statt links bei den
             Erfassungs-Buttons (Nutzerfeedback 2026-09-06: dort schlecht platziert) -
             derselbe native Slot, in dem Odoo selbst den Filter/Gruppieren-Toggle rendert
             (control_panel.xml: ".o_control_panel_navigation", direkt nach dem Pager).
             Selbes Icon (oi-panel-right) wie der native Ordnerbaum-Ein-/Ausklapp-Button
             links, fuer Wiedererkennbarkeit. -->
        <xpath expr="//t[@t-set-slot='control-panel-navigation-additional']" position="inside">
            <!-- o_int_filemanager_chatter_toggle: eigene Klasse nur zum Wiedererkennen in
                 native_list_renderer.js' onDocumentClick-Deselektierung (Nutzerreport
                 2026-09-17: Klick auf diesen Button hob eine bestehende Zeilenauswahl auf,
                 bevor der Chatter sie ueberhaupt anzeigen konnte - der Button sitzt im
                 Control-Panel, das per Absicht als "ausserhalb der Liste" gilt, siehe
                 Kommentar dort). Kein Layout-/Optik-Zweck. -->
            <button type="button" class="btn btn-secondary text-nowrap o_int_filemanager_chatter_toggle"
                    t-att-class="{ active: chatterState.open }"
                    title="Notizen/Aktivitäten anzeigen"
                    t-on-click="onToggleChatterPanel">
                <i class="oi oi-panel-right fa-flip-horizontal"/>
            </button>
        </xpath>
        <!-- Rein visuelles Overlay - das eigentliche Drop-Handling laeuft komplett ueber die
             window-Listener aus setup() (siehe dortigen Kommentar), unabhaengig davon, ob dieses
             Overlay gerade im DOM ist. Deshalb pointer-events: none (native_list_view.scss) -
             es soll nichts abfangen, nur anzeigen. -->
        <!-- Eigener Mobil-Header, gated auf env.isSmall (Odoos ui-Service, 768px-Schwellwert) -
             komplett additiv. Der native Control Panel wird auf demselben Breakpoint per CSS
             ausgeblendet (native_list_view.scss), dieser Header uebernimmt seine Rolle auf
             schmalem Viewport. Reihenfolge (Nutzerwunsch 2026-09-15): Suchleiste zuerst, danach
             eine eigene Zeile mit Home-Button, Baum-Toggle und echtem Breadcrumb-Pfad (ersetzt
             die vorherige "<- Ordnername"-Zeile) - landet damit zwischen Suchleiste und dem
             nativen Listenkopf (Status/Name/...), der als naechstes im DOM folgt. Nutzt dieselbe
             Breadcrumb-Kette wie updateBreadcrumbs() (filemanager_controller_mixin.js) ueber den
             dortigen mobileBreadcrumbs-Helfer - kein zweiter Navigationszustand. -->
        <!-- Desktop-Ordnerbaum-Seitenleiste (folder_tree.js, ersetzt seit 2026-09-16 Odoos
             natives SearchPanel-Kategoriefeld - siehe native_search_model.js/project_
             int_filemanager_searchpanel_perf-Notiz fuer die Begruendung). position:fixed statt
             eines echten Flex-Sibling-Layouts (siehe Kommentar in filemanager_controller_mixin.js:
             setup()) - top sitzt als reine CSS-Konstante in folder_tree_layout.scss (Odoos eigene
             Navbar-Hoehe, kein JS-Messwert mehr), haelt sie direkt unterhalb der Navbar, ueber die
             volle Hoehe inklusive der eigenen Toolbar-Zeile (wie in einem echten Datei-Explorer).
             Nur auf breitem Viewport gerendert (dort uebernimmt der Ordnerbaum als Bottom-Sheet
             weiter unten dieselbe Rolle). -->
        <xpath expr="//div[@t-ref='root']/*[1]" position="before">
            <div t-if="!env.isSmall"
                 class="o_int_filemanager_tree_sidebar">
                <!-- Direkt env.searchModel.intFilemanagerFolderPath statt this.currentPath
                     (Nutzerreport 2026-09-16 "nach F5 in einem Unterordner bleibt der Ordnerbaum
                     zurueckgesetzt"): currentPath wird bewusst erst in onMounted() gesetzt
                     (siehe der ausfuehrliche Absturz-Kommentar bei updateBreadcrumbs()/setup()
                     in filemanager_controller_mixin.js), Owl mountet Kind-Komponenten aber VOR
                     dem eigenen onMounted() der Eltern-Komponente - FolderTree las activePath
                     beim eigenen ersten Mount deshalb, BEVOR der Controller currentPath ueberhaupt
                     gesetzt hatte, und blieb dadurch nach einem echten Reload (der URL-Fix in
                     native_search_model.js macht intFilemanagerFolderPath dort jetzt tatsaechlich
                     wiederherstellbar) beim leeren Ausgangswert haengen. intFilemanagerFolderPath
                     selbst ist dagegen schon synchron in WithSearch's onWillStart korrekt gesetzt,
                     lange bevor irgendeine Kind-Komponente hier ueberhaupt rendert. -->
                <FolderTree activePath="env.searchModel.intFilemanagerFolderPath || ''"
                            onSelectFolder="(path, hasChildren) => this.onFolderTreeSelect(path, hasChildren)"
                            registerApi="(api) => this.folderTreeApi = api"/>
            </div>
            <div t-if="env.isSmall"
                 class="o_int_filemanager_mobile_header">
                <div class="d-flex align-items-center gap-1">
                    <!-- "Neu"-Dropdown fuer Mobil (Nutzerwunsch 2026-09-16, Position/Optik
                         2026-09-16 Folgeanpassung: links neben die Suchleiste statt rechts davon,
                         Optik jetzt btn-primary/o-dropdown-caret statt btn-link-Icon - identischer
                         Klassen-Satz wie der originale Desktop-"Neu"-Button oben
                         (control-panel-create-button-Slot), fuer echte Odoo-native Optik statt
                         eines blossen Icon-Links. Der native Control-Panel-Mechanismus, ueber den
                         dieser Button normalerweise laeuft, ist auf schmalem Viewport per CSS
                         ausgeblendet (native_list_view.scss, env.isSmall), deshalb fehlte
                         Hochladen/Neuer-Ordner bislang komplett auf Mobil (Nutzerreport).
                         Dieselben Controller-Methoden (onNewFolder/triggerUpload) wie am Desktop -
                         nur "Neu"-Text weggelassen (kein Platz neben der Suchleiste), das
                         o-dropdown-caret-Kaeppchen bleibt als visueller Hinweis auf das Menue
                         dahinter erhalten. -->
                    <Dropdown class="flex-shrink-0">
                        <button type="button" class="btn btn-primary text-nowrap px-2" aria-label="Neu">
                            <i class="fa fa-plus"/>
                        </button>
                        <t t-set-slot="content">
                            <DropdownItem onSelected="() => this.onNewFolder()">Neuer Ordner</DropdownItem>
                            <DropdownItem onSelected="() => this.triggerUpload()">Hochladen</DropdownItem>
                        </t>
                    </Dropdown>
                    <!-- Eigenstaendige native Komponente (kein ControlPanel-Zwang, nur
                         env.searchModel noetig) - liefert Textsuche/Facetten/Filtermenue, ohne den
                         Rest der Toolbar (Neu/Pager/Ansichtsumschalter) zurueckzuholen.
                         autofocus="false", sonst poppt bei jedem Ordnerwechsel die Tastatur auf.
                         flex-grow-1, damit die Suchleiste den restlichen Platz ausfuellt statt
                         shrink-to-fit. -->
                    <div class="flex-grow-1">
                        <SearchBar autofocus="false"/>
                    </div>
                    <!-- Eigenes Datei-Input fuer triggerUpload() (t-ref="fileInput") - das
                         gleichnamige Input im control-panel-create-button-Slot oben ist auf
                         Mobil nie im DOM (Slot rendert nur bei aktivem Control Panel), Owls
                         useRef("fileInput") im Controller loest sich aber ohnehin dynamisch auf
                         das jeweils aktuell gemountete Element mit diesem Namen auf - beide
                         Stellen schliessen sich pro Einbettung gegenseitig aus (Desktop-Action
                         hat nie den Mobil-Header-Kontext, die Mobil-Einbettung nie den Control
                         Panel), also keine Kollision. -->
                    <input type="file" t-ref="fileInput" multiple="multiple" class="d-none" t-on-change="onFileInputChange"/>
                </div>
                <div class="o_int_filemanager_mobile_breadcrumb_row d-flex align-items-center gap-1">
                    <!-- Oeffnet das Ordnerbaum-Bottom-Sheet (dieselbe FolderTree-Komponente wie die
                         Desktop-Seitenleiste, siehe onToggleMobileTree/native_list_view.scss). Nutzerwunsch
                         2026-09-15: "Alle Ordner" im Breadcrumb daneben deckt die Wurzel-Navigation
                         schon ab (mobileBreadcrumbs[0].onSelected ruft dasselbe onMobileGoHome auf)
                         - der Home-Button war dadurch redundant und wird stattdessen fuer den Baum
                         wiederverwendet. Kein Doppelbelegungs-Problem mehr (siehe fruehere
                         Ueberlegung dazu): der Button hat jetzt genau eine, eindeutige Funktion. -->
                    <!-- Eigentliches Problem war nicht die Button-Optik, sondern das falsche Icon
                         (Nutzerfeedback 2026-09-16 "sieht nicht odoo nativ aus, gefrickel"):
                         fa-home suggeriert "zur Wurzel springen" - das erledigt aber schon der
                         Text-Link "Alle Ordner" direkt daneben (mobileBreadcrumbs[0], ruft
                         dasselbe onMobileGoHome() auf). Dieser Button tut etwas anderes - er
                         oeffnet den Ordnerbaum (onToggleMobileTree) - dafuer nutzt Odoo selbst
                         nativ oi-panel-right (siehe web.SearchPanel.Sidebar UND unser eigener
                         Chatter-Toggle-Button oben in dieser Datei, identisches Icon fuer
                         denselben "Seitenpanel ein-/ausklappen"-Zweck). Schlichtes
                         btn-link (kein Rahmen/Box) statt der vorherigen
                         btn-light/btn-outline-secondary-Versuche - ein Icon in der Breadcrumb-
                         Zeile braucht keinen eigenen Button-Koerper, das wirkte neben dem
                         Fliesstext zusammengestueckelt. -->
                    <button type="button" class="btn btn-link p-1 flex-shrink-0 o_int_filemanager_mobile_tree_toggle"
                            aria-label="Ordnerbaum" t-on-click="onToggleMobileTree">
                        <i class="oi oi-fw oi-panel-right fa-flip-horizontal"/>
                    </button>
                    <!-- t-ref hier: _checkMobileBreadcrumbOverflow() (filemanager_controller_mixin.js)
                         misst scrollWidth/clientWidth genau dieses Elements, um bei zu langem Pfad
                         auf die kollabierte Darstellung (unten) umzuschalten statt horizontal zu
                         scrollen. -->
                    <nav t-ref="mobileBreadcrumbNav" class="o_int_filemanager_mobile_breadcrumb d-flex align-items-center flex-nowrap overflow-auto">
                        <t t-if="!mobileBreadcrumbState.collapsed or mobileBreadcrumbs.length lt 3">
                            <!-- flex-shrink-0 + text-nowrap auf JEDEM Segment ist hier Pflicht,
                                 nicht Kosmetik: mit "text-truncate" (overflow:hidden) haette jedes
                                 Segment einzeln schrumpfen und sich selbst ellipsieren koennen -
                                 live als Bug gefunden 2026-09-15 (Nutzerscreenshot: "Alle O... /
                                 Tra... / Mitar... / ..." - jedes Segment abgeschnitten statt
                                 kollabiert), dadurch overflowte die Zeile nie wirklich
                                 (scrollWidth blieb <= clientWidth) und
                                 _checkMobileBreadcrumbOverflow() loeste nie aus. Jetzt darf die
                                 Zeile echt ueberlaufen, erst DANN greift die Kollabierung unten. -->
                            <t t-foreach="mobileBreadcrumbs" t-as="crumb" t-key="crumb.jsId">
                                <span t-if="!crumb_first" class="text-muted mx-1 flex-shrink-0">/</span>
                                <span t-if="crumb_last" class="fw-bold text-nowrap flex-shrink-0" t-esc="crumb.name"/>
                                <button t-else="" type="button" class="btn btn-link p-0 text-nowrap flex-shrink-0"
                                        t-on-click="() => crumb.onSelected()">
                                    <t t-esc="crumb.name"/>
                                </button>
                            </t>
                        </t>
                        <!-- Kollabiert: erstes Segment (meist "Alle Ordner"), Dropdown mit allen
                             verdeckten Zwischenordnern, letztes Segment (aktueller Ordner, fett,
                             nicht klickbar - dieselbe Konvention wie bei der vollen Darstellung
                             oben). Nur ab 3 Segmenten ueberhaupt etwas zu verbergen. -->
                        <t t-else="">
                            <button type="button" class="btn btn-link p-0 text-truncate flex-shrink-0"
                                    t-on-click="() => mobileBreadcrumbs[0].onSelected()">
                                <t t-esc="mobileBreadcrumbs[0].name"/>
                            </button>
                            <span class="text-muted mx-1">/</span>
                            <Dropdown>
                                <span class="btn btn-link p-0">…</span>
                                <t t-set-slot="content">
                                    <t t-foreach="mobileBreadcrumbs.slice(1, -1)" t-as="hiddenCrumb" t-key="hiddenCrumb.jsId">
                                        <DropdownItem onSelected="() => hiddenCrumb.onSelected()">
                                            <t t-esc="hiddenCrumb.name"/>
                                        </DropdownItem>
                                    </t>
                                </t>
                            </Dropdown>
                            <span class="text-muted mx-1">/</span>
                            <span class="fw-bold text-truncate"
                                  t-esc="mobileBreadcrumbs[mobileBreadcrumbs.length - 1].name"/>
                        </t>
                    </nav>
                </div>
                <!-- Backdrop zum Schliessen per Antippen ausserhalb des Bottom-Sheets - liegt in
                     derselben Overlay-Ebene direkt unter dem Sheet (native_list_view.scss). -->
                <div t-if="mobileTreeState.open" class="o_int_filemanager_mobile_tree_backdrop"
                     t-on-click="onToggleMobileTree"/>
                <!-- Ordnerbaum-Bottom-Sheet - dieselbe FolderTree-Komponente wie die Desktop-
                     Seitenleiste oben, nur per CSS als Sheet positioniert statt fest links (siehe
                     native_list_view.scss: .o_int_filemanager_tree_sheet). Immer gemountet (nicht
                     nur bei open, damit der Baum-Zustand/Cache beim wiederholten Auf-/Zuklappen
                     erhalten bleibt), Sichtbarkeit ausschliesslich per CSS-Klasse
                     (o_int_filemanager_mobile_tree_open, siehe native_list_view.js: className). -->
                <div class="o_int_filemanager_tree_sheet">
                    <FolderTree activePath="env.searchModel.intFilemanagerFolderPath || ''"
                                onSelectFolder="(path, hasChildren) => this.onFolderTreeSelect(path, hasChildren)"
                                registerApi="(api) => this.folderTreeApi = api"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@t-ref='root']" position="inside">
            <div t-if="dropState.dragging" class="o_int_filemanager_dropzone">
                <div class="o_int_filemanager_dropzone_label">
                    <i class="fa fa-cloud-upload me-2"/>Dateien hier ablegen zum Hochladen
                </div>
            </div>
            <!-- Chatter-Seitenpanel (Baustein 2, docs/int_filemanager_paperoffice_recherche.md) -
                 ueberlagerndes Fixed-Panel statt Platz verdraengendem Flex-Sibling neben der
                 Liste, siehe Begruendung in native_list_view.js (setup()). topPx via JS
                 vermessen, damit es exakt unter der eigenen Toolbar beginnt. -->
            <div t-if="chatterState.open" class="o_int_filemanager_chatter_panel"
                 t-attf-style="top: {{chatterState.topPx}}px;">
                <div class="o_int_filemanager_chatter_panel_header">
                    <span class="text-truncate fw-bold">
                        <t t-if="chatterRecord" t-esc="chatterRecord.data.name"/>
                        <t t-else="">Notizen/Aktivitäten</t>
                    </span>
                    <button type="button" class="btn-close" aria-label="Schließen"
                            t-on-click="onToggleChatterPanel"/>
                </div>
                <div t-if="!chatterRecord" class="text-muted p-3">
                    Datei oder Ordner in der Liste per Checkbox auswählen, um Notizen/Aktivitäten
                    zu sehen.
                </div>
                <Chatter t-else="" threadModel="'int_filemanager.file'"
                         threadId="chatterRecord.resId"
                         isChatterAside="true" isInFormSheetBg="false"/>
            </div>
        </xpath>
    </t>

</templates>
