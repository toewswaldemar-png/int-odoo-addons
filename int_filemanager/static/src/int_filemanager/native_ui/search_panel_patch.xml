<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Ordnerbaum in der Seitenleiste als Drop-Ziel fuer Verschieben per Drag&Drop
         (2026-09-07, Nutzerwunsch) - Odoos geteiltes web.SearchPanel.Category-Template traegt
         keinerlei natives Identifikations-Attribut pro Baumeintrag (anders als List-Zeilen/
         Kanban-Karten mit ihrem nativen data-id, siehe filemanager_controller_mixin.js), also
         additiv per t-inherit-mode="extension" (gleiche Technik wie file_viewer_patch.xml)
         ergaenzt. Gilt fuer JEDEN Kategorie-Baum im System (z.B. Produktkategorien), bleibt
         aber folgenlos ausserhalb dieses Addons: das Attribut ist ein reiner Datentraeger, den
         nur unser eigener Drag&Drop-Code liest, und der nur reagiert, wenn der gezogene
         dataTransfer-Typ von einem unserer eigenen Zeilen/Karten-Drags stammt (siehe
         onWindowDragOverRecord/onWindowDropRecord).

         t-attf- statt t-att- bewusst: der Wurzel-Wert ("Alle") hat valueId===false (JS-
         boolean) - t-att- wuerde das Attribut fuer einen falsy-wertigen Ausdruck komplett
         weglassen (Owl-Konvention, analog zu React). ABER: live gegen Owls kompilierte
         Render-Funktion geprueft (Tower, 2026-09-07) zeigt, dass auch t-attf- mit dem reinen
         Ausdruck "{{valueId}}" das Attribut fuer diesen einen Eintrag komplett weglaesst statt
         "false" zu rendern (vermutlich blockdom-interne Sonderbehandlung von false, nicht nur
         eine t-att-Eigenheit) - alle anderen 37 von 38 Eintraegen (echte IDs) waren dagegen
         korrekt gesetzt. Deshalb hier explizit auf einen nie-falsy String "root" statt des
         rohen valueId gemappt; filemanager_controller_mixin.js's _dropTargetFromEvent()
         erkennt "root" statt "false" und liefert dafuer path="" (Wurzelordner). -->
    <t t-inherit="web.SearchPanel.Category" t-inherit-mode="extension">
        <xpath expr="//header[@t-on-click='() =&gt; this.toggleCategory(section, value)']" position="attributes">
            <attribute name="t-attf-data-int-filemanager-value-id">{{valueId === false ? 'root' : valueId}}</attribute>
        </xpath>
    </t>

    <!-- Mobil-Ordnerbaum-Bottom-Sheet (Nutzerwunsch 2026-09-15, filemanager_controller_mixin.js:
         onToggleMobileTree): web.SearchPanel rendert auf echter Telefonbreite (env.isSmall) immer
         nur seine kompakte Chip-Form (web.SearchPanel.Small), nie den vollen Baum
         (Regular/Sidebar) - live am Quellcode verifiziert (search_panel.xml:
         "<t t-if='env.isSmall'><t t-call='web.SearchPanel.Small'/></t>"). Unser eigenes
         Bottom-Sheet wuerde dort also nur eine verschachtelte Chip-Box zeigen, kein navigierbarer
         Baum - genau das Problem, das die Loesung eigentlich beheben soll. env.mobileTreeState
         (per useSubEnv in filemanager_controller_mixin.js gesetzt, nur innerhalb unserer eigenen
         Client-Action-Einbettung vorhanden, sonst schlicht undefined) laesst uns env.isSmall hier
         gezielt umgehen, waehrend unser Sheet offen ist - ausserhalb dieses einen Kontexts (jede
         andere SearchPanel im System) bleibt env.mobileTreeState undefined, die Bedingung also
         unveraendert env.isSmall. -->
    <t t-inherit="web.SearchPanel" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='env.isSmall']" position="attributes">
            <attribute name="t-if">env.isSmall and !(env.mobileTreeState and env.mobileTreeState.open)</attribute>
        </xpath>
    </t>

</templates>
