<templates xml:space="preserve">
    <!-- <button> bewusst als echtes HTML-<button>-Element (nicht z.B. <a>/<i> mit
         Klick-Handler) - list_renderer.js prueft bei einem Zeilenklick explizit
         ev.target.closest("button") und reicht nur bei Fehltreffer an die Zeilen-Navigation
         weiter. Die Bootstrap-Klassen sitzen bewusst HIER auf dem <button> selbst statt nur ueber das
         arch-"class"-Attribut (das landet laut view_compiler.js/compileWidget auf dem
         umschliessenden <div class="o_widget ...">, nicht auf diesem inneren Button) - so
         sieht der Button unabhaengig davon gleich aus, welche Positionierungs-Klasse die
         Liste/das Kanban von aussen mitgibt. -->
    <t t-name="int_filemanager.AnalyzeButtonWidget">
        <button t-if="visible" type="button" class="btn btn-sm p-0"
                data-tooltip="Werte erkennen" t-on-click="onClick">
            <i class="fa fa-magic"/>
        </button>
    </t>
</templates>
