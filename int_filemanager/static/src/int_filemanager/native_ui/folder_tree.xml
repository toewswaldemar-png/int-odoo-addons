<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="int_filemanager.FolderTree">
        <div class="o_int_filemanager_tree" role="tree">
            <t t-call="int_filemanager.FolderTreeNode">
                <t t-set="node" t-value="this.nodes['']"/>
                <t t-set="depth" t-value="0"/>
            </t>
        </div>
    </t>

    <!-- Rekursives Sub-Template (t-call ruft sich selbst fuer die Kinder auf) - dasselbe Grundmuster,
         das Odoo selbst fuer verschachtelte Kategorie-/Gruppierungsbaeume nutzt. t-call teilt sich
         "this" mit der aufrufenden Komponente (kein eigener Scope), Methodenaufrufe wie
         this.onClickNode() funktionieren deshalb hier genauso wie im Wurzel-Template oben. -->
    <t t-name="int_filemanager.FolderTreeNode">
        <div class="o_int_filemanager_tree_node" t-att-data-int-filemanager-tree-path="node.path || '__root__'">
            <header class="o_int_filemanager_tree_node_header d-flex align-items-center"
                    t-attf-style="padding-left: {{depth * 16 + 4}}px"
                    t-att-class="{ 'o_int_filemanager_tree_node_active': node.path === this.props.activePath }"
                    t-on-click="() => this.onClickNode(node)">
                <!-- Rein visuell, wie im nativen Vorbild (web.SearchPanel.Category:
                     <button class="o_toggle_fold" ...> ohne eigenen t-on-click) - der Klick wird
                     vom umgebenden <header> abgefangen, siehe onClickNode() in folder_tree.js. -->
                <button t-if="node.hasChildren" type="button"
                        class="btn btn-sm p-0 o_int_filemanager_tree_caret"
                        t-att-aria-label="node.expanded ? 'Ordner einklappen' : 'Ordner aufklappen'">
                    <i t-if="node.loading" class="fa fa-spin fa-spinner"/>
                    <i t-elif="node.expanded" class="fa fa-caret-down"/>
                    <i t-else="" class="fa fa-caret-right"/>
                </button>
                <span t-else="" class="o_int_filemanager_tree_caret_spacer"/>
                <i class="fa fa-folder o_int_filemanager_tree_folder_icon text-primary"/>
                <span class="text-truncate" t-esc="node.name"/>
            </header>
            <div t-if="node.expanded" class="o_int_filemanager_tree_children">
                <t t-foreach="node.children" t-as="childPath" t-key="childPath">
                    <t t-call="int_filemanager.FolderTreeNode">
                        <t t-set="node" t-value="this.nodes[childPath]"/>
                        <t t-set="depth" t-value="depth + 1"/>
                    </t>
                </t>
            </div>
        </div>
    </t>

</templates>
