<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="int_filemanager.DocumentPreview">
        <div class="o_int_filemanager_preview position-relative h-100 bg-dark">
            <DocumentFileViewer
                t-if="props.file.isViewable"
                t-key="props.file.id"
                files="[props.file]"
                startIndex="0"
                modal="false"
                onEdit="props.onEdit"
            />
            <div
                t-else=""
                class="d-flex flex-column align-items-center justify-content-center h-100 text-muted"
            >
                <i class="fa fa-file-o fa-4x mb-3" role="img" aria-hidden="true" />
                <span>There is no preview for this type of file.</span>
            </div>
        </div>
    </t>
</templates>
