<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="int_filemanager.DocumentPreviewButton">
        <button
            t-if="props.record.resId and file.isViewable"
            type="button"
            class="btn btn-secondary"
            t-on-click="onClick"
        >
            <i class="fa fa-eye me-1" role="img" aria-hidden="true" />
            Preview
        </button>
    </t>
</templates>
