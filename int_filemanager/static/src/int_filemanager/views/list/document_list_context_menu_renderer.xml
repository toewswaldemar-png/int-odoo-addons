<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="int_filemanager.DocumentListContextMenuRenderer"
        t-inherit="int_filemanager.DocumentListRenderer"
        t-inherit-mode="primary"
    >
        <!-- On the table, not on each row: the rows of the core's template are shared by the groups. -->
        <xpath expr="//table[@t-ref='table']" position="attributes">
            <attribute name="t-on-contextmenu">(ev) => this.onContextMenu(ev)</attribute>
        </xpath>
        <xpath expr="//table[@t-ref='table']" position="after">
            <Dropdown
                manual="true"
                noClasses="true"
                bottomSheet="false"
                focusToggleOnClosed="false"
                position="'bottom-start'"
                state="dropdownState"
            >
                <span class="o_int_filemanager_context_menu_anchor" t-ref="contextMenuAnchor" />
                <t t-set-slot="content">
                    <t t-foreach="contextMenu.sections" t-as="section" t-key="section_index">
                        <div t-if="section_index" role="separator" class="dropdown-divider" />
                        <t t-foreach="section" t-as="item" t-key="item.key">
                            <DropdownItem class="'o_menu_item'" onSelected="item.onSelected">
                                <i t-if="item.icon" t-att-class="item.icon + ' me-1 fa-fw oi-fw'" />
                                <t t-out="item.description" />
                            </DropdownItem>
                        </t>
                    </t>
                </t>
            </Dropdown>
        </xpath>
    </t>
</templates>
