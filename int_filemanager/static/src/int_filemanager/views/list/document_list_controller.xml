<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="int_filemanager.DocumentListView.Buttons"
        t-inherit="web.ListView.Buttons"
        t-inherit-mode="primary"
    >
        <xpath expr="." position="inside">
            <!-- The input is beside the menu: the menu is gone before the files are chosen. -->
            <input
                type="file"
                multiple="multiple"
                class="d-none"
                t-ref="fileInput"
                t-on-change.stop="onFilesSelected"
            />
            <input
                type="file"
                webkitdirectory=""
                multiple="multiple"
                class="d-none"
                t-ref="folderInput"
                t-on-change.stop="onFolderSelected"
            />
            <Dropdown t-if="canUpload or folderRights.create">
                <button class="btn btn-primary o-dropdown-caret" data-hotkey="c" data-bounce-button="">
                    New
                </button>
                <t t-set-slot="content">
                    <DropdownItem
                        t-if="canUpload"
                        class="'o_menu_item'"
                        onSelected="() => this.onUploadSelected()"
                    >
                        <i class="fa fa-fw fa-upload me-1" />Upload
                    </DropdownItem>
                    <DropdownItem
                        t-if="uploadFolderId and canUpload"
                        class="'o_menu_item'"
                        onSelected="() => this.onUploadFolderSelected()"
                    >
                        <i class="fa fa-fw fa-folder-open me-1" />Upload a folder
                    </DropdownItem>
                    <DropdownItem
                        t-if="foldersSection and folderRights.create"
                        class="'o_menu_item'"
                        onSelected="() => this.onNewFolder()"
                    >
                        <i class="fa fa-fw fa-folder me-1" />New folder
                    </DropdownItem>
                    <DropdownItem
                        t-if="uploadFolderId"
                        class="'o_menu_item'"
                        onSelected="() => this.onDownloadFolder()"
                    >
                        <i class="fa fa-fw fa-download me-1" />Download folder
                    </DropdownItem>
                </t>
            </Dropdown>
            <button
                t-elif="uploadFolderId"
                class="btn btn-secondary"
                t-on-click="() => this.onDownloadFolder()"
            >
                Download folder
            </button>
        </xpath>
    </t>
</templates>
