<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="int_filemanager.DocumentListContextMenu">
        <div t-on-click.capture="onClickCapture">
            <DropdownItem t-if="props.onView" onSelected="props.onView">View</DropdownItem>
            <t t-foreach="props.buttons" t-as="button" t-key="button.id">
                <DropdownItem class="'o-dropdown-item-unstyled-button'">
                    <MultiRecordViewButton
                        list="props.list"
                        className="button.className"
                        clickParams="button.clickParams"
                        defaultRank="'btn-secondary'"
                        domain="props.domain"
                        icon="button.icon"
                        string="button.string"
                        title="button.title"
                        attrs="button.attrs"
                    />
                </DropdownItem>
            </t>
        </div>
    </t>
</templates>
