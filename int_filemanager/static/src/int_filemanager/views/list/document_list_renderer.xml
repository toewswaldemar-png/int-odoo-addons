<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="int_filemanager.DocumentListRenderer"
        t-inherit="web.ListRenderer"
        t-inherit-mode="primary"
    >
        <!-- The thumbnail makes the name cell taller; the other cells follow its middle. -->
        <xpath expr="//table[@t-ref='table']" position="attributes">
            <attribute name="t-attf-class" separator=" " add="align-middle" />
        </xpath>
        <xpath expr="//table[@t-ref='table']" position="before">
            <FileUploadProgressContainer
                fileUploads="fileUploadService.uploads"
                Component="constructor.components.FileUploadProgressDataRow"
            />
        </xpath>
    </t>
</templates>
