<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="int_filemanager.DocumentFormController"
        t-inherit="web.FormView"
        t-inherit-mode="primary"
    >
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']" position="before">
            <t t-set-slot="control-panel-navigation-additional">
                <div t-if="model.root.resId" class="btn-group d-print-none" role="toolbar">
                    <button
                        t-if="file.isViewable"
                        type="button"
                        class="btn btn-secondary"
                        data-tooltip="Full screen"
                        aria-label="Full screen"
                        t-on-click="onFullScreen"
                    >
                        <i class="fa fa-expand" role="img" />
                    </button>
                    <a
                        class="btn btn-secondary"
                        data-tooltip="Download"
                        aria-label="Download"
                        t-att-href="file.downloadUrl"
                    >
                        <i class="fa fa-download" role="img" />
                    </a>
                </div>
                <div t-if="model.root.resId" class="btn-group d-print-none" role="toolbar">
                    <button
                        type="button"
                        class="btn btn-secondary"
                        t-att-class="{ 'active': panel.part === 'details' }"
                        data-tooltip="Details"
                        aria-label="Details"
                        t-on-click="() => this.togglePanel('details')"
                    >
                        <i class="fa fa-info-circle" role="img" />
                    </button>
                    <button
                        type="button"
                        class="btn btn-secondary"
                        t-att-class="{ 'active': panel.part === 'chatter' }"
                        data-tooltip="Chatter"
                        aria-label="Chatter"
                        t-on-click="() => this.togglePanel('chatter')"
                    >
                        <i class="fa fa-comments-o" role="img" />
                    </button>
                </div>
            </t>
        </xpath>
        <xpath expr="//Layout/t[@t-component='props.Renderer']" position="replace">
            <div class="o_int_filemanager_document d-flex flex-column flex-lg-row h-100">
                <div class="o_int_filemanager_document_file flex-grow-1">
                    <DocumentPreview file="file" onEdit="onEdit" />
                </div>
                <ResizablePanel
                    t-if="panel.part"
                    t-key="panel.part"
                    class="'o_int_filemanager_document_panel border-top border-lg-start'"
                    handleSide="'start'"
                    initialWidth="panelStartWidth"
                    minWidth="panelMinWidth"
                    onResize.bind="onPanelResize"
                >
                    <div class="h-100 overflow-auto">
                        <t t-if="panel.part === 'details'">$0</t>
                        <Chatter t-else="" t-key="model.root.resId" t-props="chatterProps" />
                    </div>
                </ResizablePanel>
            </div>
        </xpath>
    </t>
</templates>
