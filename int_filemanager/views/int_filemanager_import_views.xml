<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_import_view_list" model="ir.ui.view">
        <field name="name">int.filemanager.import.view.list</field>
        <field name="model">int.filemanager.import</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="source_path" />
                <field name="target_folder_id" />
                <field name="state" widget="badge" />
                <field name="progress" widget="progressbar" />
                <field name="company_id" groups="base.group_multi_company" optional="hide" />
            </list>
        </field>
    </record>

    <record id="int_filemanager_import_view_form" model="ir.ui.view">
        <field name="name">int.filemanager.import.view.form</field>
        <field name="model">int.filemanager.import</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header>
                    <button
                        name="action_scan"
                        type="object"
                        string="Check"
                        class="btn-primary"
                        invisible="state not in ('draft', 'scanned')"
                        help="Lists the folder and shows what would be read in. Nothing is copied."
                    />
                    <button
                        name="action_start"
                        type="object"
                        string="Read in"
                        class="btn-primary"
                        invisible="state != 'scanned'"
                        confirm="The files of the folder are copied into the filemanager. The files on the disk stay as they are."
                    />
                    <button
                        name="action_stop"
                        type="object"
                        string="Stop"
                        invisible="state not in ('scanning', 'running')"
                    />
                    <button
                        name="action_retry_errors"
                        type="object"
                        string="Retry the failed"
                        invisible="state != 'done' or not error_count"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,scanned,running,done"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                            invisible="not line_count"
                        >
                            <field name="line_count" widget="statinfo" string="Lines" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. Test seminars" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="root_path" />
                            <field
                                name="source_path"
                                readonly="state not in ('draft', 'scanned')"
                                placeholder="Empty: the whole root folder"
                            />
                            <field
                                name="target_folder_id"
                                readonly="state not in ('draft', 'scanned')"
                            />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group invisible="not message">
                            <field name="message" />
                        </group>
                    </group>
                    <group string="Report" invisible="state == 'draft'">
                        <group>
                            <field name="progress" widget="progressbar" />
                            <field name="folder_count" />
                            <field name="file_count" />
                            <field name="total_size" widget="int_filemanager_size" />
                        </group>
                        <group>
                            <field name="pending_count" />
                            <field name="done_count" />
                            <field name="skipped_count" />
                            <field name="excluded_count" />
                            <field name="clash_count" />
                            <field name="error_count" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="int_filemanager_import_action" model="ir.actions.act_window">
        <field name="name">Import</field>
        <field name="res_model">int.filemanager.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="int_filemanager_import_menu"
        name="Import"
        parent="menu_int_filemanager_root"
        action="int_filemanager_import_action"
        groups="int_filemanager.int_filemanager_group_admin"
        sequence="20"
    />
</odoo>
