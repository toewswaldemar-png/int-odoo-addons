<odoo>
    <record id="view_filemanager_protected_folder_list" model="ir.ui.view">
        <field name="name">int_filemanager.protected_folder.list</field>
        <field name="model">int_filemanager.protected_folder</field>
        <field name="arch" type="xml">
            <list>
                <field name="path"/>
                <field name="read_group_ids" widget="many2many_tags"/>
                <field name="write_group_ids" widget="many2many_tags"/>
                <field name="unlink_group_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_filemanager_protected_folder_form" model="ir.ui.view">
        <field name="name">int_filemanager.protected_folder.form</field>
        <field name="model">int_filemanager.protected_folder</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="path" placeholder="z.B. Buchhaltung/Gehaltsdaten"/>
                        <field name="read_group_ids" widget="many2many_tags"/>
                        <field name="write_group_ids" widget="many2many_tags"/>
                        <field name="unlink_group_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_filemanager_protected_folder" model="ir.actions.act_window">
        <field name="name">Geschützte Ordner</field>
        <field name="res_model">int_filemanager.protected_folder</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_int_filemanager_protected_folders"
              name="Geschützte Ordner"
              parent="menu_int_filemanager_configuration"
              action="action_filemanager_protected_folder"
              groups="int_filemanager.group_filemanager_admin"
              sequence="10"/>
</odoo>
