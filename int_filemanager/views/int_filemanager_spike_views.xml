<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- SPIKE (throw-away): the views of the guest page. The gateway names them itself; the
         client never chooses a view. Lean copies of the internal views: no widget of another
         module (list_activity), no button of type object, no full text search. -->
    <record id="int_filemanager_document_view_guest_list" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.guest.list</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <list
                js_class="int_filemanager_guest_list"
                create="0"
                edit="0"
                delete="0"
                import="0"
                export_xlsx="0"
                duplicate="0"
            >
                <field name="name" widget="int_filemanager_document_name" />
                <field name="folder_id" options="{'no_open': True}" />
                <field name="size" widget="int_filemanager_size" />
                <field name="write_date" string="Modified" />
                <field name="tag_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="int_filemanager_document_view_guest_kanban" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.guest.kanban</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <kanban
                js_class="int_filemanager_guest_kanban"
                create="0"
                edit="0"
                delete="0"
                quick_create="0"
                group_create="0"
            >
                <field name="checksum" />
                <field name="ocr_checksum" />
                <templates>
                    <t t-name="card">
                        <field name="mimetype" widget="int_filemanager_document_thumbnail" />
                        <field name="name" class="fw-bold text-truncate d-block mt-2" />
                        <div class="o_int_filemanager_card_meta">
                            <div class="d-flex justify-content-between text-muted small">
                                <field name="folder_id" class="text-truncate" />
                                <field name="size" widget="int_filemanager_size" />
                            </div>
                            <field name="tag_ids" widget="many2many_tags" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="int_filemanager_document_view_guest_search" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.guest.search</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="folder_id" />
                <field name="tag_ids" />
                <filter name="filter_pdf" string="PDF" domain="[('mimetype', '=', 'application/pdf')]" />
                <filter name="filter_image" string="Images" domain="[('mimetype', '=like', 'image/%')]" />
                <group>
                    <filter name="group_by_folder" string="Folder" context="{'group_by': 'folder_id'}" />
                    <filter name="group_by_mimetype" string="Mimetype" context="{'group_by': 'mimetype'}" />
                    <filter name="group_by_tag" string="Tags" context="{'group_by': 'tag_ids'}" />
                </group>
                <searchpanel view_types="list,kanban">
                    <field
                        name="folder_id"
                        string="Folders"
                        icon="fa-folder"
                        expand="1"
                        limit="0"
                    />
                    <field
                        name="tag_ids"
                        select="multi"
                        string="Tags"
                        icon="fa-tags"
                        expand="1"
                    />
                </searchpanel>
            </search>
        </field>
    </record>

    <template id="spike_page" name="Filemanager guest spike">
        <t t-call="web.layout">
            <t t-set="title">Filemanager (guest spike)</t>
            <t t-set="body_classname" t-value="'o_web_client'" />
            <t t-set="head">
                <script>
                    odoo.__session_info__ = <t t-out="json.dumps(session_info)" />;
                    odoo.int_filemanager_token = <t t-out="json.dumps(token)" />;
                    odoo.int_filemanager_folder_name = <t t-out="json.dumps(folder_name)" />;
                </script>
                <t t-call-assets="int_filemanager.assets_guest" />
            </t>
        </t>
    </template>
</odoo>
