<odoo>
    <record id="int_filemanager_file_search" model="ir.ui.view">
        <field name="name">int_filemanager.file.search</field>
        <field name="model">int_filemanager.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Name"/>
                <field name="tag_ids" string="Tags"/>
                <filter name="filter_folders" string="Nur Ordner" domain="[('is_dir','=',True)]"/>
                <filter name="filter_files" string="Nur Dateien" domain="[('is_dir','=',False)]"/>
                <separator/>
                <filter name="filter_tagged" string="Mit Tags" domain="[('tag_ids','!=',False)]"/>
                <filter name="filter_untagged" string="Ohne Tags" domain="[('tag_ids','=',False)]"/>
                <!-- <searchpanel> mit parent_id-Ordnerbaum bewusst wieder entfernt (2026-09-04):
                     ein einziger Klick auf einen Baumknoten bringt props.domain dauerhaft aus dem
                     Tritt mit jeder folgenden normalen Zeilen-/Breadcrumb-Navigation - selbst ein
                     unbedingter this.model.load({domain:[...]})-Aufruf im Controller, der
                     props.domain gar nicht mehr referenziert, wird danach zuverlaessig von einem
                     nativen, nicht kontrollierbaren Reload ueberschrieben (RelationalModel-interne
                     Reaktivitaet auf Domain-Prop-Aenderungen, mehrfach live nachvollzogen, siehe
                     docs/int_filemanager_native_ui.md, Abschnitt "SearchPanel-Ordnerbaum-Klick <->
                     Zeilennavigation"). Backend (parent_id/_parent_store/Scan/
                     search_panel_select_range-Override) bleibt vollstaendig fertig und getestet -
                     nur die UI-Einbindung hier ist zurueckgestellt, bis das RelationalModel-
                     Verhalten tiefer verstanden ist. -->
            </search>
        </field>
    </record>
</odoo>
