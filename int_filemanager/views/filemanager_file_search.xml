<odoo>
    <record id="int_filemanager_file_search" model="ir.ui.view">
        <field name="name">int_filemanager.file.search</field>
        <field name="model">int_filemanager.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Name"/>
                <field name="tag_ids" string="Tags"/>
                <field name="status_id"/>
                <!-- Baustein 1 (docs/int_filemanager_paperoffice_recherche.md): reiht sich ohne
                     jede JS-Aenderung automatisch ins bestehende "Search X for: Y"-Dropdown ein,
                     inkl. der bereits gebauten rekursiven Suche (search_model_patch.js). Einfaches
                     ilike auf einem Text-Feld fuer v1 - kein tsvector/Ranking, bewusst erst bei
                     echtem Bedarf nachruesten statt vorzeitig zu optimieren. -->
                <field name="content_text" string="Inhalt"/>
                <filter name="filter_folders" string="Nur Ordner" domain="[('is_dir','=',True)]"/>
                <filter name="filter_files" string="Nur Dateien" domain="[('is_dir','=',False)]"/>
                <separator/>
                <!-- War standardmaessig aktiv (search_default_filter_hide_lock_files im Context
                     der Action) - Nutzerentscheidung 2026-09-14 zurueckgenommen: ein staendig
                     aktiver Chip belegt permanent Platz im Suchleisten-Container (Odoo-nativ
                     "flex-wrap" dort, siehe filemanager_file_list_view.xml), was die Suchleiste
                     auf schmalen Bildschirmen schon allein dadurch auf zwei Zeilen kippen liess.
                     Filter bleibt bestehen, nur eben nicht mehr vorausgewaehlt - manuell im
                     Filter-Menue aktivierbar, wenn Sperrdateien (z.B. eine haengende Word/Excel-
                     Sperrdatei "~$Dateiname.docx") ausgeblendet werden sollen. Kurzer Text
                     ("Ohne Sperrdateien" statt "Sperrdateien ausblenden") bleibt trotzdem, spart
                     auch im nicht-aktiven Zustand Platz im Filter-Menue. -->
                <filter name="filter_hide_lock_files" string="Ohne Sperrdateien" domain="[('is_lock_file','=',False)]"/>
                <separator/>
                <!-- Reine Marker-Filter ohne eigene domain - wird nicht direkt in eine
                     Domain-Klausel uebersetzt, sondern nur in native_search_model.js anhand seines
                     name-Attributs erkannt, um recursive umzuschalten (siehe dort). Nutzerwunsch
                     2026-09-14: vorher loeste JEDE aktive Facette (auch Tags/Status/Sperrdateien-
                     Filter) automatisch eine baumweite Rekursion aus - das ueberraschte, weil z.B.
                     der immer aktive Sperrdateien-Filter dadurch staendig ungewollt rekursiv
                     durchsuchte. Jetzt Datei-Explorer-Standard: Filter/Suche bleiben auf die
                     aktuelle Ordnerebene beschraenkt, Unterordner nur mit explizitem Haken. -->
                <filter name="filter_search_recursive" string="Unterordner einbeziehen"/>
                <separator/>
                <filter name="filter_tagged" string="Mit Tags" domain="[('tag_ids','!=',False)]"/>
                <filter name="filter_untagged" string="Ohne Tags" domain="[('tag_ids','=',False)]"/>
                <separator/>
                <!-- Baustein 4 (Ampel-Freigabe) - keine festen Werte-Filter mehr (status_id ist
                     seit der Umstellung auf int_filemanager.status frei konfigurierbar, es gibt
                     keine technisch garantierten Werte mehr) - Suche ueber das obige Feld
                     (Status) plus Gruppierung reichen. -->
                <filter name="groupby_status_id" string="Status" context="{'group_by': 'status_id'}"/>
                <!-- Kein <searchpanel>-Kategoriefeld mehr fuer "Ordner" (bis 2026-09-16 hier:
                     <field name="parent_id" .../>) - ersetzt durch eine eigene, wirklich lazy
                     ladende Baumkomponente (folder_tree.js/.xml, siehe native_search_model.js
                     fuer die Navigations-/Domain-Logik). Grund, live per EXPLAIN ANALYZE
                     nachgewiesen und in [[project_int_filemanager_searchpanel_perf]] festgehalten:
                     bei 69k Ordnern/1,38 Mio. Dateien war JEDER Odoo-Bordmittel-Pfad
                     (expand="1" ODER die Lazy-Loading-Variante ohne expand) mehrere Sekunden teuer,
                     weil beide am Ende praktisch den gesamten Baum laden - hierarchize-basierte
                     Kategoriefelder sind fuer kleine, begrenzte Klassifikationsbaeume gedacht
                     (Produktkategorien, Abteilungen), nicht fuer eine dateisystemgrosse Hierarchie. -->
            </search>
        </field>
    </record>
</odoo>
