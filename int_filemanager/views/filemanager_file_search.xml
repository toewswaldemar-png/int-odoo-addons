<odoo>
    <record id="int_filemanager_file_search" model="ir.ui.view">
        <field name="name">int_filemanager.file.search</field>
        <field name="model">int_filemanager.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Name"/>
                <field name="tag_ids" string="Tags"/>
                <!-- Baustein 1 (docs/int_filemanager_paperoffice_recherche.md): reiht sich ohne
                     jede JS-Aenderung automatisch ins bestehende "Search X for: Y"-Dropdown ein,
                     inkl. der bereits gebauten rekursiven Suche (search_model_patch.js). Einfaches
                     ilike auf einem Text-Feld fuer v1 - kein tsvector/Ranking, bewusst erst bei
                     echtem Bedarf nachruesten statt vorzeitig zu optimieren. -->
                <field name="content_text" string="Inhalt"/>
                <filter name="filter_folders" string="Nur Ordner" domain="[('is_dir','=',True)]"/>
                <filter name="filter_files" string="Nur Dateien" domain="[('is_dir','=',False)]"/>
                <separator/>
                <filter name="filter_tagged" string="Mit Tags" domain="[('tag_ids','!=',False)]"/>
                <filter name="filter_untagged" string="Ohne Tags" domain="[('tag_ids','=',False)]"/>
                <!-- hierarchize bewusst NICHT auf 0 gesetzt (Gegenteil eines frueheren Versuchs
                     hier, siehe Commit-Historie): hierarchize="0" unterdrueckt serverseitig
                     komplett das Mitschicken von parent_id pro Baumwert (web/models/models.py,
                     search_panel_select_range: "if hierarchize and parent_name in Comodel._fields:
                     field_names.append(parent_name)") - ohne das faellt der Baum optisch flach
                     zusammen (keine Einrueckung) UND native_list_view.js kann daraus keine
                     Breadcrumb-Vorfahrenkette mehr rekonstruieren, live so beobachtet. Odoos
                     Default (hierarchize="1", parent_id wird mitgeschickt) bleibt deshalb aktiv;
                     den fuer einen Datei-Browser noetigen Operator-Wechsel "child_of" -> "="
                     (direkte statt rekursive Kinder) und die Wurzel-Sonderbehandlung
                     (activeValueId=false -> parent_id=false statt "kein Filter") uebernimmt
                     komplett search_model_patch.js, gescopet auf int_filemanager.file - unabhaengig
                     vom hierarchize-Wert. domain-Attribut bewusst weggelassen: wird fuer
                     Category-Felder (kein select="multi") clientseitig ignoriert, live verifiziert
                     - search_panel_select_range-Override auf dem Modell erzwingt is_dir=True
                     stattdessen. limit="0" (kein Cap): expand ignoriert den aktuell gebrowsten Pfad
                     fuer die Knotenauswahl und holt ohnehin immer den gesamten is_dir=True-Baum in
                     einem Aufruf - der Odoo-Standard limit="200" wuerde bei vielen Ordnern sofort
                     "Zu viele Elemente" ausloesen (siehe docs/int_filemanager_native_ui.md,
                     Smoke-Test-Abschnitt). -->
                <searchpanel>
                    <field name="parent_id" string="Ordner" icon="fa-folder"
                           enable_counters="1" expand="1" limit="0"/>
                </searchpanel>
            </search>
        </field>
    </record>
</odoo>
