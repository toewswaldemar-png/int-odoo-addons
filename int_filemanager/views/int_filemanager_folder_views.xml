<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_folder_view_list" model="ir.ui.view">
        <field name="name">int.filemanager.folder.view.list</field>
        <field name="model">int.filemanager.folder</field>
        <field name="arch" type="xml">
            <!-- multi_edit: select folders and edit the parent of one of them to move them all.
                 No duplicating: the copy would only have the name that is taken. -->
            <list multi_edit="1" duplicate="0">
                <field name="name" />
                <field name="parent_id" />
                <field name="access_mode" />
                <field
                    name="model_folder_ids"
                    widget="many2many_tags"
                    groups="int_filemanager.int_filemanager_group_admin"
                    optional="show"
                />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="int_filemanager_folder_view_form" model="ir.ui.view">
        <field name="name">int.filemanager.folder.view.form</field>
        <field name="model">int.filemanager.folder</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header>
                    <button
                        name="action_share"
                        type="object"
                        string="Share"
                        icon="fa-share-alt"
                        class="btn-primary"
                        invisible="not id or not active"
                        help="Make a link that gives this folder to whoever has it, without an account."
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_shares"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-share-alt"
                            invisible="not share_count"
                        >
                            <field name="share_count" widget="statinfo" string="Shares" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="active" invisible="1" />
                        <field name="name" />
                        <field name="parent_id" />
                        <field name="access_mode" />
                        <field
                            name="access_user_ids"
                            widget="many2many_tags"
                            invisible="access_mode != 'restricted'"
                        />
                        <field
                            name="access_group_ids"
                            widget="many2many_tags"
                            invisible="access_mode != 'restricted'"
                        />
                        <!-- Only the administrators choose which folders have their images read. -->
                        <field
                            name="ocr_images"
                            groups="int_filemanager.int_filemanager_group_admin"
                        />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                    <!-- Where the files go that are uploaded at a record (a contact ...): the
                         administrators choose it, as they choose the images that are read. -->
                    <group
                        string="Upload folder for"
                        groups="int_filemanager.int_filemanager_group_admin"
                    >
                        <field name="model_folder_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="res_model" />
                                <field name="company_id" groups="base.group_multi_company" />
                            </list>
                        </field>
                    </group>
                </sheet>
                <!-- Followers see the folder as well ("Add followers" in the chatter). -->
                <chatter />
            </form>
        </field>
    </record>

    <record id="int_filemanager_folder_view_search" model="ir.ui.view">
        <field name="name">int.filemanager.folder.view.search</field>
        <field name="model">int.filemanager.folder</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="parent_id" />
                <filter
                    name="filter_upload_folder"
                    string="Upload folders"
                    domain="[('model_folder_ids', '!=', False)]"
                    groups="int_filemanager.int_filemanager_group_admin"
                />
                <separator />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="int_filemanager_folder_action" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">int.filemanager.folder</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Managing the folders is configuration, like Odoo's product categories: the folder
         tree itself is the search panel of the documents. -->
    <menuitem
        id="menu_int_filemanager_configuration"
        name="Configuration"
        parent="menu_int_filemanager_root"
        sequence="99"
    />
    <menuitem
        id="int_filemanager_folder_menu"
        name="Folders"
        parent="menu_int_filemanager_configuration"
        action="int_filemanager_folder_action"
        sequence="1"
    />
</odoo>
