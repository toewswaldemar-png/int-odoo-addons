<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_folder_view_list" model="ir.ui.view">
        <field name="name">int.filemanager.folder.view.list</field>
        <field name="model">int.filemanager.folder</field>
        <field name="arch" type="xml">
            <!-- multi_edit: edit the parent of one row to move all ticked ones. No duplicating: the
                 copy would only have the name that is taken. -->
            <list multi_edit="1" duplicate="0">
                <header>
                    <button
                        name="%(int_filemanager.int_filemanager_move_folder_action)d"
                        type="action"
                        string="Move to..."
                        icon="fa-folder-open"
                        groups="int_filemanager.int_filemanager_group_user"
                    />
                </header>
                <field name="name" />
                <field name="parent_id" />
                <field name="access_mode" groups="int_filemanager.int_filemanager_group_admin" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="int_filemanager_folder_view_form" model="ir.ui.view">
        <field name="name">int.filemanager.folder.view.form</field>
        <field name="model">int.filemanager.folder</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header>
                    <button
                        name="action_download"
                        type="object"
                        string="Download"
                        icon="fa-download"
                        invisible="not id or not active"
                        help="The folder with everything in it that you see, as one ZIP."
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_documents"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-o"
                            invisible="not id or not active"
                        >
                            <field name="document_count" widget="statinfo" string="Documents" />
                        </button>
                        <button
                            name="action_open_children"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-folder-o"
                            invisible="not id or not active"
                        >
                            <field name="child_count" widget="statinfo" string="Subfolders" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="active" invisible="1" />
                        <field name="name" />
                        <field name="parent_id" />
                        <field name="access_mode" groups="int_filemanager.int_filemanager_group_admin" />
                        <field
                            name="access_user_ids"
                            widget="many2many_tags"
                            invisible="access_mode != 'restricted'"
                            groups="int_filemanager.int_filemanager_group_admin"
                        />
                        <field
                            name="access_group_ids"
                            widget="many2many_tags"
                            invisible="access_mode != 'restricted'"
                            groups="int_filemanager.int_filemanager_group_admin"
                        />
                        <field name="company_id" groups="base.group_multi_company" readonly="parent_id" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="int_filemanager_folder_view_search" model="ir.ui.view">
        <field name="name">int.filemanager.folder.view.search</field>
        <field name="model">int.filemanager.folder</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="parent_id" />
                <separator />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <!-- The dialog of "New folder": the list puts the folder of its panel in `default_parent_id`. -->
    <record id="int_filemanager_folder_view_form_dialog" model="ir.ui.view">
        <field name="name">int.filemanager.folder.view.form.dialog</field>
        <field name="model">int.filemanager.folder</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" />
                    <field name="parent_id" />
                </group>
                <footer>
                    <button string="Save" special="save" class="btn-primary" data-hotkey="q" />
                    <button string="Discard" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="int_filemanager_folder_action_new" model="ir.actions.act_window">
        <field name="name">New folder</field>
        <field name="res_model">int.filemanager.folder</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="int_filemanager_folder_view_form_dialog" />
        <field name="target">new</field>
    </record>

    <record id="int_filemanager_folder_action" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">int.filemanager.folder</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Configuration, like Odoo's product categories: the folder tree is the search panel of the
         documents. -->
    <menuitem
        id="menu_int_filemanager_configuration"
        name="Configuration"
        parent="menu_int_filemanager_root"
        sequence="99"
    />
    <menuitem
        id="int_filemanager_folder_menu"
        name="Folders"
        parent="menu_int_filemanager_configuration"
        action="int_filemanager_folder_action"
        sequence="1"
    />
</odoo>
