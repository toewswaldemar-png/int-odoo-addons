<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_folder_view_list" model="ir.ui.view">
        <field name="name">int_filemanager.folder.list</field>
        <field name="model">int_filemanager.folder</field>
        <field name="arch" type="xml">
            <!-- multi_edit: select folders and edit the parent of one of them to move them all.
                 No duplicating: the copy would only have the name that is taken. -->
            <list multi_edit="1" duplicate="0">
                <field name="name" />
                <field name="parent_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="int_filemanager_folder_view_form" model="ir.ui.view">
        <field name="name">int_filemanager.folder.form</field>
        <field name="model">int_filemanager.folder</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="active" invisible="1" />
                        <field name="name" />
                        <field name="parent_id" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="int_filemanager_folder_view_search" model="ir.ui.view">
        <field name="name">int_filemanager.folder.search</field>
        <field name="model">int_filemanager.folder</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="parent_id" />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="int_filemanager_folder_action" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">int_filemanager.folder</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Managing the folders is configuration, like Odoo's product categories: the folder
         tree itself is the search panel of the documents. -->
    <menuitem
        id="menu_int_filemanager_configuration"
        name="Configuration"
        parent="menu_int_filemanager_root"
        sequence="99"
    />
    <menuitem
        id="int_filemanager_folder_menu"
        name="Folders"
        parent="menu_int_filemanager_configuration"
        action="int_filemanager_folder_action"
        sequence="1"
    />
</odoo>
