<odoo>
    <!-- Zweite Ansicht neben der nativen Liste (filemanager_file_list_view.xml) fuer denselben
         Dateimanager - siehe docs/int_filemanager_native_ui.md. Reine Karten-Galerie: kein
         groupBy, keine Spalten, kein Drag&Drop (Nutzerentscheidung). js_class analog zur Liste
         (int_filemanager_kanban statt int_filemanager_list, siehe native_kanban_view.js). -->
    <record id="view_filemanager_file_kanban_native" model="ir.ui.view">
        <field name="name">int_filemanager.file.kanban.native</field>
        <field name="model">int_filemanager.file</field>
        <field name="arch" type="xml">
            <kanban js_class="int_filemanager_kanban" default_order="is_dir desc, name">
                <!-- Nur fuer die Ordner-Navigation in openRecord() (filemanager_controller_mixin.js)
                     bzw. fuer die authz-geprueften mkdir/rename/delete-Routen gebraucht (path),
                     nicht auf der Karte dargestellt - dieselben drei Felder wie in der Liste
                     (filemanager_file_list_view.xml, dort column_invisible="1"). -->
                <field name="is_dir"/>
                <field name="path"/>
                <field name="folder_path"/>
                <!-- Datenquelle fuer status_id's color_field, wie in der Liste. -->
                <field name="status_color"/>
                <!-- Fuer den pending/error-Indikator unten - siehe Kommentar dort. -->
                <field name="ocr_state"/>
                <!-- Nur fuer den Systray-Audioplayer gebraucht, wie in der Liste - siehe
                     Kommentar dort (filemanager_file_list_view.xml). -->
                <field name="audio_title"/>
                <field name="audio_artist"/>
                <templates>
                    <t t-name="card">
                        <!-- Kein eigener Weg mehr, das volle Formular von der Karte aus zu
                             erreichen (Nutzerentscheidung 2026-09-18: der bisherige
                             "Details öffnen"-Pfeil-Button ist entfernt, eine andere Loesung
                             dafuer folgt spaeter) - Kartenklick loest weiterhin ausschliesslich
                             openRecord() aus (Ordner-Navigation bzw. Datei oeffnen/downloaden,
                             filemanager_controller_mixin.js). -->
                        <div>
                            <!-- thumbnail (filemanager_file.py) ist fuer Bilder/PDFs/Audio bereits
                                 befuellt (mediameta.py) - natives image-Widget, kein neuer Code.
                                 Fuer alles ohne Thumbnail (Ordner, Office-Dokumente, Archive, ...)
                                 faellt die Karte auf dasselbe int_filemanager_name-Widget zurueck,
                                 das auch die Liste fuer Ordner-/Dateityp-Icons nutzt
                                 (name_icon_field.js/.xml) - dieselbe Icon-Logik, hier nur als
                                 groesseres Platzhalter-Cover statt als kleines Spalten-Praefix.
                                 Zwei <field name="name">-Knoten statt einer dynamischen Klasse:
                                 mehrere Knoten fuer denselben Feldnamen sind in Kanban-Archs
                                 explizit vorgesehen (kanban_arch_parser.js: fieldNextIds). -->
                            <field name="thumbnail" invisible="not thumbnail" widget="image"
                                   class="o_int_filemanager_kanban_cover"/>
                            <div class="o_int_filemanager_kanban_body p-2">
                                <field name="name" invisible="thumbnail" widget="int_filemanager_name"
                                       class="o_int_filemanager_kanban_cover_fallback"/>
                                <!-- Bewusst KEIN reines "<field name="name">"-Kuerzel hier (wie
                                     das int_filemanager_name-Widget zwei Zeilen darueber): Odoos
                                     Kanban-Compiler (kanban_compiler.js: compileField) setzt fuer
                                     Feldknoten OHNE eigenes widget nur ein reines
                                     "<span t-out=.../>", jeder t-att-*-Zusatz (fuer den Tooltip
                                     bei abgeschnittenem Namen, siehe folder_tree.xml/
                                     name_icon_field.xml fuer dieselbe Konvention) wird fuer
                                     widget-lose Feldknoten komplett ignoriert - live am
                                     Odoo-19-Quellcode verifiziert. record.name.value ist Odoos
                                     eigene, in zahlreichen Kern-Kanban-Archs (z.B.
                                     hr_holidays/views/hr_leave_views.xml) genutzte Konvention fuer
                                     genau diesen Fall: ein bereits per Geschwister-<field> gefetchtes
                                     Feld frei innerhalb desselben Kanban-Templates rendern.
                                     Bewusst "title" statt Odoos eigenem "data-tooltip" (anders als
                                     ueberall sonst im Modul, siehe name_icon_field.xml/
                                     folder_tree.xml): DIESE Datei ist eine echte serverseitig
                                     validierte ir.ui.view-Arch, keine reine Owl-JS-Vorlage wie die
                                     Dateien unter static/src/ - Odoos eigener Server-Validator
                                     (ir_ui_view.py, _validate_attrs) blockt "data-tooltip"
                                     (mit UND ohne t-att-/t-attf-Praefix) dort ausdruecklich als
                                     "Forbidden attribute" (Sicherheitsgrund: Popover-Inhalt aus
                                     View-Archs, z.B. von Studio erzeugt, gilt als weniger vertrauens-
                                     wuerdig als handgeschriebener JS-Code). Live beim Modul-Upgrade
                                     bestaetigt (Fehler "Forbidden attribute used in arch
                                     (t-att-data-tooltip)"). "title" ist von dieser Sperre NICHT
                                     betroffen - einzige verfuegbare Option an dieser Stelle, keine
                                     eigene Entscheidung. -->
                                <span invisible="not thumbnail" class="text-truncate fw-bold d-block"
                                      t-att-title="record.name.value" t-out="record.name.value"/>
                                <field name="status_id" widget="badge"
                                       options="{'color_field': 'status_color'}"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                                <field name="partner_id"/>
                                <!-- Die frueheren festen Zeilen extracted_date/_invoice_number/
                                     _amount (Baustein 1, Nutzerfeedback 2026-09-07) sind mit der
                                     Vereinheitlichung auf int_filemanager.extracted_value entfallen
                                     (2026-09-19, siehe
                                     docs/int_filemanager_ocr_selbstdefinierte_felder.md) - erkannte
                                     Werte sind stattdessen ueber "Dateimanager > Erkannte Werte"
                                     und den Reiter im Datei-Formular einsehbar, nicht mehr direkt
                                     auf der Karte (waere fuer eine beliebig lange Liste nicht mehr
                                     sinnvoll darstellbar). -->
                                <!-- ocr_state-Indikator (2026-09-07, Nutzerfeedback) - analog
                                     zur Liste nur fuer pending/error, "done" ist der
                                     Normalfall und bleibt unauffaellig. -->
                                <field name="ocr_state" invisible="ocr_state != 'pending'"
                                       class="text-warning small d-block"/>
                                <field name="ocr_state" invisible="ocr_state != 'error'"
                                       class="text-danger small d-block"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
