<odoo>
    <!-- Zweite Ansicht neben der nativen Liste (filemanager_file_list_view.xml) fuer denselben
         Dateimanager - siehe docs/int_filemanager_native_ui.md. Reine Karten-Galerie: kein
         groupBy, keine Spalten, kein Drag&Drop (Nutzerentscheidung). js_class analog zur Liste
         (int_filemanager_kanban statt int_filemanager_list, siehe native_kanban_view.js). -->
    <record id="view_filemanager_file_kanban_native" model="ir.ui.view">
        <field name="name">int_filemanager.file.kanban.native</field>
        <field name="model">int_filemanager.file</field>
        <field name="arch" type="xml">
            <kanban js_class="int_filemanager_kanban" default_order="is_dir desc, name">
                <!-- Nur fuer die Ordner-Navigation in openRecord() (filemanager_controller_mixin.js)
                     bzw. fuer die authz-geprueften mkdir/rename/delete-Routen gebraucht (path),
                     nicht auf der Karte dargestellt - dieselben drei Felder wie in der Liste
                     (filemanager_file_list_view.xml, dort column_invisible="1"). -->
                <field name="is_dir"/>
                <field name="path"/>
                <field name="folder_path"/>
                <!-- Datenquelle fuer status_id's color_field, wie in der Liste. -->
                <field name="status_color"/>
                <!-- Fuer den pending/error-Indikator unten - siehe Kommentar dort. -->
                <field name="ocr_state"/>
                <templates>
                    <t t-name="card">
                        <!-- Eigene Wrapper-Div fuer position:relative - Anker fuer den
                             "Details öffnen"-Button unten (position:absolute soll sich auf die
                             ganze Karte beziehen, nicht auf die Seite). -->
                        <div class="position-relative">
                            <!-- Pendant zum Pfeil-Button in der Liste (filemanager_file_list_view.xml,
                                 action_open_form) - Kartenklick loest hier ausschliesslich
                                 openRecord() aus (Ordner-Navigation bzw. Datei oeffnen/downloaden,
                                 filemanager_controller_mixin.js), es gibt sonst keinen Weg, das
                                 volle Formular (exakte Byte-Groesse, alle Felder, Chatter als
                                 Vollseite statt Seitenpanel) von der Karte aus zu erreichen. Kein
                                 eigener Klick-Abfang noetig: der Kanban-Compiler versieht jeden
                                 <button type="object"> automatisch mit der Klasse
                                 "oe_kanban_action" (kanban_compiler.js), die in
                                 CANCEL_GLOBAL_CLICK steht (kanban_record.js) - ein Klick darauf
                                 loest nie openRecord()/die Kartennavigation aus, exakt dasselbe
                                 native Verhalten wie der Listen-Button. -->
                            <button name="action_open_form" type="object" icon="fa-arrow-right"
                                    title="Details öffnen" string=""
                                    class="btn btn-light btn-sm o_int_filemanager_kanban_open_form"/>
                            <!-- Direkter "Werte erkennen"-Button (2026-09-07, Nutzerfeedback)
                                 analog zum Listen-Pendant - eigenes <widget>, siehe
                                 analyze_button_widget.js fuer die Begruendung (kein
                                 <button type="object"> moeglich, da rein clientseitiger Ablauf).
                                 Eigene Ecke (unten rechts) statt neben "Details öffnen", damit
                                 sich die beiden Overlay-Buttons nicht ueberlappen - die
                                 Positionierungsklasse hier landet auf dem umschliessenden
                                 <div class="o_widget ...">, das Aussehen des Buttons selbst
                                 kommt aus analyze_button_widget.xml. -->
                            <widget name="int_filemanager_analyze_button"
                                    class="o_int_filemanager_kanban_analyze"/>
                            <!-- thumbnail (filemanager_file.py) ist fuer Bilder/PDFs/Audio bereits
                                 befuellt (mediameta.py) - natives image-Widget, kein neuer Code.
                                 Fuer alles ohne Thumbnail (Ordner, Office-Dokumente, Archive, ...)
                                 faellt die Karte auf dasselbe int_filemanager_name-Widget zurueck,
                                 das auch die Liste fuer Ordner-/Dateityp-Icons nutzt
                                 (name_icon_field.js/.xml) - dieselbe Icon-Logik, hier nur als
                                 groesseres Platzhalter-Cover statt als kleines Spalten-Praefix.
                                 Zwei <field name="name">-Knoten statt einer dynamischen Klasse:
                                 mehrere Knoten fuer denselben Feldnamen sind in Kanban-Archs
                                 explizit vorgesehen (kanban_arch_parser.js: fieldNextIds). -->
                            <field name="thumbnail" invisible="not thumbnail" widget="image"
                                   class="o_int_filemanager_kanban_cover"/>
                            <div class="o_int_filemanager_kanban_body p-2">
                                <field name="name" invisible="thumbnail" widget="int_filemanager_name"
                                       class="o_int_filemanager_kanban_cover_fallback"/>
                                <field name="name" invisible="not thumbnail" class="text-truncate fw-bold d-block"/>
                                <field name="status_id" widget="badge"
                                       options="{'color_field': 'status_color'}"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                                <field name="partner_id"/>
                                <!-- Baustein 1 (Werte erkennen) - analog zur Liste
                                     (filemanager_file_list_view.xml) jetzt auch auf der Karte
                                     sichtbar, Nutzerfeedback 2026-09-07. Jeweils per invisible
                                     ausgeblendet statt einer leeren Zeile, da die meisten Dateien
                                     keine erkannten Werte haben. -->
                                <field name="extracted_date" invisible="not extracted_date"
                                       class="text-muted small d-block"/>
                                <field name="extracted_invoice_number"
                                       invisible="not extracted_invoice_number"
                                       class="text-muted small d-block"/>
                                <field name="extracted_amount" invisible="not extracted_amount"
                                       class="text-muted small d-block"/>
                                <!-- ocr_state-Indikator (2026-09-07, Nutzerfeedback) - analog
                                     zur Liste nur fuer pending/error, "done" ist der
                                     Normalfall und bleibt unauffaellig. -->
                                <field name="ocr_state" invisible="ocr_state != 'pending'"
                                       class="text-warning small d-block"/>
                                <field name="ocr_state" invisible="ocr_state != 'error'"
                                       class="text-danger small d-block"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
