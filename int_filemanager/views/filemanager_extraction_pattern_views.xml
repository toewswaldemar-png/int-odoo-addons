<odoo>
    <record id="view_filemanager_extraction_pattern_list" model="ir.ui.view">
        <field name="name">int_filemanager.extraction_pattern.list</field>
        <field name="model">int_filemanager.extraction_pattern</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="target_field"/>
                <field name="name"/>
                <field name="pattern"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_filemanager_extraction_pattern_form" model="ir.ui.view">
        <field name="name">int_filemanager.extraction_pattern.form</field>
        <field name="model">int_filemanager.extraction_pattern</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="target_field"/>
                        <field name="pattern"/>
                        <field name="ignore_case"/>
                        <field name="group_index"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_filemanager_extraction_pattern" model="ir.actions.act_window">
        <field name="name">Erkennungsmuster</field>
        <field name="res_model">int_filemanager.extraction_pattern</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Admin-only, analog zu "Geschützte Ordner"/"Status" (menu_int_filemanager_protected_
         folders/menu_int_filemanager_status) - normale Nutzer sehen die Muster nur indirekt
         ueber ihre Wirkung im "Werte erkennen"-Dialog, koennen sie aber nicht anlegen/aendern
         (siehe ir.model.access.csv). -->
    <menuitem id="menu_int_filemanager_extraction_pattern"
              name="Erkennungsmuster"
              parent="menu_int_filemanager_configuration"
              action="action_filemanager_extraction_pattern"
              groups="int_filemanager.group_filemanager_admin"
              sequence="30"/>
</odoo>
