<odoo>
    <record id="view_filemanager_file_list_native" model="ir.ui.view">
        <field name="name">int_filemanager.file.list.native</field>
        <field name="model">int_filemanager.file</field>
        <field name="arch" type="xml">
            <list js_class="int_filemanager_list" default_order="is_dir desc, name" create="false" delete="false">
                <field name="is_dir" column_invisible="1"/>
                <field name="path" column_invisible="1"/>
                <field name="folder_path" column_invisible="1"/>
                <!-- Baustein 1 (Werte erkennen) - ocr_state (pending/running/done/error) war
                     bisher nirgends sichtbar, nur "done" zaehlt praktisch als Normalfall und
                     bleibt deshalb unauffaellig (decoration nur fuer pending/error) -
                     Nutzerfeedback 2026-09-07: ohne das ist nicht erkennbar, welche Dateien
                     noch nicht (fertig) analysiert wurden. Natives decoration-*-Attribut
                     (list_arch_parser.js: getDecoration(), pro Feld auswertbar), kein eigenes
                     Widget noetig. -->
                <field name="ocr_state" optional="hide"
                       decoration-warning="ocr_state == 'pending'"
                       decoration-danger="ocr_state == 'error'"/>
                <!-- Baustein 4 (Ampel-Freigabe) - natives badge-Widget, Farbe kommt aus dem
                     frei konfigurierbaren int_filemanager.status-Modell (siehe
                     filemanager_status_views.xml). status_color nur als Datenquelle fuer
                     color_field, nicht selbst als Spalte gedacht. -->
                <field name="status_color" column_invisible="1"/>
                <field name="status_id" widget="badge" options="{'color_field': 'status_color'}" optional="show"/>
                <!-- Ordner-/Datei-Typ-Icon vor dem Namen - eigenes kleines Feld-Widget
                     (name_icon_field.js/.xml), nach dem Muster von Odoos eigenem
                     many2one_avatar-Widget (Icon + Feldwert in einer Zelle). Rein clientseitig
                     aus is_dir/Dateiendung abgeleitet, kein neues Backend-Feld. Klick auf das
                     Icon selbst oeffnet das Formular (action_open_form) - ersetzt die vorherige
                     eigene Pfeil-Button-Spalte (Nutzerwunsch 2026-09-11), siehe
                     name_icon_field.js fuer die Handverdrahtung. -->
                <!-- size/mtime nicht mehr als eigene Spalten (Nutzerwunsch 2026-09-16, Desktop):
                     erscheinen stattdessen als Unterzeile unter dem Namen (name_icon_field.js/.xml,
                     sizeDateText/showSizeDate) - dieselbe humanFileSize()-Formatierung wie zuvor
                     die "Größe"-Spalte (size_human_field.js), hier direkt importiert statt
                     dupliziert. column_invisible statt Entfernen, damit die Felder weiterhin
                     mitgeladen werden (das Namens-Widget braucht sie). -->
                <field name="size" column_invisible="1"/>
                <field name="mtime" column_invisible="1"/>
                <field name="name" widget="int_filemanager_name"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <!-- Baustein 1 (Werte erkennen) - bisher nur im Formular sichtbar, obwohl per
                     "Werte erkennen"/Drag&Drop-Analyse befuellt (siehe document_review_dialog.js).
                     Nutzerfeedback 2026-09-07: ohne Sicht-/Filterbarkeit in der Liste sind diese
                     Werte kaum auffindbar. optional="hide" wie partner_id - nicht jede Datei hat
                     erkannte Werte, Standardansicht bleibt unveraendert kompakt. -->
                <field name="extracted_date" optional="hide"/>
                <field name="extracted_invoice_number" optional="hide"/>
                <field name="extracted_amount" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_filemanager_file_list_native" model="ir.actions.act_window">
        <field name="name">Dateimanager</field>
        <!-- Sprechender URL-Pfad statt "action-<id>" (Nutzerwunsch 2026-09-16) - ir.actions.actions
             hat genau dafuer ein eigenes "path"-Feld (base/models/ir_actions.py, DB-weit eindeutig,
             live per SQL gegen alle bestehenden Werte geprueft: kein Konflikt). router.js baut die
             URL nur dann aus der numerischen ID ("action-313"), wenn state.action eine Zahl ist
             oder einen Punkt enthaelt (pathFromActionState()) - ein reiner, punktfreier String wie
             hier wird 1:1 als Pfadsegment uebernommen. -->
        <field name="path">filemanager</field>
        <field name="res_model">int_filemanager.file</field>
        <!-- "kanban" zusaetzlich zu "list" (2026-09-07, siehe
             docs/int_filemanager_native_ui.md) - kein view_id-Eintrag fuer den Kanban-Teil
             noetig: es gibt genau eine Kanban-View fuer dieses Modell
             (filemanager_file_kanban_view.xml), Odoo waehlt sie automatisch (gleiches Muster
             wie view_mode="list,form" ohne view_id in filemanager_status_views.xml). -->
        <field name="view_mode">list,kanban</field>
        <!-- Ohne dieses Feld waehlt Odoo auf schmalen Bildschirmen (env.isSmall) intern eine
             eigene Standardpraeferenz statt der ersten view_mode-Ansicht - live als Bug
             gefunden 2026-09-14 (Nutzerreport "auf Mobil oeffnet sich Kanban statt Liste"),
             Ursache in action_service.js: "if (env.isSmall) { view = _findView(views,
             view.multiRecord, action.mobile_view_mode) || view; }". Explizit auf "list"
             gesetzt, damit Mobil/Desktop dieselbe Standardansicht zeigen. -->
        <field name="mobile_view_mode">list</field>
        <field name="view_id" ref="view_filemanager_file_list_native"/>
        <field name="search_view_id" ref="int_filemanager_file_search"/>
        <!-- Explizit [] statt das Feld wegzulassen: ein aus dem XML entferntes <field> wird von
             Odoo beim Modul-Update NICHT zurueckgesetzt, der alte DB-Wert bleibt stehen (live so
             erlebt). Kein statisches folder_path/parent_id-Filter hier noetig: die Navigation
             (inkl. Wurzel-Ansicht) laeuft komplett ueber den parent_id-SearchPanel in
             filemanager_file_search.xml + search_model_patch.js - eine hier gesetzte Domain
             wuerde permanent in searchModel.globalDomain landen und mit jeder Kategorie-Auswahl
             ge-ANDet, was Navigation in Unterordner unmoeglich machen wuerde. -->
        <field name="domain">[]</field>
        <!-- filter_hide_lock_files (filemanager_file_search.xml) war hier per
             search_default_ standardmaessig aktiv - Nutzerentscheidung 2026-09-14
             zurueckgenommen: der Filter-Chip belegt permanent Platz im
             ".o_searchview_input_container" (Odoo-nativ "flex-wrap", ohne Responsive-
             Ausnahme), was die Suchleiste auf schmalen Bildschirmen schon durch diesen einen
             Chip auf zwei Zeilen kippen liess, unabhaengig von jeder Auswahl. Filter bleibt
             im Filter-Menue weiterhin manuell aktivierbar. Explizit {} statt das Feld
             wegzulassen - siehe Kommentar bei domain oben, derselbe Grund (Odoo setzt einen
             aus dem XML entfernten Wert beim Modul-Update sonst nicht zurueck). -->
        <field name="context">{}</field>
    </record>
</odoo>
