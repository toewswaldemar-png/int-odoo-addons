<odoo>
    <record id="view_filemanager_file_list_native" model="ir.ui.view">
        <field name="name">int_filemanager.file.list.native</field>
        <field name="model">int_filemanager.file</field>
        <field name="arch" type="xml">
            <list js_class="int_filemanager_list" default_order="is_dir desc, name" create="false" delete="false">
                <field name="is_dir" column_invisible="1"/>
                <field name="path" column_invisible="1"/>
                <field name="folder_path" column_invisible="1"/>
                <!-- type="object"-Button in einer Listenzeile loest nie den Zeilenklick
                     (openRecord/Navigation) aus - list_renderer.js prueft bei Klick, ob das
                     Ziel ein <button> ist, und reicht nur bei Fehltreffer an die normale
                     Zeilenlogik weiter. Deshalb reicht die reine Arch-Deklaration hier, kein
                     JS-Klick-Abfang in native_list_view.js noetig. -->
                <!-- width="40px" fixiert min=max in Odoos Spaltenbreiten-Algorithmus
                     (column_width_hook.js: column.attrs.width -> minWidth=maxWidth) - ohne das
                     wird ein <button>-Spalte (kein eigener column.type-Zweig dort, faellt auf
                     canShrink=false + kein maxWidth zurueck) beim "Tabelle schmaler als Platz"-
                     Fall wie eine normale Datenspalte mitgestreckt, live als breite Leerflaeche
                     um den Pfeil beobachtet. -->
                <button name="action_open_form" type="object" icon="fa-arrow-right"
                        title="Details öffnen" string="" width="40px"/>
                <!-- Baustein 4 (Ampel-Freigabe) - natives badge-Widget, Farbe kommt aus dem
                     frei konfigurierbaren int_filemanager.status-Modell (siehe
                     filemanager_status_views.xml). status_color nur als Datenquelle fuer
                     color_field, nicht selbst als Spalte gedacht. -->
                <field name="status_color" column_invisible="1"/>
                <field name="status_id" widget="badge" options="{'color_field': 'status_color'}" optional="show"/>
                <!-- Ordner-/Datei-Typ-Icon vor dem Namen - eigenes kleines Feld-Widget
                     (name_icon_field.js/.xml), nach dem Muster von Odoos eigenem
                     many2one_avatar-Widget (Icon + Feldwert in einer Zelle). Rein clientseitig
                     aus is_dir/Dateiendung abgeleitet, kein neues Backend-Feld. -->
                <field name="name" widget="int_filemanager_name"/>
                <!-- Menschlich lesbar (z.B. "12.34Mb"/"700Mb"/"512 Bytes") statt roher Byte-
                     Zahl - dieselbe Formatierung, die Odoo intern fuer jede Binary-Feld-Groesse
                     nutzt (humanSize() in web/static/src/views/fields/formatters.js), hier
                     nachgebaut, weil size bewusst kein Binary-Feld ist (siehe
                     size_human_field.js). Nur die Liste - das Formular zeigt weiterhin die
                     exakte Byte-Zahl (eigenes string="Größe" hier statt "Größe (Bytes)", da
                     die Werte nicht mehr woertlich Bytes sind). -->
                <field name="size" invisible="is_dir" optional="show"
                       widget="int_filemanager_size" string="Größe"/>
                <field name="mtime" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <!-- Baustein 1 (Werte erkennen) - bisher nur im Formular sichtbar, obwohl per
                     "Werte erkennen"/Drag&Drop-Analyse befuellt (siehe document_review_dialog.js).
                     Nutzerfeedback 2026-09-07: ohne Sicht-/Filterbarkeit in der Liste sind diese
                     Werte kaum auffindbar. optional="hide" wie partner_id - nicht jede Datei hat
                     erkannte Werte, Standardansicht bleibt unveraendert kompakt. -->
                <field name="extracted_date" optional="hide"/>
                <field name="extracted_invoice_number" optional="hide"/>
                <field name="extracted_amount" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_filemanager_file_list_native" model="ir.actions.act_window">
        <field name="name">Dateimanager</field>
        <field name="res_model">int_filemanager.file</field>
        <!-- "kanban" zusaetzlich zu "list" (2026-09-07, siehe
             docs/int_filemanager_native_ui.md) - kein view_id-Eintrag fuer den Kanban-Teil
             noetig: es gibt genau eine Kanban-View fuer dieses Modell
             (filemanager_file_kanban_view.xml), Odoo waehlt sie automatisch (gleiches Muster
             wie view_mode="list,form" ohne view_id in filemanager_status_views.xml). -->
        <field name="view_mode">list,kanban</field>
        <field name="view_id" ref="view_filemanager_file_list_native"/>
        <field name="search_view_id" ref="int_filemanager_file_search"/>
        <!-- Explizit [] statt das Feld wegzulassen: ein aus dem XML entferntes <field> wird von
             Odoo beim Modul-Update NICHT zurueckgesetzt, der alte DB-Wert bleibt stehen (live so
             erlebt). Kein statisches folder_path/parent_id-Filter hier noetig: die Navigation
             (inkl. Wurzel-Ansicht) laeuft komplett ueber den parent_id-SearchPanel in
             filemanager_file_search.xml + search_model_patch.js - eine hier gesetzte Domain
             wuerde permanent in searchModel.globalDomain landen und mit jeder Kategorie-Auswahl
             ge-ANDet, was Navigation in Unterordner unmoeglich machen wuerde. -->
        <field name="domain">[]</field>
    </record>
</odoo>
