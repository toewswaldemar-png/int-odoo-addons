<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Only the choice of the record (model and record together); else Odoo makes a field of each. -->
    <record id="int_filemanager_link_view_form" model="ir.ui.view">
        <field name="name">int.filemanager.link.view.form</field>
        <field name="model">int.filemanager.link</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="document_id" invisible="1" />
                    <field name="record_ref" required="1" />
                </group>
            </form>
        </field>
    </record>

    <record id="int_filemanager_document_view_form_link" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.form.inherit.link</field>
        <field name="model">int.filemanager.document</field>
        <field name="inherit_id" ref="int_filemanager_document_view_form" />
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="partner_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>

    <record id="int_filemanager_document_view_list_link" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.list.inherit.link</field>
        <field name="model">int.filemanager.document</field>
        <field name="inherit_id" ref="int_filemanager_document_view_list" />
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="partner_ids" widget="many2many_tags" optional="show" />
            </field>
        </field>
    </record>

    <record id="int_filemanager_document_view_search_link" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.search.inherit.link</field>
        <field name="model">int.filemanager.document</field>
        <field name="inherit_id" ref="int_filemanager_document_view_search" />
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="partner_ids" />
            </field>
        </field>
    </record>

    <record id="int_filemanager_document_view_search_record" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.search.record</field>
        <field name="model">int.filemanager.document</field>
        <field name="inherit_id" ref="int_filemanager_document_view_search" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <searchpanel position="replace" />
            <field name="folder_id" position="replace" />
            <filter name="group_by_folder" position="replace" />
        </field>
    </record>
</odoo>
