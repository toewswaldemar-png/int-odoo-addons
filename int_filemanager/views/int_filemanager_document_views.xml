<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_document_view_list" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.list</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <!-- multi_edit: editing the folder of one row moves all ticked ones. -->
            <list
                js_class="int_filemanager_document_list"
                multi_edit="1"
                create="0"
                import="0"
                duplicate="0"
            >
                <header>
                    <button name="action_download" type="object" string="Download" icon="fa-download" />
                    <button
                        name="action_share"
                        type="object"
                        string="Share"
                        icon="fa-share-alt"
                        groups="int_filemanager.int_filemanager_group_user"
                    />
                </header>
                <field name="name" widget="int_filemanager_document_name" />
                <field name="folder_id" string="Location" context="{'hierarchical_naming': True}" />
                <field name="size" widget="int_filemanager_size" />
                <field name="write_date" string="Modified" />
                <field name="tag_ids" widget="many2many_tags" optional="show" />
                <field
                    name="content_hits"
                    widget="int_filemanager_content_hits"
                    column_invisible="not context.get('int_filemanager_words')"
                />
                <field
                    name="activity_ids"
                    string="Next Activity"
                    widget="list_activity"
                    optional="hide"
                />
            </list>
        </field>
    </record>

    <record id="int_filemanager_document_view_kanban" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.kanban</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <kanban
                js_class="int_filemanager_document_kanban"
                create="0"
                quick_create="0"
                group_create="0"
            >
                <header>
                    <button name="action_download" type="object" string="Download" icon="fa-download" />
                </header>
                <field name="checksum" />
                <field name="ocr_checksum" />
                <templates>
                    <t t-name="menu">
                        <a role="menuitem" type="open" class="dropdown-item">Properties</a>
                        <a role="menuitem" type="object" name="action_download" class="dropdown-item">
                            Download
                        </a>
                    </t>
                    <t t-name="card">
                        <field name="mimetype" widget="int_filemanager_document_thumbnail" />
                        <field name="name" class="fw-bold text-truncate d-block mt-2" />
                        <div class="o_int_filemanager_card_meta">
                            <div class="d-flex justify-content-between text-muted small">
                                <field name="folder_id" class="text-truncate" />
                                <field name="size" widget="int_filemanager_size" />
                            </div>
                            <field name="tag_ids" widget="many2many_tags" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="int_filemanager_document_view_pivot" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.pivot</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <pivot string="Documents" default_order="size desc">
                <field name="mimetype" type="row" />
                <field name="size" type="measure" widget="int_filemanager_size" />
            </pivot>
        </field>
    </record>

    <record id="int_filemanager_document_view_graph" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.graph</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <graph string="Documents" type="bar" order="desc">
                <field name="mimetype" />
                <field name="size" type="measure" widget="int_filemanager_size" />
            </graph>
        </field>
    </record>

    <record id="int_filemanager_document_view_form" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.form</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <!-- No chatter here: the js_class renderer shows it on request. -->
            <form js_class="int_filemanager_document_form" create="0" duplicate="0">
                <header>
                    <button
                        name="action_download"
                        type="object"
                        string="Download"
                        class="btn-primary"
                        icon="fa-download"
                    />
                    <button
                        name="action_share"
                        type="object"
                        string="Share"
                        icon="fa-share-alt"
                        invisible="not active"
                        groups="int_filemanager.int_filemanager_group_user"
                        help="Make a link that gives this file to whoever has it, without an account."
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_shares"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-share-alt"
                            invisible="not share_count"
                        >
                            <field name="share_count" widget="statinfo" string="Shares" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="active" invisible="1" />
                        <field name="checksum" invisible="1" />
                        <field name="ocr_checksum" invisible="1" />
                        <field name="name" />
                        <field name="folder_id" string="Location" context="{'hierarchical_naming': True}" />
                        <field name="tag_ids" widget="many2many_tags" />
                        <field name="share_id" invisible="not share_id" />
                    </group>
                    <group string="File" name="file">
                        <field name="extension" class="text-uppercase" />
                        <field name="mimetype" />
                        <field name="size" widget="int_filemanager_size" />
                        <field name="write_date" string="Modified" />
                        <field name="create_uid" widget="many2one_avatar_user" />
                        <field name="create_date" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="int_filemanager_document_view_search" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.search</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="folder_id" context="{'hierarchical_naming': True}" />
                <field name="tag_ids" />
                <field
                    name="content_search"
                    string="Full text"
                    context="{'int_filemanager_words': self}"
                />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <!-- Set by the activity menu (search_default_<name>), not offered in the filter menu. -->
                <separator invisible="1" />
                <filter
                    name="filter_activities_my"
                    string="My Activities"
                    invisible="1"
                    domain="[('activity_user_id', '=', uid)]"
                />
                <separator invisible="1" />
                <filter
                    name="activities_overdue"
                    string="Late Activities"
                    invisible="1"
                    domain="[('my_activity_date_deadline', '&lt;', 'today')]"
                />
                <filter
                    name="activities_today"
                    string="Today Activities"
                    invisible="1"
                    domain="[('my_activity_date_deadline', '=', 'today')]"
                />
                <filter
                    name="activities_upcoming_all"
                    string="Future Activities"
                    invisible="1"
                    domain="[('my_activity_date_deadline', '&gt;', 'today')]"
                />
                <group>
                    <filter
                        name="group_by_folder"
                        string="Folder"
                        context="{'group_by': 'folder_id'}"
                    />
                    <filter
                        name="group_by_mimetype"
                        string="Mimetype"
                        context="{'group_by': 'mimetype'}"
                    />
                    <filter name="group_by_tag" string="Tags" context="{'group_by': 'tag_ids'}" />
                </group>
                <!-- expand="1": all folders in one call; limit="0": the default 200 ends in an
                     error with more folders; no counters (they count all documents at every
                     search); view_types adds the pivot and the graph. -->
                <searchpanel view_types="list,kanban,pivot,graph">
                    <field
                        name="folder_id"
                        string="Folders"
                        icon="fa-folder"
                        expand="1"
                        limit="0"
                    />
                    <field
                        name="tag_ids"
                        select="multi"
                        string="Tags"
                        icon="fa-tags"
                        expand="1"
                    />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="int_filemanager_document_action" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">int.filemanager.document</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
    </record>

    <menuitem
        id="int_filemanager_document_menu"
        name="Documents"
        parent="menu_int_filemanager_root"
        action="int_filemanager_document_action"
        sequence="0"
    />

    <!-- Guest views of a share: high priority so they are never a default. -->
    <record id="int_filemanager_document_view_guest_list" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.guest.list</field>
        <field name="model">int.filemanager.document</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list
                js_class="int_filemanager_guest_list"
                create="0"
                edit="0"
                delete="0"
                import="0"
                export_xlsx="0"
                duplicate="0"
            >
                <field name="name" widget="int_filemanager_document_name" />
                <field name="folder_id" options="{'no_open': True}" context="{'hierarchical_naming': True}" />
                <field name="size" widget="int_filemanager_size" />
                <field name="write_date" string="Modified" />
                <field name="tag_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="int_filemanager_document_view_guest_kanban" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.guest.kanban</field>
        <field name="model">int.filemanager.document</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <kanban
                js_class="int_filemanager_guest_kanban"
                create="0"
                edit="0"
                delete="0"
                quick_create="0"
                group_create="0"
            >
                <field name="write_date" />
                <templates>
                    <t t-name="card">
                        <field name="mimetype" widget="int_filemanager_document_thumbnail" />
                        <field name="name" class="fw-bold text-truncate d-block mt-2" />
                        <div class="o_int_filemanager_card_meta">
                            <div class="d-flex justify-content-between text-muted small">
                                <field name="folder_id" class="text-truncate" />
                                <field name="size" widget="int_filemanager_size" />
                            </div>
                            <field name="tag_ids" widget="many2many_tags" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="int_filemanager_document_view_guest_search" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.guest.search</field>
        <field name="model">int.filemanager.document</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter name="filter_pdf" string="PDF" domain="[('mimetype', '=', 'application/pdf')]" />
                <filter name="filter_image" string="Images" domain="[('mimetype', '=like', 'image/%')]" />
                <group>
                    <filter name="group_by_folder" string="Folder" context="{'group_by': 'folder_id'}" />
                    <filter name="group_by_mimetype" string="Mimetype" context="{'group_by': 'mimetype'}" />
                    <filter name="group_by_tag" string="Tags" context="{'group_by': 'tag_ids'}" />
                </group>
                <searchpanel view_types="list,kanban">
                    <field name="folder_id" string="Folders" icon="fa-folder" expand="1" limit="0" />
                    <field name="tag_ids" select="multi" string="Tags" icon="fa-tags" expand="1" />
                </searchpanel>
            </search>
        </field>
    </record>
</odoo>
