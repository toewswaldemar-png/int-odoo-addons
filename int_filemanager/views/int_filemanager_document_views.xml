<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_document_view_list" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.list</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <!-- multi_edit: select documents and edit the folder of one of them to move them all.
                 No new, import or duplicate: documents come from the upload and the reading in
                 only (the users have no right to create them). -->
            <list
                js_class="int_filemanager_document_list"
                multi_edit="1"
                create="0"
                import="0"
                duplicate="0"
            >
                <!-- The buttons for the ticked rows: a row has none, a click on it shows the file. -->
                <header>
                    <button name="action_open_form" type="object" string="Properties" icon="fa-pencil" />
                    <button name="action_download" type="object" string="Download" icon="fa-download" />
                </header>
                <field name="name" widget="int_filemanager_document_name" />
                <field name="folder_id" />
                <field name="size" widget="int_filemanager_size" />
                <field name="write_date" string="Modified" />
                <field name="tag_ids" widget="many2many_tags" optional="show" />
                <field
                    name="activity_ids"
                    string="Next Activity"
                    widget="list_activity"
                    optional="hide"
                />
            </list>
        </field>
    </record>

    <record id="int_filemanager_document_view_kanban" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.kanban</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <!-- A click on a card shows the file (see DocumentKanbanController), as a click on
                 a row of the list does; the form is in the menu of the card. No new: documents
                 come from the upload and the reading in only. -->
            <kanban
                js_class="int_filemanager_document_kanban"
                create="0"
                quick_create="0"
                group_create="0"
            >
                <field name="checksum" />
                <templates>
                    <t t-name="menu">
                        <a role="menuitem" type="object" name="action_open_form" class="dropdown-item">
                            Properties
                        </a>
                        <a role="menuitem" type="object" name="action_download" class="dropdown-item">
                            Download
                        </a>
                    </t>
                    <t t-name="card">
                        <field name="mimetype" widget="int_filemanager_document_thumbnail" />
                        <field name="name" class="fw-bold text-truncate d-block mt-2" />
                        <div class="d-flex justify-content-between text-muted small">
                            <field name="folder_id" class="text-truncate" />
                            <field name="size" widget="int_filemanager_size" />
                        </div>
                        <field name="tag_ids" widget="many2many_tags" />
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="int_filemanager_document_view_pivot" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.pivot</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <!-- Where the space goes. The rows are the file types: there are few of them, a
                 row for each folder would be thousands. Another grouping: click "Total" in
                 the head of the rows; the search panel narrows to a folder first. The size is
                 a sum of many files, so its formatter shows a decimal (see size_field.js). -->
            <pivot string="Documents" default_order="size desc">
                <field name="mimetype" type="row" />
                <field name="size" type="measure" widget="int_filemanager_size" />
            </pivot>
        </field>
    </record>

    <record id="int_filemanager_document_view_graph" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.graph</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <graph string="Documents" type="bar" order="desc">
                <field name="mimetype" />
                <field name="size" type="measure" widget="int_filemanager_size" />
            </graph>
        </field>
    </record>

    <record id="int_filemanager_document_view_form" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.form</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <!-- js_class: the preview of the file beside the form (see DocumentFormRenderer). -->
            <form js_class="int_filemanager_document_form" create="0" duplicate="0">
                <header>
                    <button
                        name="action_download"
                        type="object"
                        string="Download"
                        class="btn-primary"
                        icon="fa-download"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <!-- The core docks the preview beside the form from the width XXL on; below
                         it this button shows the file. -->
                    <div class="d-xxl-none mb-3">
                        <widget name="int_filemanager_preview_button" />
                    </div>
                    <group>
                        <field name="active" invisible="1" />
                        <field name="checksum" invisible="1" />
                        <field name="name" />
                        <field name="folder_id" />
                        <field name="mimetype" />
                        <field name="size" widget="int_filemanager_size" />
                        <field name="tag_ids" widget="many2many_tags" />
                    </group>
                </sheet>
                <!-- Filled by DocumentFormRenderer, in the layout of the core: the form on the
                     left, the preview on the right, the chatter below. -->
                <div class="o_attachment_preview" />
                <chatter />
            </form>
        </field>
    </record>

    <record id="int_filemanager_document_view_search" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.search</field>
        <field name="model">int.filemanager.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="folder_id" />
                <field name="tag_ids" />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <!-- The filters the activity menu of the top bar sets (search_default_<name>,
                     see the activity menu of the mail module): without them it would show every
                     document. Not offered in the filter menu, as in the core's views. -->
                <separator invisible="1" />
                <filter
                    name="filter_activities_my"
                    string="My Activities"
                    invisible="1"
                    domain="[('activity_user_id', '=', uid)]"
                />
                <separator invisible="1" />
                <filter
                    name="activities_overdue"
                    string="Late Activities"
                    invisible="1"
                    domain="[('my_activity_date_deadline', '&lt;', 'today')]"
                />
                <filter
                    name="activities_today"
                    string="Today Activities"
                    invisible="1"
                    domain="[('my_activity_date_deadline', '=', 'today')]"
                />
                <filter
                    name="activities_upcoming_all"
                    string="Future Activities"
                    invisible="1"
                    domain="[('my_activity_date_deadline', '&gt;', 'today')]"
                />
                <!-- The groups of the "Group By" menu, also the ones of the graph. -->
                <group>
                    <filter
                        name="group_by_folder"
                        string="Folder"
                        context="{'group_by': 'folder_id'}"
                    />
                    <filter
                        name="group_by_mimetype"
                        string="Mimetype"
                        context="{'group_by': 'mimetype'}"
                    />
                    <filter name="group_by_tag" string="Tags" context="{'group_by': 'tag_ids'}" />
                </group>
                <!-- Odoo's own search panel. expand="1": all folders in one call, not looked
                     up again at every search; limit="0": the default 200 would end in an
                     error message with more folders. No counters (they count all documents
                     at every search). view_types: the core shows the panel in the list and
                     the kanban only; here also in the pivot and the graph, to narrow them to
                     a folder. -->
                <searchpanel view_types="list,kanban,pivot,graph">
                    <field
                        name="folder_id"
                        string="Folders"
                        icon="fa-folder"
                        expand="1"
                        limit="0"
                    />
                    <field
                        name="tag_ids"
                        select="multi"
                        string="Tags"
                        icon="fa-tags"
                        expand="1"
                    />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="int_filemanager_document_action" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">int.filemanager.document</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
    </record>

    <menuitem
        id="int_filemanager_document_menu"
        name="Documents"
        parent="menu_int_filemanager_root"
        action="int_filemanager_document_action"
        sequence="0"
    />
</odoo>
