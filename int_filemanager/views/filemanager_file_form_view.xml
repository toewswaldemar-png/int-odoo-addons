<odoo>
    <record id="view_filemanager_file_form" model="ir.ui.view">
        <field name="name">int_filemanager.file.form</field>
        <field name="model">int_filemanager.file</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Eine einzige Gruppe statt zwei getrennter: jede <group> ist ihr eigenes
                         CSS-Grid mit eigener, unabhaengig berechneter Label-Spaltenbreite
                         (form_controller.scss: "fit-content(150px)" pro Gruppe) - zwei Gruppen
                         hiessen zwei verschieden breite Label-Spalten und damit nicht buendige
                         Unterstriche zwischen "Status" und "Tags"/"Verknuepfter Datensatz"
                         (live beobachtet). Mit einer Gruppe richten sich alle Zeilen am selben,
                         gemeinsam berechneten Maximum aus. -->
                    <group>
                        <!-- Editierbar (Nutzerwunsch 2026-09-06) - schreibt ueber
                             int_filemanager.file.write() den echten Dateisystem-Rename
                             (rename_entry() in index_utils.py), nicht nur die DB-Spalte.
                             "Umbenennen" in der Toolbar bleibt zusaetzlich bestehen (ruft
                             dieselbe Funktion ueber die /rename-Route auf). -->
                        <field name="name"/>
                        <field name="path" readonly="1"/>
                        <field name="size" readonly="1"/>
                        <field name="mtime" readonly="1"/>
                        <field name="status_id"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                        <field name="partner_id"/>
                    </group>
                    <!-- Nur lesend (kein editable="bottom"/create/delete-Button) - entstehen
                         ausschliesslich ueber den "Werte erkennen"-Dialog, nicht per Hand hier
                         (siehe filemanager_file.py::_apply_extracted_values). -->
                    <notebook invisible="not extracted_value_ids">
                        <page string="Erkannte Werte" name="extracted_values">
                            <field name="extracted_value_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="pattern_id"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
