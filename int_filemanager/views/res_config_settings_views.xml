<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.int_filemanager</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Filemanager" name="int_filemanager" groups="base.group_system">
                    <block title="Access" name="int_filemanager_access_block">
                        <setting
                            id="int_filemanager_access_via_record"
                            string="Access through linked records"
                            help="Whoever may read a record (a contact, say) may also read the documents linked to it, without a right on their folder. Off: only the folders decide, and a file uploaded to a record is seen by those who see its upload folder."
                        >
                            <field name="int_filemanager_access_via_record" />
                        </setting>
                    </block>
                    <block title="Display" name="int_filemanager_display_block">
                        <setting
                            id="int_filemanager_default_open_mode"
                            string="Open documents with"
                            help="What opens a document in the list and the kanban. Every user can choose otherwise in their preferences."
                        >
                            <field name="int_filemanager_default_open_mode" />
                        </setting>
                    </block>
                    <block title="Office files" name="int_filemanager_preview_block">
                        <setting
                            id="int_filemanager_preview_enabled"
                            string="Preview"
                            help="LibreOffice makes a PDF of each Word, Excel, PowerPoint and OpenDocument file in the background, and the preview shows it. The files themselves are not changed; the download is the original."
                        >
                            <field name="int_filemanager_preview_enabled" />
                        </setting>
                        <setting
                            id="int_filemanager_preview_limits"
                            string="Limits"
                            help="A file that takes longer or is bigger gets no preview and is not tried again."
                            invisible="int_filemanager_preview_enabled != '1'"
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label class="col-lg-4" for="int_filemanager_preview_seconds" />
                                    <field name="int_filemanager_preview_seconds" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_preview_max_size_mib" />
                                    <field name="int_filemanager_preview_max_size_mib" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="int_filemanager_preview_status"
                            string="Status"
                            help="Nothing is converted while LibreOffice is not installed."
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label class="col-lg-4" for="int_filemanager_preview_state" />
                                    <field name="int_filemanager_preview_state" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_preview_done" />
                                    <field name="int_filemanager_preview_done" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_preview_waiting" />
                                    <field name="int_filemanager_preview_waiting" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_preview_failed" />
                                    <field name="int_filemanager_preview_failed" />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- The settings in the menu, as the core modules do it (the context "module" opens the section
         of the module). -->
    <record id="res_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'int_filemanager', 'bin_size': False}</field>
    </record>

    <menuitem
        id="res_config_settings_menu"
        name="Settings"
        parent="menu_int_filemanager_root"
        action="res_config_settings_action"
        groups="base.group_system"
        sequence="90"
    />
</odoo>
