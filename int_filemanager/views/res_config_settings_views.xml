<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.int_filemanager</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Filemanager" name="int_filemanager" groups="base.group_system">
                    <block title="Access" name="int_filemanager_access_block">
                        <setting
                            id="int_filemanager_access_via_record"
                            string="Access through linked records"
                            help="Whoever may read a record (a contact, say) may also read the documents linked to it, without a right on their folder. Off: only the folders decide, and a file uploaded to a record is seen by those who see its upload folder."
                        >
                            <field name="int_filemanager_access_via_record" />
                        </setting>
                    </block>
                    <block title="Display" name="int_filemanager_display_block">
                        <setting
                            id="int_filemanager_default_open_mode"
                            string="Open documents with"
                            help="What opens a document in the list and the kanban. Every user can choose otherwise in their preferences."
                        >
                            <field name="int_filemanager_default_open_mode" />
                        </setting>
                    </block>
                    <block title="Import" name="int_filemanager_import_block">
                        <setting
                            id="int_filemanager_import_root"
                            string="Root folder"
                            help="Only what lies below this folder of the server can be read into the filemanager."
                        >
                            <field name="int_filemanager_import_root" placeholder="/mnt/hm-daten" />
                        </setting>
                    </block>
                    <block title="Search in files" name="int_filemanager_text_block">
                        <setting
                            id="int_filemanager_text_time"
                            string="Time reserve"
                            help="The text of the files is read in the background. A run stops this many seconds before Odoo's own time limit."
                        >
                            <field name="int_filemanager_time_reserve" />
                        </setting>
                        <setting
                            id="int_filemanager_text_memory"
                            string="Memory per file"
                            help="Reading one file may use this much memory (MiB). A file that needs more is skipped."
                        >
                            <field name="int_filemanager_memory_mib" />
                        </setting>
                        <setting
                            id="int_filemanager_text_sizes"
                            string="Text sizes"
                            help="Blocks of text for files without pages (KiB), and the largest page of a PDF (bytes)."
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label class="col-lg-4" for="int_filemanager_text_block_kib" />
                                    <field name="int_filemanager_text_block_kib" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_text_cut_bytes" />
                                    <field name="int_filemanager_text_cut_bytes" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="int_filemanager_text_search"
                            string="Search"
                            help="Memory (MiB) the database may use for one search in the text; the number of tries for a file that stops the reading."
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label class="col-lg-4" for="int_filemanager_work_mem_mib" />
                                    <field name="int_filemanager_work_mem_mib" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_max_attempts" />
                                    <field name="int_filemanager_max_attempts" />
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Text in scans" name="int_filemanager_ocr_block">
                        <setting
                            id="int_filemanager_ocr_enabled"
                            help="Scanned pages (PDF files without text) get a text layer, so that the search finds their words. The files themselves are not changed; the new PDF is shown in the preview, the download is the original. Pictures are read in the folders that have it switched on (folder form, Text recognition in images)."
                        >
                            <field name="int_filemanager_ocr_enabled" />
                        </setting>
                        <setting
                            id="int_filemanager_ocr_languages"
                            string="Recognition languages"
                            help="The languages of the text, as Tesseract names them, joined by +."
                            invisible="not int_filemanager_ocr_enabled"
                        >
                            <field name="int_filemanager_ocr_languages" placeholder="deu+eng" />
                        </setting>
                        <setting
                            id="int_filemanager_ocr_machine"
                            string="Load on the server"
                            help="Cores one recognition may use, and how much of the processor it takes when the server is busy."
                            invisible="not int_filemanager_ocr_enabled"
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label class="col-lg-4" for="int_filemanager_ocr_jobs" />
                                    <field name="int_filemanager_ocr_jobs" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_ocr_nice" />
                                    <field name="int_filemanager_ocr_nice" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="int_filemanager_ocr_pages"
                            string="Result"
                            help="Straightening and turning make the recognition better and the time longer. PDF/A takes longer and makes the file bigger."
                            invisible="not int_filemanager_ocr_enabled"
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label class="col-lg-4" for="int_filemanager_ocr_deskew" />
                                    <field name="int_filemanager_ocr_deskew" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_ocr_output_type" />
                                    <field name="int_filemanager_ocr_output_type" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="int_filemanager_ocr_status"
                            string="Status"
                            help="Which scans are done and what is still to do. Nothing is recognized while the state is not Ready."
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label class="col-lg-4" for="int_filemanager_ocr_state" />
                                    <field name="int_filemanager_ocr_state" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_ocr_tools" />
                                    <field name="int_filemanager_ocr_tools" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_ocr_done" />
                                    <field name="int_filemanager_ocr_done" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_ocr_wait" />
                                    <field name="int_filemanager_ocr_wait" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_ocr_running" />
                                    <field name="int_filemanager_ocr_running" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_ocr_failed" />
                                    <field name="int_filemanager_ocr_failed" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_ocr_left" />
                                    <field name="int_filemanager_ocr_left" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_ocr_pdf_size" />
                                    <field name="int_filemanager_ocr_pdf_size" />
                                </div>
                                <div class="row">
                                    <field name="int_filemanager_ocr_notes" class="text-muted" />
                                </div>
                                <div class="mt8">
                                    <button
                                        name="%(int_filemanager.int_filemanager_text_ocr_action)d"
                                        type="action"
                                        string="Show the scans"
                                        class="btn-link"
                                        icon="oi-arrow-right"
                                    />
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Reading of the files" name="int_filemanager_text_status_block">
                        <setting
                            id="int_filemanager_text_status"
                            string="Status"
                            help="The text of the files is read in the background; only what is done can be found by the search in the files."
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label class="col-lg-4" for="int_filemanager_text_done" />
                                    <field name="int_filemanager_text_done" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_text_empty" />
                                    <field name="int_filemanager_text_empty" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_text_pending" />
                                    <field name="int_filemanager_text_pending" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_text_running" />
                                    <field name="int_filemanager_text_running" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_text_missing" />
                                    <field name="int_filemanager_text_missing" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_text_skipped" />
                                    <field name="int_filemanager_text_skipped" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_text_failed" />
                                    <field name="int_filemanager_text_failed" />
                                </div>
                                <div class="mt8">
                                    <button
                                        name="%(int_filemanager.int_filemanager_text_action)d"
                                        type="action"
                                        string="Show the files"
                                        class="btn-link"
                                        icon="oi-arrow-right"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="int_filemanager_text_run"
                            string="Scheduled action"
                            help="How long one run of the scheduled action lasts, which program reads the PDF files, and when it ran last."
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label class="col-lg-4" for="int_filemanager_text_budget" />
                                    <field name="int_filemanager_text_budget" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_text_reader" />
                                    <field name="int_filemanager_text_reader" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_text_lastcall" />
                                    <field name="int_filemanager_text_lastcall" />
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Share links" name="int_filemanager_share_block">
                        <setting
                            id="int_filemanager_share_creators"
                            string="Who makes shares"
                            help="Whoever may make a share can give the folders and files that they see."
                        >
                            <field name="int_filemanager_share_creators" />
                        </setting>
                        <setting
                            id="int_filemanager_share_defaults"
                            string="Start values of the uploads"
                            help="A new share starts with these limits for the files that guests upload."
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label class="col-lg-4" for="int_filemanager_share_default_file_mb" />
                                    <field name="int_filemanager_share_default_file_mb" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_share_default_total_mb" />
                                    <field name="int_filemanager_share_default_total_mb" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_share_default_files" />
                                    <field name="int_filemanager_share_default_files" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_share_default_extensions" />
                                    <field name="int_filemanager_share_default_extensions" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="int_filemanager_share_maximums"
                            string="Highest values of the uploads"
                            help="The makers of a share cannot set the limits of the uploads above these."
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label class="col-lg-4" for="int_filemanager_share_max_file_mb" />
                                    <field name="int_filemanager_share_max_file_mb" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_share_max_total_mb" />
                                    <field name="int_filemanager_share_max_total_mb" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_share_max_files" />
                                    <field name="int_filemanager_share_max_files" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="int_filemanager_share_password"
                            string="Shortest password"
                            help="The number of characters that the password of a share needs at least."
                        >
                            <field name="int_filemanager_share_password_length" />
                        </setting>
                        <setting
                            id="int_filemanager_share_unlock"
                            string="Hours the password is kept"
                            help="A guest who typed the password of a share does not type it again for this long, in the same browser tab."
                        >
                            <field name="int_filemanager_share_unlock_hours" />
                        </setting>
                        <setting
                            id="int_filemanager_share_brake"
                            string="Brakes"
                            help="Limits for the guests of the shares. The brake on wrong passwords is always on."
                        >
                            <div class="content-group">
                                <div class="row mt8">
                                    <label class="col-lg-4" for="int_filemanager_share_brake" />
                                    <field name="int_filemanager_share_brake" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_share_invalid_tokens" />
                                    <field name="int_filemanager_share_invalid_tokens" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_share_requests_per_minute" />
                                    <field name="int_filemanager_share_requests_per_minute" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_share_uploads_per_minute" />
                                    <field name="int_filemanager_share_uploads_per_minute" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_share_password_tries_ip" />
                                    <field name="int_filemanager_share_password_tries_ip" />
                                </div>
                                <div class="row">
                                    <label class="col-lg-4" for="int_filemanager_share_password_tries_share" />
                                    <field name="int_filemanager_share_password_tries_share" />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- The settings in the menu, as the core modules do it (the context "module" opens the section
         of the module). -->
    <record id="res_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'int_filemanager', 'bin_size': False}</field>
    </record>

    <menuitem
        id="res_config_settings_menu"
        name="Settings"
        parent="menu_int_filemanager_root"
        action="res_config_settings_action"
        groups="base.group_system"
        sequence="90"
    />
</odoo>
