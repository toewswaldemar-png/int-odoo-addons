<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page" name="Hymn display page">&lt;!DOCTYPE html&gt;
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"/>
                <title t-out="title"/>
                <script>
                    window.odoo = {
                        __session_info__: <t t-out="json.dumps(session_info)"/>,
                        csrf_token: "<t t-out="request.csrf_token(None)"/>",
                        debug: "<t t-out="debug"/>",
                        int_liedanzeige: <t t-out="json.dumps(config)"/>,
                    };
                </script>
                <t t-call-assets="int_liedanzeige.assets_public"/>
            </head>
            <body/>
        </html>
    </template>
</odoo>
