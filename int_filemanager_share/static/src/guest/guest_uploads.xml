<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="int_filemanager_share.GuestUploads">
        <div class="o_guest_uploads d-flex flex-column flex-grow-1 overflow-auto" t-ref="root">
            <section t-if="props.enabled" class="o_guest_upload_area border-bottom bg-view px-3 py-2">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button class="btn btn-primary o_guest_upload_button" t-on-click="choose">
                        <i class="fa fa-upload" /> Upload files
                    </button>
                    <input
                        type="file"
                        multiple="multiple"
                        class="d-none"
                        t-ref="fileInput"
                        t-on-change="onFilesSelected"
                    />
                    <span class="text-muted small" t-out="hint" />
                </div>
                <div t-if="state.closed" class="alert alert-warning mt-2 mb-0">
                    This link does not take files any more.
                </div>
                <FileUploadProgressContainer
                    fileUploads="fileUploadService.uploads"
                    Component="constructor.components.FileUploadProgressDataRow"
                />
                <ul t-if="state.failures.length" class="o_guest_upload_failures list-unstyled mt-2 mb-0">
                    <li t-foreach="state.failures" t-as="failure" t-key="failure_index" class="text-danger">
                        <i class="fa fa-exclamation-triangle" />
                        <strong t-out="failure.name" />: <t t-out="failure.message" />
                    </li>
                </ul>
                <div t-if="state.uploads.length" class="o_guest_my_uploads mt-3">
                    <h6 class="mb-1">My uploads</h6>
                    <ul class="list-group list-group-flush">
                        <li
                            t-foreach="state.uploads"
                            t-as="entry"
                            t-key="entry.id"
                            class="list-group-item d-flex align-items-center gap-2 px-0 o_guest_my_upload"
                        >
                            <span class="text-truncate flex-grow-1" t-out="entry.name" />
                            <span class="text-muted small text-nowrap" t-out="humanSize(entry.size)" />
                            <span class="text-muted small text-nowrap d-none d-sm-inline" t-out="formatTime(entry.time)" />
                            <button
                                t-if="entry.removable !== false"
                                class="btn btn-sm btn-outline-danger o_guest_remove_upload"
                                t-on-click="() => this.remove(entry)"
                            >
                                <i class="fa fa-trash" /> Remove
                            </button>
                            <span t-else="" class="badge text-bg-secondary">Taken over</span>
                        </li>
                    </ul>
                    <p class="text-muted small mt-1 mb-0">
                        This list is kept in this browser. Other browsers do not show these files.
                    </p>
                </div>
            </section>
            <t t-slot="default" />
        </div>
    </t>
</templates>
