<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_share_view_list" model="ir.ui.view">
        <field name="name">int.filemanager.share.view.list</field>
        <field name="model">int.filemanager.share</field>
        <field name="arch" type="xml">
            <list
                decoration-muted="state in ('blocked', 'expired', 'limit', 'archived')"
                sample="1"
            >
                <field name="name" />
                <field name="folder_id" optional="show" />
                <field name="document_id" optional="show" />
                <field name="can_view" optional="show" />
                <field name="can_download" optional="show" />
                <field name="can_upload" optional="show" />
                <field name="has_password" optional="show" />
                <field name="expiration_date" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'valid'"
                    decoration-warning="state in ('limit', 'archived')"
                    decoration-danger="state in ('blocked', 'expired')"
                />
                <field name="view_count" optional="show" />
                <field name="download_count" optional="show" />
                <field name="last_access" optional="show" />
                <field name="create_uid" optional="hide" />
                <field name="company_id" optional="hide" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="int_filemanager_share_view_form" model="ir.ui.view">
        <field name="name">int.filemanager.share.view.form</field>
        <field name="model">int.filemanager.share</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_archive"
                        type="object"
                        string="Block"
                        invisible="not active"
                        help="The link stops working. It can be unblocked."
                    />
                    <button
                        name="action_unarchive"
                        type="object"
                        string="Unblock"
                        invisible="active"
                    />
                    <button
                        name="action_remove_password"
                        type="object"
                        string="Remove the password"
                        invisible="not has_password"
                        confirm="Everybody who has the link can then open it."
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="Name" /></h1>
                    </div>
                    <group>
                        <group string="Target">
                            <field name="folder_id" readonly="id" invisible="not folder_id and id" />
                            <field name="document_id" readonly="id" invisible="not document_id and id" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group string="Address">
                            <field name="url" widget="CopyClipboardURL" invisible="not id" />
                            <field name="expiration_date" />
                            <field
                                name="state"
                                widget="badge"
                                decoration-success="state == 'valid'"
                                decoration-warning="state in ('limit', 'archived')"
                                decoration-danger="state in ('blocked', 'expired')"
                            />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <group>
                        <group string="The guests may">
                            <field name="can_view" />
                            <field name="can_download" />
                            <field name="can_upload" invisible="document_id" />
                        </group>
                        <group string="Protection">
                            <field name="has_password" invisible="1" />
                            <field name="password" password="True" />
                            <field name="max_downloads" invisible="folder_id" />
                        </group>
                    </group>
                    <group string="Uploads" invisible="not can_upload">
                        <group>
                            <field name="upload_max_file_mb" />
                            <field name="upload_max_total_mb" />
                            <field name="upload_max_files" />
                            <field name="upload_extensions" />
                        </group>
                        <group>
                            <field name="upload_folder_id" />
                            <field name="upload_count" />
                            <field name="upload_size" widget="int_filemanager_size" />
                        </group>
                    </group>
                    <group string="Use">
                        <field name="view_count" />
                        <field name="download_count" />
                        <field name="last_access" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- The dialog of the button "Share": the form of the share without the buttons of its head and
         the chatter; "Create the link" saves and shows it again with the address. -->
    <record id="int_filemanager_share_view_form_dialog" model="ir.ui.view">
        <field name="name">int.filemanager.share.view.form.dialog</field>
        <field name="model">int.filemanager.share</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="int_filemanager_share_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace" />
            <xpath expr="//chatter" position="replace" />
            <xpath expr="//sheet" position="after">
                <footer>
                    <button
                        name="action_show_address"
                        type="object"
                        string="Create the link"
                        class="btn-primary"
                        invisible="id"
                        data-hotkey="q"
                    />
                    <button
                        string="Save"
                        special="save"
                        class="btn-primary"
                        invisible="not id"
                        data-hotkey="q"
                    />
                    <button string="Close" special="cancel" data-hotkey="x" />
                </footer>
            </xpath>
        </field>
    </record>

    <record id="int_filemanager_share_view_search" model="ir.ui.view">
        <field name="name">int.filemanager.share.view.search</field>
        <field name="model">int.filemanager.share</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="folder_id" />
                <field name="document_id" />
                <field name="create_uid" />
                <filter
                    name="mine"
                    string="My shares"
                    domain="[('create_uid', '=', uid)]"
                />
                <separator />
                <filter name="blocked" string="Blocked" domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="int_filemanager_share_action" model="ir.actions.act_window">
        <field name="name">Shares</field>
        <field name="res_model">int.filemanager.share</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No shares yet</p>
            <p>
                A share is a link to a folder or a file. Whoever has it needs no account.
            </p>
        </field>
    </record>

    <menuitem
        id="int_filemanager_share_menu"
        name="Shares"
        parent="int_filemanager.menu_int_filemanager_root"
        action="int_filemanager_share_action"
        sequence="10"
    />
</odoo>
