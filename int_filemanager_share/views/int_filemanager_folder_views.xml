<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_folder_view_form" model="ir.ui.view">
        <field name="name">int.filemanager.folder.view.form.inherit.int_filemanager_share</field>
        <field name="model">int.filemanager.folder</field>
        <field name="inherit_id" ref="int_filemanager.int_filemanager_folder_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/header/button[@name='action_download']" position="before">
                <button
                    name="action_share"
                    type="object"
                    string="Share"
                    icon="fa-share-alt"
                    class="btn-primary"
                    invisible="not id or not active"
                    groups="int_filemanager.int_filemanager_group_user"
                    help="Make a link that gives this folder to whoever has it, without an account."
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_shares"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-share-alt"
                    invisible="not share_count"
                >
                    <field name="share_count" widget="statinfo" string="Shares" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
