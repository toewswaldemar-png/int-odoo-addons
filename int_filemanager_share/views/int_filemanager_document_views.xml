<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_document_view_list" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.list.inherit.int_filemanager_share</field>
        <field name="model">int.filemanager.document</field>
        <field name="inherit_id" ref="int_filemanager.int_filemanager_document_view_list" />
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button
                    name="action_share"
                    type="object"
                    string="Share"
                    icon="fa-share-alt"
                    groups="int_filemanager.int_filemanager_group_user"
                />
            </xpath>
        </field>
    </record>

    <record id="int_filemanager_document_view_form" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.form.inherit.int_filemanager_share</field>
        <field name="model">int.filemanager.document</field>
        <field name="inherit_id" ref="int_filemanager.int_filemanager_document_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_share"
                    type="object"
                    string="Share"
                    icon="fa-share-alt"
                    invisible="not active"
                    groups="int_filemanager.int_filemanager_group_user"
                    help="Make a link that gives this file to whoever has it, without an account."
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_shares"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-share-alt"
                    invisible="not share_count"
                >
                    <field name="share_count" widget="statinfo" string="Shares" />
                </button>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="share_id" invisible="not share_id" />
            </xpath>
        </field>
    </record>

    <!-- Guest views of a share: high priority so they are never a default. -->
    <record id="int_filemanager_document_view_guest_list" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.guest.list</field>
        <field name="model">int.filemanager.document</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list
                js_class="int_filemanager_guest_list"
                create="0"
                edit="0"
                delete="0"
                import="0"
                export_xlsx="0"
                duplicate="0"
            >
                <field name="name" widget="int_filemanager_document_name" />
                <field name="folder_id" options="{'no_open': True}" context="{'hierarchical_naming': True}" />
                <field name="size" widget="int_filemanager_size" />
                <field name="write_date" string="Modified" />
                <field name="tag_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="int_filemanager_document_view_guest_kanban" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.guest.kanban</field>
        <field name="model">int.filemanager.document</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <kanban
                js_class="int_filemanager_guest_kanban"
                create="0"
                edit="0"
                delete="0"
                quick_create="0"
                group_create="0"
            >
                <field name="write_date" />
                <templates>
                    <t t-name="card">
                        <field name="mimetype" widget="int_filemanager_document_thumbnail" />
                        <field name="name" class="fw-bold text-truncate d-block mt-2" />
                        <div class="o_int_filemanager_card_meta">
                            <div class="d-flex justify-content-between text-muted small">
                                <field name="folder_id" class="text-truncate" />
                                <field name="size" widget="int_filemanager_size" />
                            </div>
                            <field name="tag_ids" widget="many2many_tags" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="int_filemanager_document_view_guest_search" model="ir.ui.view">
        <field name="name">int.filemanager.document.view.guest.search</field>
        <field name="model">int.filemanager.document</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter name="filter_pdf" string="PDF" domain="[('mimetype', '=', 'application/pdf')]" />
                <filter name="filter_image" string="Images" domain="[('mimetype', '=like', 'image/%')]" />
                <group>
                    <filter name="group_by_folder" string="Folder" context="{'group_by': 'folder_id'}" />
                    <filter name="group_by_mimetype" string="Mimetype" context="{'group_by': 'mimetype'}" />
                    <filter name="group_by_tag" string="Tags" context="{'group_by': 'tag_ids'}" />
                </group>
                <searchpanel view_types="list,kanban">
                    <field name="folder_id" string="Folders" icon="fa-folder" expand="1" limit="0" />
                    <field name="tag_ids" select="multi" string="Tags" icon="fa-tags" expand="1" />
                </searchpanel>
            </search>
        </field>
    </record>
</odoo>
