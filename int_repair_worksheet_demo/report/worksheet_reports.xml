<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_worksheet" model="report.paperformat">
        <field name="name">BE01412 A4</field><field name="format">A4</field>
        <field name="orientation">Portrait</field><field name="margin_top">8</field>
        <field name="margin_bottom">8</field><field name="margin_left">8</field><field name="margin_right">8</field>
        <field name="header_line" eval="False"/><field name="header_spacing">0</field><field name="dpi">96</field>
    </record>
    <record id="action_report_worksheet_pdf" model="ir.actions.report">
        <field name="name">BE01412 Arbeitsblatt (Test)</field><field name="model">repair.worksheet.test</field>
        <field name="report_type">qweb-pdf</field><field name="report_name">int_repair_worksheet_demo.report_worksheet</field>
        <field name="paperformat_id" ref="paperformat_worksheet"/>
        <field name="print_report_name">'BE01412_Test_%s' % (object.rb_reference or object.id)</field>
        <field name="group_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="action_report_worksheet_html" model="ir.actions.report">
        <field name="name">BE01412 HTML-Vorschau</field><field name="model">repair.worksheet.test</field>
        <field name="report_type">qweb-html</field><field name="report_name">int_repair_worksheet_demo.report_worksheet</field>
        <field name="paperformat_id" ref="paperformat_worksheet"/>
        <field name="group_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
</odoo>
