<templates xml:space="preserve">
    <t t-name="hm_filemanager.FolderTree" owl="1">
        <div class="hm-filemanager-tree">
            <div t-attf-class="hm-tree-row d-flex align-items-center {{ isRootActive ? 'hm-tree-active' : '' }}"
                 t-on-click="onClickRoot">
                <i class="fa fa-home me-2"/>
                <span>Start</span>
            </div>
            <t t-foreach="state.children" t-as="child" t-key="child.path">
                <HmFolderTreeNode name="child.name" path="child.path" depth="1"
                                  activePath="props.activePath" onNavigate="props.onNavigate"/>
            </t>
        </div>
    </t>

    <t t-name="hm_filemanager.FolderTreeNode" owl="1">
        <div class="hm-filemanager-tree-node">
            <div t-attf-class="hm-tree-row d-flex align-items-center {{ isActive ? 'hm-tree-active' : '' }}"
                 t-attf-style="padding-left: {{ props.depth * 14 }}px"
                 t-on-click="onClickLabel">
                <i t-attf-class="fa {{ state.loading ? 'fa-spinner fa-spin' : (state.expanded ? 'fa-caret-down' : 'fa-caret-right') }} hm-tree-caret"
                   t-on-click="toggle"/>
                <i class="fa fa-folder me-2"/>
                <span t-esc="props.name"/>
            </div>
            <div t-if="state.expanded" class="hm-filemanager-tree-children">
                <t t-foreach="state.children" t-as="child" t-key="child.path">
                    <HmFolderTreeNode name="child.name" path="child.path" depth="props.depth + 1"
                                      activePath="props.activePath" onNavigate="props.onNavigate"/>
                </t>
            </div>
        </div>
    </t>
</templates>
