<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="int_filemanager_import_line_view_list" model="ir.ui.view">
        <field name="name">int.filemanager.import.line.view.list</field>
        <field name="model">int.filemanager.import.line</field>
        <field name="arch" type="xml">
            <list
                create="0"
                edit="0"
                delete="0"
                decoration-danger="state == 'error'"
                decoration-muted="state in ('skipped', 'excluded')"
            >
                <field name="path" />
                <field name="kind" optional="hide" />
                <field name="size" widget="int_filemanager_size" />
                <field name="state" />
                <field name="message" />
                <field name="clash" optional="hide" />
                <field name="document_id" optional="show" />
                <field name="folder_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="int_filemanager_import_line_view_search" model="ir.ui.view">
        <field name="name">int.filemanager.import.line.view.search</field>
        <field name="model">int.filemanager.import.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="path" />
                <field name="message" />
                <filter name="filter_error" string="Failed" domain="[('state', '=', 'error')]" />
                <filter name="filter_pending" string="To do" domain="[('state', '=', 'pending')]" />
                <filter name="filter_clash" string="Name taken" domain="[('clash', '=', True)]" />
                <separator />
                <filter
                    name="filter_not_read_in"
                    string="Skipped or excluded"
                    domain="[('state', 'in', ('skipped', 'excluded'))]"
                />
                <separator />
                <filter name="filter_folder" string="Folders" domain="[('kind', '=', 'folder')]" />
                <filter name="filter_file" string="Files" domain="[('kind', '=', 'file')]" />
                <group>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>
</odoo>
